---
import ProjectOverview from "../components/ProjectOverview.astro";
import NextProject from "../components/NextProject.astro";
import ProgressiveImage from "../components/ProgressiveImage.astro";
import ExplainerDiagram from "../components/ExplainerDiagram.astro";
import AnimatedStudy from "../components/AnimatedStudy.astro";
import OracleControls from "../components/OracleControls.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";

const project = projects.find((p) => p.href === "/cheese-prophecy");
---

<BaseLayout title="The Cheese Prophecy - Gabriele Radicello" brandColor={project?.brandColor}>
  <!-- Hero Section -->
  <section class="relative h-[100svh] md:h-[100dvh] w-full overflow-hidden flex items-center justify-center">
    <ProgressiveImage loading="eager" fetchpriority="high" decoding="auto"
      src="/progetti/the-cheese-prophecy/hero-oracle.svg"
      alt="" aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover z-0 opacity-60"
    />
    <div class="absolute inset-0 bg-black/45 z-10"></div>

    <div class="relative z-20 text-center px-6 max-w-4xl">
      <div class="inline-block px-3 py-1 mb-6 border border-[#efbf48]/40 bg-black text-xs font-mono text-[#efbf48] uppercase tracking-widest">
        Net Art &amp; Algorithmic Poetry Engine
      </div>
      <h1
        class="text-4xl sm:text-6xl md:text-8xl font-semibold text-white tracking-tight break-words"
        style="font-family: 'Alte Haas Grotesk', Helvetica, Arial, sans-serif;"
      >
        The Cheese Prophecy
      </h1>
      <p class="mt-6 text-xl text-neutral-300 max-w-2xl mx-auto"><span class="lang-en" lang="en">{"An experimental web project based on poetic and textual generation, unfolding like an enigmatic prophecy."}</span><span class="lang-it" lang="it">{"Un oracolo digitale rivela una frase nascosta attraverso i buchi di una maschera a forma di formaggio."}</span></p>
    </div>
  </section>

  <!-- Interactive Live App Section -->
  <section id="app-section" class="w-full bg-black py-8 sm:py-12 border-y border-neutral-800 transition-all duration-500 ease-in-out">
    <div id="app-wrapper" class="max-w-7xl mx-auto px-4 sm:px-6 transition-all duration-500 ease-in-out">
      <!-- Section Header Bar (Inline Mode) -->
      <div id="app-header-bar" class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-4">
        <h2 class="text-xs sm:text-sm font-mono text-[#efbf48] uppercase tracking-widest flex items-center gap-2 flex-wrap">
          <span class="w-2 h-2 rounded-full bg-[#efbf48] animate-pulse shrink-0"></span>
          <span class="lang-en" lang="en">LIVE INTERACTIVE NET-ART APPLICATION // ORACLE CANVAS</span>
          <span class="lang-it" lang="it">APPLICAZIONE NET-ART INTERATTIVA LIVE // TELA DELL'ORACOLO</span>
        </h2>
        <button
          id="fullscreen-btn"
          type="button"
          class="text-xs font-mono text-neutral-300 hover:text-white bg-black hover:bg-black border border-neutral-700 px-3.5 py-1.5 transition-all duration-300 flex items-center gap-2 cursor-pointer shrink-0"
        >
          <span class="lang-en" lang="en">Open Fullscreen</span>
          <span class="lang-it" lang="it">Apri a Schermo Intero</span>
          <svg aria-hidden="true" focusable="false" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
          </svg>
        </button>
      </div>

      <!-- Iframe Container -->
      <div id="iframe-container" class="w-full h-[65vh] md:h-[75vh] border border-neutral-800 bg-black overflow-hidden relative transition-all duration-500 ease-in-out">
        <iframe loading="lazy" data-lazy-embed
          id="app-iframe"
          data-src="/progetti/the-cheese-prophecy/index.html"
          title="The Cheese Prophecy Live Net-Art Application"
          class="w-full h-full border-0 border-none outline-none block"
          style="border:0;outline:none;margin:0;padding:0;"
          allow="autoplay; fullscreen"
        ></iframe>
      </div>
    </div>
  </section>

  <script>
    import { loadLazyEmbed } from '../utils/lazy-media';
    function setupFullscreenExpander() {
      const btn = document.getElementById("fullscreen-btn");
      const headerBar = document.getElementById("app-header-bar");
      const section = document.getElementById("app-section");
      const wrapper = document.getElementById("app-wrapper");
      const container = document.getElementById("iframe-container");

      if (!section || !wrapper || !container) return;

      let isFullscreen = false;
      let savedScrollY = 0;

      function toggle(forceFullscreen) {
        if (typeof forceFullscreen === "boolean") {
          isFullscreen = forceFullscreen;
        } else {
          isFullscreen = !isFullscreen;
        }

        if (isFullscreen) {
          const iframe = container.querySelector('iframe');
          if (iframe) loadLazyEmbed(iframe);
          savedScrollY = window.scrollY;
          window.scrollTo(0, 0);

          window.postMessage('force-compact-header', '*');

          headerBar?.classList.add("hidden");
          container.classList.remove("border", "border-neutral-800");
          container.classList.add("border-0", "border-none");

          section.classList.add("fixed", "inset-0", "top-0", "left-0", "w-screen", "h-screen", "z-40", "p-0", "m-0", "flex", "flex-col", "bg-black");
          section.classList.remove("w-full", "py-12", "border-y", "border-neutral-800");

          wrapper.classList.remove("max-w-7xl", "px-6");
          wrapper.classList.add("w-full", "h-full", "max-w-none", "flex", "flex-col", "p-0");

          container.classList.remove("h-[65vh]", "md:h-[75vh]");
          container.classList.add("flex-1", "w-full", "h-full");

          document.body.style.overflow = "hidden";
        } else {
          window.postMessage('reset-compact-header', '*');

          headerBar?.classList.remove("hidden");
          container.classList.remove("border-0", "border-none");
          container.classList.add("border", "border-neutral-800");

          section.classList.remove("fixed", "inset-0", "top-0", "left-0", "w-screen", "h-screen", "z-40", "p-0", "m-0", "flex", "flex-col", "bg-black");
          section.classList.add("w-full", "py-12", "border-y", "border-neutral-800");

          wrapper.classList.add("max-w-7xl", "px-6");
          wrapper.classList.remove("w-full", "h-full", "max-w-none", "flex", "flex-col", "p-0");

          container.classList.add("h-[65vh]", "md:h-[75vh]");
          container.classList.remove("flex-1", "w-full", "h-full");

          document.body.style.overflow = "";

          window.scrollTo(0, savedScrollY);
        }
      }
      btn?.addEventListener("click", () => toggle());

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isFullscreen) {
          toggle(false);
        }
      });
    }

    setupFullscreenExpander();
    document.addEventListener("astro:page-load", setupFullscreenExpander);
  </script>

  <!-- Content & Architecture Section -->
  <ProjectOverview projectId="cheese-prophecy">
<div class="portfolio-editorial-row "><div class="portfolio-editorial-title"><h2 class="text-3xl font-semibold text-neutral-50 mb-8" style="font-family: 'Alte Haas Grotesk', Helvetica, Arial, sans-serif;">
        <span class="lang-en" lang="en">Concept, Meme Mythology &amp; Tyromancy</span>
        <span class="lang-it" lang="it">Concept, Mitologia dei Meme &amp; Tiromanzia</span>
      </h2></div><div class="portfolio-project-prose">

      <div class="grid gap-8">
        <p>
          <span class="lang-en" lang="en"><strong>The Cheese Prophecy</strong> is an experimental net-art project that explores the short-circuit between contemporary internet absurdity and ancient divination traditions.</span>
          <span class="lang-it" lang="it"><strong>The Cheese Prophecy</strong> è un progetto sperimentale di net-art che esplora il cortocircuito tra l'assurdità di internet contemporanea e le antiche tradizioni divinatorie.</span>
        </p>

        <div class="border-l-2 border-[#efbf48] pl-6 py-2 my-2 bg-black">
          <h3 class="text-[#efbf48] font-mono text-sm uppercase tracking-wider mb-2">
            <span class="lang-en" lang="en">1. The "Cheese of Truth" Internet Meme (Vine 2015 / TikTok)</span>
            <span class="lang-it" lang="it">1. Il Meme di Internet "Cheese of Truth" (Vine 2015 / TikTok)</span>
          </h3>
          <p class="text-base text-neutral-300 mb-0">
            <span class="lang-en" lang="en">The project takes direct inspiration from the viral internet meme <em>"The Cheese of Truth"</em>, initiated in 2015 by creator Olaf Falafel. The meme involved throwing a slice of Swiss cheese onto newspaper headlines and reading out random words through the cheese holes to extract absurd "truths" and predictions.</span>
            <span class="lang-it" lang="it">Il progetto trae ispirazione diretta dal meme virale di internet <em>"The Cheese of Truth"</em>, lanciato nel 2015 dal creatore Olaf Falafel. Il meme consisteva nel lanciare una fetta di formaggio svizzero sui titoli dei giornali e leggere le parole casuali attraverso i buchi del formaggio per estrarre "verità" e previsioni assurde.</span>
          </p>
        </div>

        <div class="border-l-2 border-neutral-700 pl-6 py-2 my-2 bg-black">
          <h3 class="text-neutral-200 font-mono text-sm uppercase tracking-wider mb-2">
            <span class="lang-en" lang="en">2. Ancient Tyromancy (Greek &amp; Medieval Divination)</span>
            <span class="lang-it" lang="it">2. Antica Tiromanzia (Divinazione Greca e Medievale)</span>
          </h3>
          <p class="text-base text-neutral-300 mb-0">
            <span class="lang-en" lang="en">This digital meme resonates with the ancient historical practice of <strong>Tyromancy</strong> (from Greek <em>tūros</em> = cheese, <em>manteia</em> = divination), documented since the 2nd century AD. Medieval practitioners interpreted holes, mold patterns, and cheese rinds to predict omens and unveil hidden secrets.</span>
            <span class="lang-it" lang="it">Questo meme digitale risuona con l'antica pratica storica della <strong>Tiromanzia</strong> (dal greco <em>tūros</em> = formaggio, <em>manteia</em> = divinazione), documentata sin dal II secolo d.C. I praticanti medievali interpretavano i buchi, le macchie di muffa e le croste del formaggio per prevedere presagi e svelare segreti nascosti.</span>
          </p>
        </div>

        <p>
          <span class="lang-en" lang="en">Reinterpreting this mythology into a digital shrine, the web application functions as an algorithmic oracle. It hides a randomly selected aphorism in a changing field of words, then reveals it through a cheese-shaped mask to create a downloadable prophecy card.</span>
          <span class="lang-it" lang="it">Reinterpretando questa mitologia in un santuario digitale, l'applicazione web funziona come un oracolo algoritmico. Nasconde un aforisma scelto casualmente in un campo di parole in movimento, poi lo rivela attraverso una maschera a forma di formaggio per creare una carta profetica scaricabile.</span>
        </p>
      </div>
    </div></div>
<div class="portfolio-editorial-row " id="study-1"><div class="portfolio-editorial-title"><h3 class="text-2xl font-semibold text-neutral-50" style="font-family: 'Alte Haas Grotesk', Helvetica, Arial, sans-serif;"><span class="lang-en" lang="en">How a prophecy appears</span><span class="lang-it" lang="it">Come appare una profezia</span></h3></div><div class="portfolio-project-prose">

      <AnimatedStudy kind="oracle" />
      <OracleControls />
    </div></div>
<div class="portfolio-editorial-row " id="study-2"><div class="portfolio-editorial-title"><h3 class="text-2xl font-semibold text-neutral-50" style="font-family: 'Alte Haas Grotesk', Helvetica, Arial, sans-serif;"><span class="lang-en" lang="en">The geometry of a revelation</span><span class="lang-it" lang="it">La geometria di una rivelazione</span></h3></div><div class="portfolio-project-prose">

      <ExplainerDiagram kind="cheese-revelation" animated={false} />
    </div></div>
<div class="portfolio-editorial-row " id="study-3"><div class="portfolio-editorial-title"><h3 class="text-2xl font-semibold text-neutral-50" style="font-family: 'Alte Haas Grotesk', Helvetica, Arial, sans-serif;"><span class="lang-en" lang="en">Reading the oracle</span><span class="lang-it" lang="it">Leggere l’oracolo</span></h3></div><div class="portfolio-project-prose">

      <ExplainerDiagram kind="cheese-interface" animated={false} />
    </div></div>
</ProjectOverview>

<NextProject projectId="cheese-prophecy" />
</BaseLayout>
