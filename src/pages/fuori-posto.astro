---
import { getProxyUrl } from "../utils/image";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
const project = projects.find(p => p.href === "/fuori-posto");
---

<BaseLayout
  title="Fuori Posto - Gabriele Radicello"
  brandColor={project?.brandColor}
>
  <!-- Hero Section -->
  <section
    class="relative h-[100svh] md:h-[100dvh] w-full overflow-hidden flex items-center justify-center"
  >
    <img
      src={getProxyUrl("/progetti/fuori-posto/1.PNG")} data-src="/progetti/fuori-posto/1.PNG"
      alt="Copertina dell'album 'Fuori Posto' con una figura umana frammentata e una texture materica grezza"
      class="absolute inset-0 w-full h-full object-cover z-0 opacity-40"
    />
    <div class="absolute inset-0 bg-black/60 z-10"></div>

    <div class="relative z-20 text-center px-6">
      <h1
        class="text-5xl md:text-8xl font-semibold text-white tracking-tight"
        style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;"
      >
        Fuori Posto
      </h1>
      <p class="mt-6 text-xl text-neutral-300 font-light max-w-2xl mx-auto">
        <span class="lang-en">Album cover design for "Fuori Posto" by Cielle.</span>
        <span class="lang-it">Design della copertina dell'album "Fuori Posto" di Cielle.</span>
      </p>
    </div>
  </section>

  <!-- Content Section -->
  <section
    class="max-w-4xl mx-auto px-6 py-24 md:py-32 text-neutral-300 text-lg leading-8 text-left"
  >
    <div class="mb-16 md:mb-24">
      <h2
        class="text-3xl font-semibold text-neutral-50 mb-8"
        style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;"
      >
        <span class="lang-en">Concept</span>
        <span class="lang-it">Concept</span>
      </h2>
      <div class="grid gap-8">
        <div class="lang-en">
          <p>
            The visual project for the album "Fuori Posto" explores the sense of
            alienation and displacement. Through a raw and fragmented aesthetic,
            the artwork captures the essence of the search for identity in a
            context that never seems right.
          </p>
          <p>
            The illustrative approach combines digital techniques to create an
            imagery that mirrors the artist's musical atmospheres.
          </p>
        </div>
        <div class="lang-it">
          <p>
            Il progetto visivo per l'album "Fuori Posto" esplora il senso di alienazione e smarrimento. Attraverso un'estetica cruda e frammentata, l'artwork cattura l'essenza della ricerca di identità in un contesto che non sembra mai quello giusto.
          </p>
          <p>
            L'approccio illustrativo combina tecniche digitali per creare un immaginario che rispecchia le atmosfere musicali dell'artista.
          </p>
        </div>
        <div class="mt-4 flex flex-wrap gap-4">
          <a
            href="https://open.spotify.com/intl-it/album/3CReGcHeaW0ioHj2X1AR13"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-8 py-3 border border-neutral-700 text-neutral-300 hover:bg-white hover:text-black transition-colors duration-300 font-medium tracking-wide text-sm uppercase"
          >
            <span class="lang-en">Listen on Spotify</span>
            <span class="lang-it">Ascolta su Spotify</span>
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="square"
                stroke-linejoin="miter"
                stroke-width="1.5"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              ></path></svg
            >
          </a>
          <a
            href="https://music.apple.com/no/album/fuori-posto/1830194971"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-8 py-3 border border-neutral-700 text-neutral-300 hover:bg-white hover:text-black transition-colors duration-300 font-medium tracking-wide text-sm uppercase"
          >
            <span class="lang-en">Listen on Apple Music</span>
            <span class="lang-it">Ascolta su Apple Music</span>
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="square"
                stroke-linejoin="miter"
                stroke-width="1.5"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              ></path></svg
            >
          </a>
        </div>
      </div>
    </div>

    <!-- Gallery Section -->
    <div class="border-t border-neutral-800 pt-16">
      <h2
        class="text-3xl font-semibold text-neutral-50 mb-12"
        style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;"
      >
        <span class="lang-en">Gallery</span>
        <span class="lang-it">Galleria</span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Main Artwork -->
        <div class="col-span-1 md:col-span-2">
          <img 
            src={getProxyUrl("/progetti/fuori-posto/1.PNG")} data-src="/progetti/fuori-posto/1.PNG" 
            alt="Copertina principale dell'album con contrasto elevato ed elementi grafici che evocano alienazione e isolamento" 
            class="w-full h-auto object-cover bg-neutral-900 border border-neutral-800 gallery-img" 
            loading="lazy" 
          />
        </div>

        <!-- Cover & Tracklist -->
        <div class="col-span-1 md:col-span-2">
          <img
            src={getProxyUrl("/progetti/fuori-posto/cover-fuori-posto.png")} data-src="/progetti/fuori-posto/cover-fuori-posto.png"
            alt="Retro della copertina con l'elenco delle tracce e dettagli tipografici in stile grunge minimalista"
            class="w-full h-auto object-cover bg-neutral-900 border border-neutral-800 gallery-img"
            loading="lazy"
          />
        </div>

        <!-- Process and Detail Images -->
        <img
          src={getProxyUrl("/progetti/fuori-posto/gallery-1.png")} data-src="/progetti/fuori-posto/gallery-1.png"
          alt="Bozzetto digitale del processo creativo, che mostra la scomposizione geometrica del volto del soggetto"
          class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 border border-neutral-800 gallery-img"
          loading="lazy"
        />
        <img
          src={getProxyUrl("/progetti/fuori-posto/gallery-2.png")} data-src="/progetti/fuori-posto/gallery-2.png"
          alt="Fase intermedia dell'illustrazione con l'aggiunta di texture distorte e sovrapposizioni cromatiche calde"
          class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 border border-neutral-800 gallery-img"
          loading="lazy"
        />
        <img
          src={getProxyUrl("/progetti/fuori-posto/gallery-3.png")} data-src="/progetti/fuori-posto/gallery-3.png"
          alt="Dettaglio ravvicinato della grana e delle imperfezioni applicate digitalmente sul ritratto principale"
          class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 border border-neutral-800 gallery-img"
          loading="lazy"
        />
        <img
          src={getProxyUrl("/progetti/fuori-posto/gallery-4.png")} data-src="/progetti/fuori-posto/gallery-4.png"
          alt="Inquadratura del design finale della copertina focalizzato sulle sfumature e sui contrasti del nero e del rosso"
          class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 border border-neutral-800 gallery-img"
          loading="lazy"
        />
      </div>
    </div>
  </section>
</BaseLayout>
