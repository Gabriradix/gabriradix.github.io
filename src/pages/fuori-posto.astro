---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
const project = projects.find(p => p.href === "/fuori-posto");
---

<BaseLayout
  title="Fuori Posto - Gabriele Radicello"
  brandColor={project?.brandColor}
>
  <!-- Hero Section -->
  <section
    class="relative h-[100dvh] w-full overflow-hidden flex items-center justify-center"
  >
    <img
      src="/progetti/Fuori Posto/1.PNG"
      alt="Fuori Posto - Album Artwork"
      class="absolute inset-0 w-full h-full object-cover z-0 opacity-40"
    />
    <div class="absolute inset-0 bg-black/60 z-10 pointer-events-none"></div>

    <div class="relative z-20 text-center px-6 pointer-events-none">
      <h1
        class="text-5xl md:text-8xl font-normal text-white tracking-tight"
        style="font-family: 'Apple Garamond Custom', serif;"
      >
        Fuori Posto
      </h1>
      <p class="mt-6 text-xl text-neutral-300 font-light max-w-2xl mx-auto">
        Album cover design for "Fuori Posto" by Cielle.
      </p>
    </div>
  </section>

  <!-- Content Section -->
  <section
    class="max-w-4xl mx-auto px-6 py-24 md:py-32 text-neutral-300 text-lg leading-8 text-left"
  >
    <div class="mb-16 md:mb-24">
      <h2
        class="text-3xl font-normal text-neutral-50 mb-8"
        style="font-family: 'Apple Garamond Custom', serif;"
      >
        Concept
      </h2>
      <div class="grid gap-8">
        <p>
          The visual project for the album "Fuori Posto" explores the sense of
          alienation and displacement. Through a raw and fragmented aesthetic,
          the artwork captures the essence of the search for identity in a
          context that never seems right.
        </p>
        <p>
          The illustrative approach combines digital techniques to create an
          imagery that mirrors the artist's musical atmospheres.
        </p>
        <div class="mt-4 flex flex-wrap gap-4">
          <a
            href="https://open.spotify.com/intl-it/album/3CReGcHeaW0ioHj2X1AR13"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-8 py-3 border border-neutral-700 text-neutral-300 hover:bg-white hover:text-black transition-colors duration-300 font-medium tracking-wide text-sm uppercase"
          >
            Listen on Spotify
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="square"
                stroke-linejoin="miter"
                stroke-width="1.5"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              ></path></svg
            >
          </a>
          <a
            href="https://music.apple.com/no/album/fuori-posto/1830194971"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-8 py-3 border border-neutral-700 text-neutral-300 hover:bg-white hover:text-black transition-colors duration-300 font-medium tracking-wide text-sm uppercase"
          >
            Listen on Apple Music
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="square"
                stroke-linejoin="miter"
                stroke-width="1.5"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              ></path></svg
            >
          </a>
        </div>
      </div>
    </div>

    <!-- Gallery Section -->
    <div class="border-t border-neutral-800 pt-16">
      <h2
        class="text-3xl font-normal text-neutral-50 mb-12"
        style="font-family: 'Apple Garamond Custom', serif;"
      >
        Gallery
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Main Artwork -->
        <div class="col-span-1 md:col-span-2">
          <img 
            src="/progetti/Fuori Posto/1.PNG" 
            alt="Fuori Posto - Main Cover" 
            class="w-full h-auto object-cover bg-neutral-900 border border-neutral-800 gallery-img" 
            loading="lazy" 
          />
        </div>

        <!-- Cover & Tracklist -->
        <div class="col-span-1 md:col-span-2">
          <img
            src="/progetti/Fuori Posto/cover-fuori-posto.png"
            alt="Fuori Posto - Tracklist"
            class="w-full h-auto object-cover bg-neutral-900 border border-neutral-800 gallery-img"
            loading="lazy"
          />
        </div>

        <!-- Process and Detail Images -->
        <img
          src="/progetti/Fuori Posto/gallery-1.png"
          alt="Fuori Posto - Process 1"
          class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 border border-neutral-800 gallery-img"
          loading="lazy"
        />
        <img
          src="/progetti/Fuori Posto/gallery-2.png"
          alt="Fuori Posto - Process 2"
          class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 border border-neutral-800 gallery-img"
          loading="lazy"
        />
        <img
          src="/progetti/Fuori Posto/gallery-3.png"
          alt="Fuori Posto - Detail 1"
          class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 border border-neutral-800 gallery-img"
          loading="lazy"
        />
        <img
          src="/progetti/Fuori Posto/gallery-4.png"
          alt="Fuori Posto - Detail 2"
          class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 border border-neutral-800 gallery-img"
          loading="lazy"
        />
      </div>
    </div>
  </section>
</BaseLayout>
