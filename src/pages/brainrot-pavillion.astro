---
import { getProxyUrl } from "../utils/image";
import BaseLayout from "../layouts/BaseLayout.astro";

const pieces = [
  {
    id: "nugget",
    filename: "nugget.gif",
    title: "Gegagedigedagedago Nugget",
    medium: "3D Model Reconstruction, Infinite Loop GIF",
    medium_it: "Ricostruzione Modello 3D, Loop Infinito GIF",
    dimensions: "1080 x 1080 px",
    description: "An isolated 3D reconstruction of the iconic chicken nugget meme. Suspended in continuous rotation, it stands as the ultimate low-resolution comfort food icon of post-internet culture. By stripping the subject of its hyper-accelerated TikTok feed context, it is frozen into a solemn, modern monument—an archaeological relic of digital dopamine loops.",
    description_it: "Una ricostruzione 3D isolata dell'iconico meme del chicken nugget. Sospeso in rotazione continua, si erge come simbolo per eccellenza del comfort food a bassa risoluzione della cultura post-internet. Spogliato del suo contesto iper-accelerato dei feed di TikTok, è congelato in un solenne monumento moderno—una reliquia archeologica dei loop di dopamina digitali."
  },
  {
    id: "frigocamelo",
    filename: "frigocamelo.gif",
    title: "Frigocamello",
    medium: "3D Model Reconstruction, Infinite Loop GIF",
    medium_it: "Ricostruzione Modello 3D, Loop Infinito GIF",
    dimensions: "1080 x 1080 px",
    description: "The legendary 'Frigocamello' (Fridge-Camel), a bizarre prompt hallucination blending domestic white goods with desert fauna. Set inside its digital vitrine, this hybrid creature exposes the organic glitches of generative AI, elevating a viral internet myth into a classical, contemplative sculpture of the techno-surrealist era.",
    description_it: "Il leggendario 'Frigocamello', un'allucinazione bizzarra nata da un prompt che fonde elettrodomestici e fauna desertica. Inserita nella sua teca digitale, questa creatura ibrida espone i glitch organici dell'IA generativa, elevando un mito virale di internet a scultura classica e contemplativa dell'era tecno-surrealista."
  },
  {
    id: "brrbrrpatapim",
    filename: "brrbrrpatapim.gif",
    title: "Brr Brr Patapim",
    medium: "3D Model Reconstruction, Infinite Loop GIF",
    medium_it: "Ricostruzione Modello 3D, Loop Infinito GIF",
    dimensions: "1080 x 1080 px",
    description: "A comical, wide-eyed rodent trapped in a perpetual mechanical spin. The piece materializes the hypnotic, brain-drilling loops of short-form audio memes that repeat endlessly inside the viewer's head, transforming fleeting auditory visual spam into a static, museum-grade conceptual ready-made.",
    description_it: "Un comico roditore dagli occhi spalancati intrappolato in una perpetua rotazione meccanica. L'opera materializza i loop ipnotici e martellanti dei meme sonori brevi che si ripetono all'infinito nella testa dello spettatore, trasformando il fugace spam sonoro e visivo in un ready-made concettuale statico da museo."
  },
  {
    id: "thungthungsahur",
    filename: "thungthungsahur.gif",
    title: "Thung thung thung sahur",
    medium: "3D Model Reconstruction, Infinite Loop GIF",
    medium_it: "Ricostruzione Modello 3D, Loop Infinito GIF",
    dimensions: "1080 x 1080 px",
    description: "A bizarre subject born of a linguistic prompt hallucination. The artist originally prompted the AI to generate 'Batman.' However, due to copyright protection algorithms, the system bypassed DC Comics' intellectual property by rendering a literal 'bat-man'—interpreting 'bat' not as a flying mammal, but as a wooden club (mazza). The resulting creature stands as a brilliant ready-made of technological misinterpretation and semantic drift in the age of generative algorithms.",
    description_it: "Un soggetto bizzarro nato da un'allucinazione linguistica. L'artista aveva originariamente chiesto all'IA di generare 'Batman'. Tuttavia, a causa degli algoritmi di protezione del copyright, il sistema ha aggirato la proprietà intellettuale della DC Comics renderizzando letteralmente un 'bat-man'—interpretando 'bat' non come mammifero volante, ma come mazza di legno. La creatura risultante si erge come un brillante ready-made di interpretazione errata e deriva semantica nell'era degli algoritmi generativi."
  },
  {
    id: "trallallerotrallallà",
    filename: "trallallerotrallallà.gif",
    title: "Trallallero Trallallà",
    medium: "3D Model Reconstruction, Infinite Loop GIF",
    medium_it: "Ricostruzione Modello 3D, Loop Infinito GIF",
    dimensions: "1080 x 1080 px",
    description: "An eerie animal relic spinning in a state of solemn suspension. The work juxtaposes centuries-old regional Italian folk singing with hyper-accelerated internet garbage aesthetic, creating a haunting, beautiful tension between traditional oral memory and digital post-internet void.",
    description_it: "Un'inquietante reliquia animale che ruota in uno stato di solenne sospensione. L'opera contrappone canti popolari regionali italiani vecchi di secoli all'estetica iper-accelerata della spazzatura internet, creando una tensione affascinante tra la memoria orale tradizionale e il vuoto digitale post-internet."
  },
  {
    id: "trippitroppi",
    filename: "trippitroppi.gif",
    title: "Trippi Troppi, Troppa Trippa",
    medium: "3D Model Reconstruction, Infinite Loop GIF",
    medium_it: "Ricostruzione Modello 3D, Loop Infinito GIF",
    dimensions: "1080 x 1080 px",
    description: "A small, stylized pony spinning endlessly. The name phoneticizes the sound of hooves ('trot') with a hallucinatory state ('trip'), perfectly capturing the recursive, infinite scrolling experience of modern social media platforms—a spinning visual sedative.",
    description_it: "Un piccolo pony stilizzato che gira all'infinito. Il nome gioca foneticamente col suono degli zoccoli ('trot') e uno stato allucinatorio ('trip'), catturando perfettamente l'esperienza ricorsiva e di scorrimento infinito delle moderne piattaforme social—un sedativo visual in rotazione."
  }
];
---

<BaseLayout title="Brainrot Pavilion - Gabriele Radicello">
  <!-- Stark Gallery Header + Curator Essay: Spanned full viewport first scroll block -->
  <section class="max-w-6xl mx-auto px-6 pt-32 md:pt-40 pb-20 text-left min-h-[100dvh] flex flex-col justify-center snap-section select-none">
    <div class="border-b-4 border-neutral-950 pb-8 mb-16">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
        <div>
          <h1 
            class="text-4xl md:text-7xl font-bold tracking-tighter text-neutral-900 uppercase" 
            style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;"
          >
            Brainrot Pavilion
          </h1>
        </div>
        <div class="text-left md:text-right font-mono text-xs text-neutral-500 uppercase tracking-wider">
          <span>GABRIELE RADICELLO</span><br/>
          <span class="lang-en">SOLO DIGITAL SHOW — 2025</span>
          <span class="lang-it">MOSTRA DIGITALE PERSONALE — 2025</span>
        </div>
      </div>
    </div>

    <!-- Curator Essay / Context Plaques -->
    <div class="grid md:grid-cols-2 gap-12 font-mono text-sm leading-relaxed text-neutral-700">
      <div class="border-l-4 border-neutral-950 pl-6 space-y-6">
        <h3 class="text-lg font-bold text-neutral-900 uppercase tracking-tight">
          <span class="lang-en">00. Curatorial Statement</span>
          <span class="lang-it">00. Dichiarazione Curatoriale</span>
        </h3>
        <div class="lang-en">
          <p>
            This project consists of a series of animated GIFs that re-elaborate subjects taken from the Italian "brainrot" scene: funny, grotesque, or surreal animals generated with artificial intelligence and placed at the center of absurd digital narratives. Born and circulated within TikTok, these characters embody a chaotic, disturbing, and deeply comfort-driven aesthetic unique to the post-internet era.
          </p>
          <p class="mt-4">
            Through meticulous 3D modeling and animation, I wanted to strip them of their fleeting meme nature, decontextualizing them from the hyper-accelerated flow of social feeds to place them in a suspended, solemn dimension of contemplation.
          </p>
        </div>
        <div class="lang-it">
          <p>
            Questo progetto è costituito da una serie di GIF animate che rielaborano soggetti tratti dalla scena "brainrot" italiana: animali divertenti, grotteschi o surreali generati con intelligenza artificiale e posti al centro di assurde narrazioni digitali. Nati e circolati su TikTok, questi personaggi incarnano un'estetica caotica, inquietante e profondamente orientata al comfort, tipica dell'era post-internet.
          </p>
          <p class="mt-4">
            Attraverso meticolosi modelli 3D e animazioni, ho voluto spogliarli della loro effimera natura di meme, decontestualizzandoli dal flusso iper-accelerato dei feed social per porli in una dimensione di contemplazione solenne e sospesa.
          </p>
        </div>
      </div>
      <div class="border-l-4 border-neutral-950 pl-6 space-y-6">
        <h3 class="text-lg font-bold text-neutral-900 uppercase tracking-tight">
          <span class="lang-en">01. Digital Ready-Mades</span>
          <span class="lang-it">01. Ready-Made Digitali</span>
        </h3>
        <div class="lang-en">
          <p>
            Each subject has been isolated, reconstructed in three dimensions, and set in continuous, hypnotic rotation inside a digital showcase—like a sacred object, an archaeological artifact of our present. The resulting GIFs become digital showcases (teche) that display the contemporary absurd in a solemn, museum-grade manner.
          </p>
          <p class="mt-4">
            Inspired by the ready-mades of Marcel Duchamp and the digital exhibitions of Anthony Antonellis, this operation plays with the paradoxical and hallucinatory aesthetic of the contemporary web, freezing chaotic data flows into concrete digital relics.
          </p>
        </div>
        <div class="lang-it">
          <p>
            Ogni soggetto è stato isolato, ricostruito in tre dimensioni e posto in rotazione continua e ipnotica all'interno di una teca digitale—come un oggetto sacro, un reperto archeologico del nostro presente. Le GIF risultanti diventano teche digitali che espongono l'assurdo contemporaneo in modo solenne, da museo.
          </p>
          <p class="mt-4">
            Ispirata ai ready-made di Marcel Duchamp e alle mostre digitali di Anthony Antonellis, questa operazione gioca con l'estetica paradossale e allucinatoria del web contemporaneo, congelando flussi di dati caotici in concrete reliquie digitali.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Exhibition Vitrine Showcase: Spaced scroll-snapping layout -->
  <section class="max-w-6xl mx-auto px-6 text-left">
    <div>
      {pieces.map((piece) => (
        <article class="exhibition-card flex flex-col md:flex-row items-center justify-center gap-12 md:gap-20 min-h-[100dvh] w-full py-12 border-b border-neutral-200 last:border-b-0 snap-section">
          
          <!-- Digital Display Frame (Vitrine) -->
          <div class="exhibition-vitrine w-full md:w-1/2 aspect-square max-w-[460px] bg-neutral-100 flex items-center justify-center p-8 border-4 border-neutral-950 overflow-hidden relative select-none shrink-0">
            <img 
              src={getProxyUrl(`/progetti/brainrot-pavillion/${piece.filename}`)} 
              data-src={`/progetti/brainrot-pavillion/${piece.filename}`}
              alt={`3D spinning reconstruction of the Italian brainrot subject ${piece.title}`}
              class="w-4/5 h-4/5 object-contain select-none"
              draggable="false"
              loading="lazy"
            />
          </div>

          <!-- Museum Plaque Label (Targhetta Museale a Lato) -->
          <div class="w-full md:w-1/2 max-w-[460px] font-mono text-neutral-900 flex flex-col justify-center">
            <div class="mb-6">
              <h3 
                class="text-2xl font-bold uppercase tracking-tight text-neutral-900 leading-tight"
                style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;"
              >
                {piece.title}
              </h3>
            </div>

            <div class="space-y-1 text-xs text-neutral-500 uppercase border-b-2 border-dashed border-neutral-200 pb-4 mb-6">
              <div>
                <strong><span class="lang-en">Medium:</span><span class="lang-it">Medium:</span></strong> 
                <span class="lang-en">{piece.medium}</span>
                <span class="lang-it">{piece.medium_it}</span>
              </div>
              <div>
                <strong><span class="lang-en">Dimensions:</span><span class="lang-it">Dimensioni:</span></strong> 
                {piece.dimensions}
              </div>
            </div>

            <p class="text-sm leading-relaxed text-neutral-600 font-sans text-justify lowercase first-letter:uppercase">
              <span class="lang-en">{piece.description}</span>
              <span class="lang-it">{piece.description_it}</span>
            </p>
          </div>

        </article>
      ))}
    </div>
  </section>

  <!-- Global Brutalist White Cube Scoped Styles -->
  <style is:global>
    /* Add 'brainrot-cube' modifier class on body and html */
    body.brainrot-cube {
      background-color: #ffffff !important;
      color: #171717 !important;
      transition: background-color 0.8s cubic-bezier(0.4, 0, 0.2, 1), color 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Target specific components in BaseLayout for a stark minimal white cube look */
    body.brainrot-cube #logo-root,
    body.brainrot-cube #logo-link,
    body.brainrot-cube #header-name,
    body.brainrot-cube #header-nav a {
      color: #171717 !important;
      text-shadow: none !important;
      filter: none !important; /* completely strips logo & nav drop-shadow filters */
      transition: color 0.4s ease, filter 0.4s ease;
    }

    body.brainrot-cube #logo-link svg,
    body.brainrot-cube #logo-root {
      color: #171717 !important;
      filter: none !important;
    }

    /* Change header nav item hover to a minimalist clean charcoal instead of hot pink */
    body.brainrot-cube #header-nav a:hover {
      color: #737373 !important; /* clean medium neutral gray hover transition */
    }

    /* Logo hover: clean white glow! */
    body.brainrot-cube #logo-link:hover,
    body.brainrot-cube #logo-link:hover span,
    body.brainrot-cube #logo-link:hover svg,
    body.brainrot-cube #logo-root:hover {
      color: #ffffff !important;
      filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.95)) !important;
    }

    /* During active logo hover, dim other elements in white theme */
    body.brainrot-cube.logo-active main {
      opacity: 0.15 !important;
      filter: blur(4px) grayscale(0.5);
      pointer-events: none;
    }

    body.brainrot-cube.logo-active header #header-nav {
      opacity: 0.15 !important;
      filter: blur(4px);
      pointer-events: none;
    }

    /* Inactive teche cards fade and blur when another card is active in ASCII mode */
    html.ascii-active body.brainrot-cube .exhibition-card:not(.hovered-card) {
      opacity: 0.08 !important;
      filter: blur(6px) grayscale(0.8);
      pointer-events: none;
    }

    .exhibition-card {
      transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), 
                  filter 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: opacity, filter;
    }

    .exhibition-vitrine {
      /* Keep displays completely static without hovers or offsets */
      box-shadow: none !important;
      transform: none !important;
    }

    /* CSS Scroll Snapping configuration specifically for medium screens and above */
    @media (min-width: 768px) {
      html.brainrot-cube-active {
        scroll-snap-type: y mandatory !important; /* authoritative mandatory snap alignment */
        scroll-behavior: smooth !important;
        scroll-padding-top: 0px !important; /* clean precise alignment */
      }
      html.brainrot-cube-active body {
        scroll-snap-type: y mandatory !important;
      }
      .snap-section {
        scroll-snap-align: start !important;
        scroll-snap-stop: always !important; /* stops gracefully at each artwork display */
      }
    }
  </style>

  <script>
    // Handles body styling application safely for view transitions
    function handleCubeThemeToggle() {
      if (window.location.pathname.includes('/brainrot-pavillion')) {
        document.body.classList.add('brainrot-cube');
        document.documentElement.classList.add('brainrot-cube-active');
      } else {
        document.body.classList.remove('brainrot-cube');
        document.documentElement.classList.remove('brainrot-cube-active');
      }
    }

    // Setup and cleanup listeners
    function setup() {
      handleCubeThemeToggle();
    }

    setup();
    document.addEventListener('astro:page-load', setup);
    document.addEventListener('astro:after-swap', handleCubeThemeToggle);
  </script>
</BaseLayout>
