          src={getProxyUrl("/progetti/Street Rendering/(11).PNG")} data-src="/progetti/Street Rendering/(11).PNG"
          alt="Street Rendering 11"
          class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 gallery-img"
          loading="lazy"
        />
        <img
          src={getProxyUrl("/progetti/Street Rendering/(12).PNG")} data-src="/progetti/Street Rendering/(12).PNG"
          alt="Street Rendering 12"
          class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 gallery-img"
          loading="lazy"
        />
      </div>
    </div>
  </section>
</BaseLayout>
