---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact - Gabriele Radicello">
  <section class="mx-auto flex min-h-[70vh] flex-col items-center justify-center gap-12 px-6 py-20 text-left">
    <div class="max-w-4xl w-full">
      <h1
        class="mb-12 text-4xl md:text-6xl font-normal leading-none"
        style="font-family: 'Apple Garamond Custom', serif;"
      >
        See more on
      </h1>

      <div class="grid gap-4 md:grid-cols-4 w-full">
        <a
          href="mailto:gabriele@radicello.it"
          class="rounded-lg border border-neutral-700 p-5 transition-colors hover:bg-neutral-800"
        >
          <h3
            class="mb-1 text-lg font-normal text-neutral-50"
            style="font-family: 'Apple Garamond Custom', serif;"
          >
            Email
          </h3>
          <p class="text-xs text-neutral-400">gabriele@radicello.it</p>
        </a>

        <a
          href="https://instagram.com/gabriradix"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg border border-neutral-700 p-5 transition-colors hover:bg-neutral-800"
        >
          <h3
            class="mb-1 text-lg font-normal text-neutral-50"
            style="font-family: 'Apple Garamond Custom', serif;"
          >
            Instagram
          </h3>
          <p class="text-xs text-neutral-400">@gabriradix</p>
        </a>

        <a
          href="https://tiktok.com/@gabriradix"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg border border-neutral-700 p-5 transition-colors hover:bg-neutral-800"
        >
          <h3
            class="mb-1 text-lg font-normal text-neutral-50"
            style="font-family: 'Apple Garamond Custom', serif;"
          >
            TikTok
          </h3>
          <p class="text-xs text-neutral-400">@gabriradix</p>
        </a>

        <a
          href="https://x.com/gabriradix"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg border border-neutral-700 p-5 transition-colors hover:bg-neutral-800"
        >
          <h3
            class="mb-1 text-lg font-normal text-neutral-50"
            style="font-family: 'Apple Garamond Custom', serif;"
          >
            X (Twitter)
          </h3>
          <p class="text-xs text-neutral-400">@gabriradix</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
