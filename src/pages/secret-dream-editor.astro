---
import BaseLayout from "../layouts/BaseLayout.astro";
import fs from "node:fs";
import path from "node:path";
import { execSync } from "node:child_process";

// Risolviamo il percorso assoluto usando il CWD del processo per sicurezza
const dreamsPath = path.join(process.cwd(), "public", "progetti", "dream-catalogue", "dreams.json");
let message = "";
let messageType = "success";

// Carichiamo i sogni esistenti con pulizia profonda dei caratteri invisibili
const rawDreams = fs.readFileSync(dreamsPath, "utf8");
const jsonStart = rawDreams.indexOf('[');
const cleanDreams = jsonStart !== -1 ? rawDreams.substring(jsonStart).trim() : "[]";
const currentDreams = JSON.parse(cleanDreams);

// Estrazione suggerimenti (Tag unici)
const suggestions = {
  mood: [...new Set(currentDreams.flatMap((d: any) => d.mood_principale || []))].sort(),
  ambientazione: [...new Set(currentDreams.map((d: any) => d.ambientazione).filter(Boolean))].sort(),
  oggetti: [...new Set(currentDreams.flatMap((d: any) => d.oggetti_chiave || []))].sort(),
  elementi: [...new Set(currentDreams.flatMap((d: any) => d.elementi_naturali || []))].sort(),
  persone: [...new Set(currentDreams.flatMap((d: any) => d.persone?.tipologia || []))].sort(),
};

if (Astro.request.method === "POST") {
  const contentType = Astro.request.headers.get("content-type");
  if (contentType && (contentType.includes("application/x-www-form-urlencoded") || contentType.includes("multipart/form-data"))) {
    try {
      const data = await Astro.request.formData();
      const action = data.get("action");

      if (action === "add_dream") {
        // Rileggiamo i sogni freschi dal disco per evitare race conditions
        const freshRaw = fs.readFileSync(dreamsPath, "utf8");
        const freshStart = freshRaw.indexOf('[');
        const freshDreams = JSON.parse(freshRaw.substring(freshStart).trim());

        // Creiamo il nuovo oggetto sogno
        const newDream = {
        id: freshDreams.length > 0 ? Math.max(...freshDreams.map((d: any) => d.id)) + 1 : 1,
        data: data.get("data")?.toString() || "?",
        titolo: data.get("titolo")?.toString() || "Senza titolo",
        ricordo_percentuale: Number(data.get("ricordo_percentuale")) || 0,
        importanza_soggettiva: Number(data.get("importanza_soggettiva")) || 0,
        lucidita: Number(data.get("lucidita")) || 0,
        bizzarria: Number(data.get("bizzarria")) || 0,
        mood_principale: (data.get("mood_principale")?.toString() || "").split(",").map(s => s.trim()).filter(s => s),
        persone: {
            quantita: Number(data.get("persone_quantita")) || 0,
            tipologia: (data.get("persone_tipologia")?.toString() || "").split(",").map(s => s.trim()).filter(s => s),
            volti_definiti: data.get("volti_definiti") === "on"
        },
        oggetti_chiave: (data.get("oggetti_chiave")?.toString() || "").split(",").map(s => s.trim()).filter(s => s),
        ambientazione: data.get("ambientazione")?.toString() || "",
        elementi_naturali: (data.get("elementi_naturali")?.toString() || "").split(",").map(s => s.trim()).filter(s => s),
        frequenza: data.get("frequenza")?.toString() || "1",
        durata_percepita_min: Number(data.get("durata_percepita_min")) || 0,
        prospettiva: data.get("prospettiva")?.toString() || "prima persona",
        "bianco e nero": data.get("bianco_e_nero") === "on",
        musica: data.get("musica")?.toString() || ""
        };
        
        freshDreams.push(newDream);
        fs.writeFileSync(dreamsPath, JSON.stringify(freshDreams, null, 2), "utf8");
        
        // Auto-commit opzionale (se git è presente)
        try {
            execSync('git add public/progetti/dream-catalogue/dreams.json', { stdio: 'ignore' });
            execSync(`git commit -m "oniric update: ${newDream.titolo}"`, { stdio: 'ignore' });
            return Astro.redirect("/secret-dream-editor?success=true&committed=true&title=" + encodeURIComponent(newDream.titolo));
        } catch (e) {
            return Astro.redirect("/secret-dream-editor?success=true&title=" + encodeURIComponent(newDream.titolo));
        }
    }

    if (action === "push_github") {
        try {
            execSync('git push', { stdio: 'ignore' });
            message = "Sincronizzazione GitHub completata con successo!";
            messageType = "success";
        } catch (e) {
            message = "Errore Git Push: Assicurati di aver configurato il repository remoto.";
            messageType = "error";
        }
    }
  } catch (error) {
    message = "Errore: " + (error as Error).message;
    messageType = "error";
  }
 }
}

const success = Astro.url.searchParams.get("success") === "true";
const committed = Astro.url.searchParams.get("committed") === "true";
const addedTitle = Astro.url.searchParams.get("title");
if (success) {
    message = `Sogno "${addedTitle}" salvato${committed ? ' e committato' : ''} con successo!`;
}

// Ordiniamo i sogni per ID decrescente per vedere gli ultimi inseriti
const latestDreams = [...currentDreams].reverse().slice(0, 5);
---

<BaseLayout title="Dream Dashboard — Secret Access">
  <!-- Sfondo Ambientale -->
  <div class="fixed inset-0 -z-10 bg-[#050505] pointer-events-none">
    <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-purple-950/10 blur-[120px] animate-pulse"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-blue-950/10 blur-[120px] animate-pulse" style="animation-delay: 2s;"></div>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-32 min-h-screen">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-16 gap-8">
      <div class="animate-in fade-in slide-in-from-left duration-700">
        <h1 class="text-6xl font-normal mb-4 tracking-tighter" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">Dream Dashboard</h1>
        <div class="flex items-center gap-3">
          <span class="w-2 h-2 bg-purple-500 rounded-full animate-ping"></span>
          <p class="text-neutral-500 tracking-[0.2em] uppercase text-[10px] font-bold">Terminal Access — Database v2.6 [Git Ready]</p>
        </div>
      </div>

      <div class="flex gap-4 animate-in fade-in slide-in-from-right duration-700">
        <form method="POST" class="inline">
            <input type="hidden" name="action" value="push_github" />
            <button 
                type="submit"
                class="bg-neutral-900/50 hover:bg-white hover:text-black border border-neutral-800 rounded-2xl px-6 py-4 transition-all flex items-center gap-3 group"
            >
                <span class="text-lg group-hover:scale-110 transition-transform">🚀</span>
                <div class="flex flex-col items-start">
                    <span class="text-[10px] text-neutral-500 uppercase tracking-widest leading-none mb-1">GitHub Sync</span>
                    <span class="text-xs font-bold leading-none">Push Changes</span>
                </div>
            </button>
        </form>
        
        <div class="bg-neutral-900/50 backdrop-blur-xl border border-neutral-800 rounded-2xl p-4 flex flex-col items-center min-w-[100px]">
          <span class="text-2xl font-mono text-white">{currentDreams.length}</span>
          <span class="text-[10px] text-neutral-500 uppercase tracking-widest">Totale Sogni</span>
        </div>
      </div>
    </div>

    {message && (
      <div class={`mb-12 p-6 rounded-2xl border backdrop-blur-xl animate-in zoom-in duration-300 ${messageType === 'success' ? 'bg-green-950/10 border-green-500/30 text-green-400' : 'bg-red-950/10 border-red-500/30 text-red-400'}`}>
        <div class="flex items-center gap-4">
          <div class={`w-10 h-10 rounded-full flex items-center justify-center ${messageType === 'success' ? 'bg-green-500/20' : 'bg-red-500/20'}`}>
            {messageType === 'success' ? '✓' : '✕'}
          </div>
          <div>
            <p class="font-medium text-lg">{message}</p>
            <p class="text-sm opacity-70">L'integrazione Git è attiva: le modifiche sono tracciate.</p>
          </div>
        </div>
      </div>
    )}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- FORM PRINCIPALE -->
      <div class="lg:col-span-2 space-y-12">
        <form method="POST" class="bg-neutral-900/40 backdrop-blur-3xl border border-neutral-800/50 rounded-[2rem] p-10 shadow-2xl space-y-10 animate-in fade-in duration-1000">
          <input type="hidden" name="action" value="add_dream" />
          
          <section class="space-y-8">
            <h2 class="text-xs uppercase tracking-[0.3em] text-purple-400 font-bold mb-8">Informazioni Core</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <div class="group">
                <label class="block text-[10px] uppercase tracking-widest text-neutral-500 mb-3 group-focus-within:text-purple-400 transition-colors">Titolo Esperienza</label>
                <input 
                  type="text" 
                  name="titolo" 
                  placeholder="Inserisci un titolo..." 
                  class="w-full bg-neutral-950/50 border border-neutral-800 rounded-xl p-4 text-white focus:outline-none focus:border-purple-500/50 focus:ring-4 focus:ring-purple-500/5 transition-all placeholder:text-neutral-700"
                  required
                />
              </div>
              <div class="group">
                <label class="block text-[10px] uppercase tracking-widest text-neutral-500 mb-3 group-focus-within:text-purple-400 transition-colors">Data Astrale</label>
                <input 
                  type="text" 
                  name="data" 
                  placeholder="gg/mm/aaaa" 
                  class="w-full bg-neutral-950/50 border border-neutral-800 rounded-xl p-4 text-white focus:outline-none focus:border-purple-500/50 focus:ring-4 focus:ring-purple-500/5 transition-all placeholder:text-neutral-700"
                />
              </div>
            </div>
          </section>

          <section class="space-y-10">
            <h2 class="text-xs uppercase tracking-[0.3em] text-blue-400 font-bold mb-8">Metriche Oniriche</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-12">
              {[
                { name: 'ricordo_percentuale', label: 'Livello di Ricordo', color: 'purple', unit: '%' },
                { name: 'importanza_soggettiva', label: 'Peso Emotivo', color: 'blue', unit: '/100' },
                { name: 'lucidita', label: 'Grado di Lucidità', color: 'cyan', unit: '/100' },
                { name: 'bizzarria', label: 'Indice di Bizzarria', color: 'pink', unit: '/100' }
              ].map(m => (
                <div class="space-y-4">
                  <div class="flex justify-between items-center">
                    <label class="text-[10px] uppercase tracking-widest text-neutral-500">{m.label}</label>
                    <span id={`val-${m.name}`} class={`text-${m.color}-400 font-mono text-xs bg-${m.color}-400/10 px-2 py-1 rounded`}>50{m.unit}</span>
                  </div>
                  <input 
                    type="range" 
                    name={m.name} 
                    min="0" max="100" value="50" 
                    class="w-full h-1 bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-white" 
                    oninput={`document.getElementById('val-${m.name}').innerText = this.value + '${m.unit}'`}
                  />
                </div>
              ))}
            </div>
          </section>

          <section class="space-y-12">
            <h2 class="text-xs uppercase tracking-[0.3em] text-neutral-400 font-bold mb-8">Dettagli Narrativi</h2>
            
            <div class="space-y-4">
              <label class="block text-[10px] uppercase tracking-widest text-neutral-500">Mood Principali</label>
              <input type="text" name="mood_principale" data-suggest="mood" class="tag-input w-full bg-neutral-950/50 border border-neutral-800 rounded-xl p-4 text-white focus:border-neutral-600 focus:outline-none transition-all text-sm"/>
              <div class="flex flex-wrap gap-2 mt-2">
                {suggestions.mood.slice(0, 15).map(m => (
                  <button type="button" class="tag-suggestion text-[9px] uppercase tracking-wider bg-white/5 border border-white/5 px-2 py-1 rounded-md text-neutral-500 hover:text-white hover:bg-white/10 transition-all" data-value={m}>{m}</button>
                ))}
              </div>
            </div>

            <div class="space-y-4">
              <label class="block text-[10px] uppercase tracking-widest text-neutral-500">Ambientazione Virtuale</label>
              <input type="text" name="ambientazione" data-suggest="ambientazione" class="tag-input w-full bg-neutral-950/50 border border-neutral-800 rounded-xl p-4 text-white focus:border-neutral-600 focus:outline-none transition-all text-sm"/>
              <div class="flex flex-wrap gap-2 mt-2">
                {suggestions.ambientazione.slice(0, 10).map(a => (
                  <button type="button" class="tag-suggestion text-[9px] uppercase tracking-wider bg-white/5 border border-white/5 px-2 py-1 rounded-md text-neutral-500 hover:text-white hover:bg-white/10 transition-all" data-value={a}>{a}</button>
                ))}
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
              <div class="space-y-4">
                <label class="block text-[10px] uppercase tracking-widest text-neutral-500">Oggetti Chiave</label>
                <input type="text" name="oggetti_chiave" data-suggest="oggetti" class="tag-input w-full bg-neutral-950/50 border border-neutral-800 rounded-xl p-4 text-white focus:border-neutral-600 focus:outline-none transition-all text-sm"/>
                <div class="flex flex-wrap gap-2 mt-2">
                  {suggestions.oggetti.slice(0, 8).map(o => (
                    <button type="button" class="tag-suggestion text-[9px] uppercase tracking-wider bg-white/5 border border-white/5 px-2 py-1 rounded-md text-neutral-500 hover:text-white hover:bg-white/10 transition-all" data-value={o}>{o}</button>
                  ))}
                </div>
              </div>
              <div class="space-y-4">
                <label class="block text-[10px] uppercase tracking-widest text-neutral-500">Elementi Naturali</label>
                <input type="text" name="elementi_naturali" data-suggest="elementi" class="tag-input w-full bg-neutral-950/50 border border-neutral-800 rounded-xl p-4 text-white focus:border-neutral-600 focus:outline-none transition-all text-sm"/>
                <div class="flex flex-wrap gap-2 mt-2">
                  {suggestions.elementi.slice(0, 8).map(e => (
                    <button type="button" class="tag-suggestion text-[9px] uppercase tracking-wider bg-white/5 border border-white/5 px-2 py-1 rounded-md text-neutral-500 hover:text-white hover:bg-white/10 transition-all" data-value={e}>{e}</button>
                  ))}
                </div>
              </div>
            </div>
          </section>

          <section class="bg-white/[0.02] border border-white/5 p-8 rounded-3xl space-y-8">
            <div class="flex justify-between items-center">
                <h3 class="text-xs uppercase tracking-[0.2em] text-neutral-500 font-bold">Popolazione</h3>
                <div class="flex items-center gap-3">
                    <input type="checkbox" name="volti_definiti" id="volti" class="w-4 h-4 accent-white rounded bg-neutral-800 border-neutral-700"/>
                    <label for="volti" class="text-[10px] uppercase tracking-widest text-neutral-500 cursor-pointer">Volti Definiti</label>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              <div class="space-y-4">
                <label class="block text-[10px] uppercase tracking-widest text-neutral-500 mb-2">N. Persone</label>
                <input type="number" name="persone_quantita" value="0" class="w-full bg-neutral-950/30 border border-neutral-800 rounded-xl p-4 text-white focus:outline-none text-center"/>
              </div>
              <div class="md:col-span-2 space-y-4">
                <label class="block text-[10px] uppercase tracking-widest text-neutral-500 mb-2">Tipologia Presenze</label>
                <input type="text" name="persone_tipologia" data-suggest="persone" class="tag-input w-full bg-neutral-950/30 border border-neutral-800 rounded-xl p-4 text-white focus:outline-none text-sm"/>
                <div class="flex flex-wrap gap-2 mt-2">
                  {suggestions.persone.slice(0, 8).map(p => (
                    <button type="button" class="tag-suggestion text-[9px] uppercase tracking-wider bg-white/5 border border-white/5 px-2 py-1 rounded-md text-neutral-500 hover:text-white hover:bg-white/10 transition-all" data-value={p}>{p}</button>
                  ))}
                </div>
              </div>
            </div>
          </section>

          <div class="pt-8 border-t border-neutral-800/50 flex flex-col md:flex-row gap-8 items-center justify-between">
            <div class="flex gap-12">
                <div class="flex items-center gap-3 group cursor-pointer">
                    <input type="checkbox" name="bianco_e_nero" id="bn" class="w-5 h-5 accent-white rounded-md bg-neutral-800 border-neutral-700 transition-all"/>
                    <label for="bn" class="text-xs uppercase tracking-widest text-neutral-500 group-hover:text-neutral-300 transition-colors">B&W Mode</label>
                </div>
                <div class="group">
                    <select name="prospettiva" class="bg-transparent text-xs uppercase tracking-widest text-neutral-500 border-b border-neutral-800 focus:border-white focus:text-white focus:outline-none pb-1 transition-all cursor-pointer">
                        <option value="prima persona">POV: Prima Persona</option>
                        <option value="terza persona">POV: Terza Persona</option>
                        <option value="?">POV: Indefinito</option>
                    </select>
                </div>
            </div>

            <button 
              type="submit"
              class="relative px-20 py-5 bg-white text-black font-black rounded-full transition-all hover:scale-105 hover:shadow-[0_0_40px_rgba(255,255,255,0.2)] active:scale-95 group overflow-hidden"
            >
              <span class="relative z-10 uppercase tracking-[0.3em] text-xs">Commit to Database</span>
              <div class="absolute inset-0 bg-neutral-200 translate-y-full group-hover:translate-y-0 transition-transform duration-500"></div>
            </button>
          </div>
        </form>
      </div>

      <!-- SIDEBAR - RECENT DREAMS -->
      <div class="space-y-8 animate-in fade-in slide-in-from-bottom duration-1000">
        <h2 class="text-xs uppercase tracking-[0.3em] text-neutral-500 font-bold px-4">Timeline Recente</h2>
        <div class="space-y-4">
          {latestDreams.map((dream, index) => (
            <div 
              class="group bg-neutral-900/30 border border-neutral-800/50 rounded-2xl p-6 hover:bg-neutral-800/40 transition-all cursor-default"
              style={`animation-delay: ${index * 100}ms`}
            >
              <div class="flex justify-between items-start mb-3">
                <span class="text-[10px] font-mono text-neutral-600">ID: #{dream.id}</span>
                <span class="text-[10px] font-mono text-neutral-600 italic">{dream.data}</span>
              </div>
              <h3 class="text-lg font-medium text-neutral-200 group-hover:text-white transition-colors mb-4">{dream.titolo}</h3>
              <div class="flex flex-wrap gap-2">
                {dream.mood_principale.slice(0, 3).map((mood: string) => (
                  <span class="text-[8px] uppercase tracking-widest bg-white/5 border border-white/10 px-2 py-1 rounded-full text-neutral-400">
                    {mood}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
        
        <div class="p-8 bg-gradient-to-br from-purple-900/20 to-blue-900/20 border border-white/5 rounded-3xl mt-12">
            <h4 class="text-white text-sm font-bold mb-3 italic text-balance leading-relaxed">"I sogni sono risposte a domande che non abbiamo ancora imparato a porre."</h4>
            <p class="text-neutral-500 text-[10px] uppercase tracking-widest">— Algorithmic Oracle</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Gestione Suggerimenti Tag
  document.querySelectorAll('.tag-suggestion').forEach(button => {
    button.addEventListener('click', () => {
      const value = button.getAttribute('data-value');
      const input = button.parentElement?.previousElementSibling as HTMLInputElement;
      
      if (input && value) {
        const currentValues = input.value.split(',').map(v => v.trim()).filter(v => v);
        if (!currentValues.includes(value)) {
          currentValues.push(value);
          input.value = currentValues.join(', ');
          
          // Effetto visivo di conferma sul suggerimento
          button.classList.add('bg-white/20', 'text-white', 'border-white/20');
          setTimeout(() => {
            button.classList.remove('bg-white/20', 'text-white', 'border-white/20');
          }, 300);
        }
      }
    });
  });
</script>

<style is:global>
  /* Custom Scrollbar */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: #050505; }
  ::-webkit-scrollbar-thumb { background: #222; border-radius: 10px; }
  ::-webkit-scrollbar-thumb:hover { background: #333; }

  /* Range Input Styling */
  input[type='range'] { -webkit-appearance: none; background: transparent; }
  input[type='range']::-webkit-slider-runnable-track { width: 100%; height: 4px; background: #171717; border-radius: 2px; }
  input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none; height: 16px; width: 16px; border-radius: 50%;
    background: #fff; cursor: pointer; margin-top: -6px;
    box-shadow: 0 0 15px rgba(255,255,255,0.3); border: 2px solid #050505;
    transition: transform 0.2s;
  }
  input[type='range']:active::-webkit-slider-thumb { transform: scale(1.2); }

  /* Tailwind Animations */
  @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes slide-in-from-left { from { transform: translateX(-20px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
  @keyframes slide-in-from-right { from { transform: translateX(20px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
  @keyframes slide-in-from-bottom { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
  @keyframes zoom-in { from { transform: scale(0.95); opacity: 0; } to { transform: scale(1); opacity: 1; } }

  .animate-in { animation-fill-mode: both; }
  .fade-in { animation-name: fade-in; }
  .slide-in-from-left { animation-name: slide-in-from-left; }
  .slide-in-from-right { animation-name: slide-in-from-right; }
  .slide-in-from-bottom { animation-name: slide-in-from-bottom; }
  .zoom-in { animation-name: zoom-in; }
</style>
