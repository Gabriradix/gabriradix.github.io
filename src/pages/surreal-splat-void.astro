---
import { getProxyUrl } from "../utils/image";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";

const project = projects.find(p => p.title === "Surreal Splat Void");
---

<BaseLayout 
  title="Surreal Splat Void - Gabriele Radicello" 
  transparentHeader={true}
  brandColor={project?.brandColor || "#ffffff"}
>
  <!-- Desktop Version -->
  <div class="w-full h-[100dvh] overflow-hidden hidden md:block">
    <iframe
      id="splat-iframe"
      src=""
      data-src={getProxyUrl("/progetti/surreal-splat-void/index.html")}
      class="w-full h-full border-none"
      allow="autoplay; fullscreen; vr"></iframe>
  </div>

  <!-- Mobile Fallback (Centered minimal layout matching 404 page aesthetic) -->
  <div class="md:hidden w-full h-[100dvh] flex flex-col items-center justify-center bg-neutral-900 px-6 text-center">
    <div class="flex flex-col items-center justify-center w-full">
      <a
        class="flex items-center gap-4 text-3xl font-normal tracking-tight text-neutral-300 transition-colors hover:text-white mb-8"
        href="/"
        style="font-family: 'Apple Garamond Custom', serif;"
      >
        <span
          class="text-7xl font-normal leading-none"
          style="font-family: 'Roboto', sans-serif;">√</span>
        <div class="flex flex-col leading-[1] text-left">
          <span>Gabriele</span>
          <span>Radicello</span>
        </div>
      </a>
      <p class="text-neutral-400 text-[15px] leading-relaxed max-w-[290px] text-center lowercase" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">
        "Surreal Splat Void" involves heavy 3D Gaussian Splatting and is currently only optimized for desktop viewing.
      </p>
    </div>
  </div>

  <script>
    function initSplatPage() {
      const iframe = document.getElementById('splat-iframe') as HTMLIFrameElement | null;
      if (iframe && window.innerWidth >= 768) {
        const realSrc = iframe.getAttribute('data-src');
        if (realSrc && !iframe.getAttribute('src')) {
          iframe.setAttribute('src', realSrc);
        }
      }

      // Force compact header on desktop for this immersive page
      if (window.innerWidth >= 768) {
        window.postMessage('force-compact-header', '*');
      }
    }

    // Run immediately on page load
    initSplatPage();

    // Re-run on client-side SPA swap transition
    document.addEventListener('astro:page-load', initSplatPage);
  </script>
</BaseLayout>
