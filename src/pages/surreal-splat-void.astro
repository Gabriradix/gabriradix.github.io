---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";

const project = projects.find(p => p.title === "Surreal Splat Void");
---

<BaseLayout 
  title="Surreal Splat Void - Gabriele Radicello" 
  transparentHeader={true}
  brandColor={project?.brandColor || "#ffffff"}
>
  <div class="fixed inset-0 w-full h-full z-0">
    <iframe
      src="/progetti/Web3D/index.html"
      class="w-full h-full border-none"
      allow="autoplay; fullscreen; vr"></iframe>
  </div>

  <script>
    // Force compact header on mobile for this specific page
    if (window.innerWidth < 768) {
      window.postMessage('force-compact-header', '*');
    }
  </script>
</BaseLayout>
