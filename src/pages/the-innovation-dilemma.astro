---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getProxyUrl } from "../utils/image";
import { projects } from "../data/projects";

const project = projects.find((p) => p.href === "/the-innovation-dilemma");
---

<BaseLayout title="The Innovation Dilemma - Gabriele Radicello">
  <!-- Hero Section -->
  <section class="relative h-[100svh] md:h-[100dvh] w-full overflow-hidden flex items-center justify-center">
    <img 
      src={getProxyUrl("/progetti/the-innovation-dilemma/1.jpg")} 
      data-src="/progetti/the-innovation-dilemma/1.jpg"
      alt="The Innovation Dilemma documentary cover"
      class="absolute inset-0 w-full h-full object-cover z-0 opacity-40"
    />
    <div class="absolute inset-0 bg-black/60 z-10"></div>
    
    <div class="relative z-20 text-center px-6">
      <h1 
        class="text-5xl md:text-8xl font-semibold text-white tracking-tight" 
        style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;"
      >
        The Innovation Dilemma
      </h1>
      <p class="lang-en mt-6 text-xl text-neutral-300 font-light max-w-2xl mx-auto">
        A documentary short exploring the friction and dialogue between traditional art and Artificial Intelligence.
      </p>
      <p class="lang-it mt-6 text-xl text-neutral-300 font-light max-w-2xl mx-auto">
        Un cortometraggio documentario che esplora la frizione e il dialogo tra arte tradizionale e Intelligenza Artificiale.
      </p>
      <p class="lang-en mt-4 text-sm text-neutral-400">
        Winner of the Audience Award (Premio del Pubblico) — Last Gesture International Film Contest 2026
      </p>
      <p class="lang-it mt-4 text-sm text-neutral-400">
        Vincitore del Premio del Pubblico — Last Gesture International Film Contest 2026
      </p>
    </div>
  </section>

  <!-- Content Section -->
  <section class="max-w-4xl mx-auto px-6 py-24 md:py-32 text-neutral-300 text-lg leading-8 text-left">
    
    <!-- English Content -->
    <div class="lang-en">
      <!-- Video Section -->
      <div class="mb-24">
        <h2 class="text-3xl font-semibold text-neutral-50 mb-8" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">
          Documentary
        </h2>
        <div class="aspect-video w-full rounded-lg overflow-hidden bg-neutral-900 border border-neutral-800">
          <iframe
            src="https://www.youtube.com/embed/Z6ZvOaz_YmI"
            title="The Innovation Dilemma"
            class="w-full h-full border-none"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href="/progetti/the-innovation-dilemma/Sinossi e Nota d'intenti.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-8 py-3 border border-neutral-700 text-neutral-300 hover:bg-white hover:text-black transition-colors duration-300 font-medium tracking-wide text-sm uppercase"
          >
            Download PDF Presentation
          </a>
        </div>
      </div>

      <!-- Synopsis Section -->
      <div class="mb-16 md:mb-24">
        <h2 class="text-3xl font-semibold text-neutral-50 mb-8" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">
          Synopsis
        </h2>
        <div class="grid gap-8">
          <p>
            The short documentary explores the confrontation and dialogue between traditional art and new technologies, questioning the role of Artificial Intelligence and the delegation of creative gesture and thought.
          </p>
          <p>
            Guided by an objective and impartial voiceover that introduces and contextualizes the themes, the work unfolds through a choral weaving of direct testimonies. The words and visions of professors of sculpture, 3D modeling, and multimedia installations, alongside those of sculpture and new technologies students, construct a conceptual and visual bridge between the physical exertion of the chisel and the new frontiers of digital fabrication.
          </p>
        </div>
      </div>

      <!-- Director's Intent Section -->
      <div class="mb-16 md:mb-24">
        <h2 class="text-3xl font-semibold text-neutral-50 mb-8" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">
          Director's Intent
        </h2>
        <div class="grid gap-8">
          <p>
            The idea at the core of this project stems from the desire to closely and unjudgmentally observe how technology is redefining the boundaries of the artistic craft. Our goal is not to take sides in a reductive opposition between nostalgia for the past and blind exaltation of progress, but rather to convey the complexity of this historical moment.
          </p>
        </div>
      </div>

      <!-- Award Section -->
      <div class="mb-16 md:mb-24">
        <h2 class="text-3xl font-semibold text-neutral-50 mb-8" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">
          Awards & Festival
        </h2>
        <p>Winner of the Audience Award (Premio del Pubblico) at the Last Gesture International Film Contest 2026.</p>
      </div>

      <!-- Gallery -->
      <div class="border-t border-neutral-800 pt-16 mb-24">
        <h2 class="text-3xl font-semibold text-neutral-50 mb-12" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">
          Film Stills
        </h2>
      </div>
    </div>

    <!-- Italian Content -->
    <div class="lang-it">
      <!-- Video Section -->
      <div class="mb-24">
        <h2 class="text-3xl font-semibold text-neutral-50 mb-8" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">
          Documentario
        </h2>
        <div class="aspect-video w-full rounded-lg overflow-hidden bg-neutral-900 border border-neutral-800">
          <iframe
            src="https://www.youtube.com/embed/Z6ZvOaz_YmI"
            title="The Innovation Dilemma"
            class="w-full h-full border-none"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href="/progetti/the-innovation-dilemma/Sinossi e Nota d'intenti.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-8 py-3 border border-neutral-700 text-neutral-300 hover:bg-white hover:text-black transition-colors duration-300 font-medium tracking-wide text-sm uppercase"
          >
            Scarica Presentazione PDF
          </a>
        </div>
      </div>

      <!-- Synopsis Section -->
      <div class="mb-16 md:mb-24">
        <h2 class="text-3xl font-semibold text-neutral-50 mb-8" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">
          Sinossi
        </h2>
        <div class="grid gap-8">
          <p>
            Il cortometraggio documentario esplora il confronto e il dialogo tra arte tradizionale e nuove tecnologie, interrogandosi sul ruolo dell'Intelligenza Artificiale e sulla delega del gesto e del pensiero creativo.
          </p>
          <p>
            Guidato da una voce fuori campo obiettiva e imparziale che introduce e contestualizza i temi, l'opera si sviluppa attraverso un intreccio corale di testimonianze dirette. Le parole e le visioni di docenti di scultura, modellazione 3D e installazioni multimediali, affiancate a quelle degli studenti di scultura e nuove tecnologie, costruiscono un ponte concettuale e visivo tra la fatica fisica dello scalpello e le nuove frontiere della fabbricazione digitale.
          </p>
        </div>
      </div>

      <!-- Director's Intent Section -->
      <div class="mb-16 md:mb-24">
        <h2 class="text-3xl font-semibold text-neutral-50 mb-8" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">
          Nota d'intenti
        </h2>
        <div class="grid gap-8">
          <p>
            L'idea alla base di questo progetto nasce dalla volontà di osservare da vicino e senza pregiudizi come la tecnologia stia ridefinendo i confini del mestiere artistico. Il nostro obiettivo non è prendere posizione in una riduttiva contrapposizione tra nostalgia del passato e cieca esaltazione del progresso, ma piuttosto restituire la complessità di questo momento storico.
          </p>
        </div>
      </div>

      <!-- Award Section -->
      <div class="mb-16 md:mb-24">
        <h2 class="text-3xl font-semibold text-neutral-50 mb-8" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">
          Premi e Festival
        </h2>
        <p>Vincitore del Premio del Pubblico al Festival Internazionale del Cinema Last Gesture 2026.</p>
      </div>

      <!-- Gallery -->
      <div class="border-t border-neutral-800 pt-16 mb-24">
        <h2 class="text-3xl font-semibold text-neutral-50 mb-12" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">
          Fotogrammi del Film
        </h2>
      </div>
    </div>

    <!-- Common Stills Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <img src={getProxyUrl("/progetti/the-innovation-dilemma/1.jpg")} data-src="/progetti/the-innovation-dilemma/1.jpg" alt="Frame 1" class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 gallery-img" loading="lazy" />
      <img src={getProxyUrl("/progetti/the-innovation-dilemma/2.jpg")} data-src="/progetti/the-innovation-dilemma/2.jpg" alt="Frame 2" class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 gallery-img" loading="lazy" />
      <img src={getProxyUrl("/progetti/the-innovation-dilemma/3.jpg")} data-src="/progetti/the-innovation-dilemma/3.jpg" alt="Frame 3" class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 gallery-img" loading="lazy" />
      <img src={getProxyUrl("/progetti/the-innovation-dilemma/4.jpg")} data-src="/progetti/the-innovation-dilemma/4.jpg" alt="Frame 4" class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 gallery-img" loading="lazy" />
    </div>

    <!-- Credits Section -->
    <div class="border-t border-neutral-800 pt-16 mt-24">
      <h2 class="lang-en text-3xl font-semibold text-neutral-50 mb-8" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">Credits</h2>
      <h2 class="lang-it text-3xl font-semibold text-neutral-50 mb-8" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">Crediti</h2>
      <div class="lang-en grid gap-2 text-neutral-400 text-base">
        <p><strong class="text-neutral-200">Director:</strong> Gabriele Radicello</p>
        <p><strong class="text-neutral-200">Voiceover AI:</strong> ElevenLabs</p>
        <p><strong class="text-neutral-200">Music AI:</strong> Suno AI</p>
        <p><strong class="text-neutral-200">Award:</strong> Winner of Audience Award — Last Gesture International Film Contest 2026</p>
      </div>
      <div class="lang-it grid gap-2 text-neutral-400 text-base">
        <p><strong class="text-neutral-200">Regia:</strong> Gabriele Radicello</p>
        <p><strong class="text-neutral-200">Voce Fuori Campo IA:</strong> ElevenLabs</p>
        <p><strong class="text-neutral-200">Musica IA:</strong> Suno AI</p>
        <p><strong class="text-neutral-200">Premio:</strong> Vincitore del Premio del Pubblico — Last Gesture International Film Contest 2026</p>
      </div>
    </div>

  </section>
</BaseLayout>
