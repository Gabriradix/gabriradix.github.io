---
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
import BaseLayout from "../layouts/BaseLayout.astro";
// Force rebuild to pick up projects.ts changes
---

<BaseLayout title="Gabriele Radicello (gabriradix) — Multimedia Artist">
  <div class="pt-40 pb-24 md:pt-64 md:pb-32 max-w-7xl mx-auto pl-6 md:pl-12 relative">
    <h1 class="sr-only"><span class="lang-en" lang="en">Gabriele Radicello — Selected work</span><span class="lang-it" lang="it">Gabriele Radicello — Progetti selezionati</span></h1>
    <section class="flex flex-col gap-12 md:gap-20 relative" id="projects-section">
      {projects.map((project, index) => <ProjectCard {...project} priority={index === 0} />)}
    </section>
  </div>
</BaseLayout>
