---
import BaseLayout from "../layouts/BaseLayout.astro";
import { bioText } from "../data/about";
---

<BaseLayout title="About - Gabriele Radicello">
  <section class="relative min-h-[90vh] w-full pt-24 md:pt-44 pb-12 px-2 md:px-8 max-w-7xl mx-auto flex flex-col items-center justify-start">
    
    <div class="about-introduction relative w-full max-w-[1024px] mx-auto mb-6 md:mb-12">
    <!-- Hero / Splat & Pretext Interactive Area -->
    <div id="about-hero" class="relative w-full max-w-[1024px] mx-auto select-none flex flex-col md:flex-row items-start md:items-center justify-start md:justify-center min-h-[320px] md:min-h-[530px]">
      
      <!-- The portrait stays within the biography while all text flows past it. -->
      <div class="splat-track absolute inset-x-0 -top-16 bottom-0 min-h-[460px] md:top-0 md:min-h-[530px] pointer-events-none z-[2]">
      <div 
        id="splat-container" 
        class="sticky top-8 md:absolute md:top-0 left-0 md:left-auto right-auto md:right-0 mr-auto md:mr-0 w-[100%] md:w-full h-[460px] md:h-[530px] z-[2] self-start md:self-auto pointer-events-auto cursor-grab active:cursor-grabbing touch-pan-y flex items-center justify-center -translate-x-[110px] md:translate-x-0"
      >
        <div id="splat-canvas-wrapper" class="w-full h-full relative flex items-center justify-center touch-pan-y">
        </div>
      </div>

      </div>

      <!-- Pretext Carved Text Canvas: absolutely positioned spans -->
      <div 
        id="pretext-canvas" aria-hidden="true"
        class="absolute inset-0 z-[3] pointer-events-none" 
        style="font-family: 'Apple Garamond Custom', 'Apple Garamond', 'EB Garamond', Garamond, serif; font-size: 20px; color: #d4d4d4; letter-spacing: 0.01em;"
      >
      </div>

      <div class="sr-only">
        {(["en", "it"] as const).map(language => (
          <div class={`lang-${language}`}>
            <p>{bioText[language][0]}</p>
            <div class="hidden md:block">
              {bioText[language].slice(1).map(paragraph => <p>{paragraph}</p>)}
            </div>
          </div>
        ))}
      </div>
    </div>

    <details class="mobile-bio absolute inset-0 pointer-events-none md:hidden">
      <summary aria-controls="mobile-bio-continuation">
        <span class="bio-open-label">
          <span class="lang-en">read more</span>
          <span class="lang-it">leggi di più</span>
        </span>
        <span class="bio-close-label">
          <span class="lang-en">read less</span>
          <span class="lang-it">leggi meno</span>
        </span>
      </summary>
      <div id="mobile-bio-continuation" class="sr-only">
        {(["en", "it"] as const).map(language => (
          <div class={`lang-${language}`}>
            {bioText[language].slice(1).map(paragraph => <p>{paragraph}</p>)}
          </div>
        ))}
      </div>
      <button type="button" class="bio-read-less">
        <span class="lang-en">read less</span>
        <span class="lang-it">leggi meno</span>
      </button>
    </details>
    </div>

    <!-- Exhibitions & Education Section (Straight border-t line, rounded-none) -->
    <div class="grid gap-8 md:gap-12 border-t border-neutral-700 pt-4 md:pt-6 md:grid-cols-2 w-full max-w-4xl text-left z-10 bg-neutral-900/40 backdrop-blur-sm p-4 md:p-6 rounded-none">
      <section>
        <h2 class="lang-en mb-4 text-2xl md:text-3xl font-semibold text-neutral-50" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">Exhibitions</h2>
        <h2 class="lang-it mb-4 text-2xl md:text-3xl font-semibold text-neutral-50" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">Mostre ed Esposizioni</h2>
        
        <ul class="lang-en list-inside list-disc text-base md:text-lg leading-7 md:leading-8 text-neutral-400">
          <li>
            2026 <a href="https://www.cityopenmuseum.com/la-fura-dels-baus/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-white transition-colors">Codice Umano</a> (La Fura dels Baus x Accademia di Belle Arti di Carrara). ex Ceramica Vaccari, Santo Stefano Magra
          </li>
          <li>
            2026 <a href="https://www.cityopenmuseum.com/last-gesture-premiazione/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-white transition-colors">Last Gesture Festival</a> — Winner of Audience Award for "The Innovation Dilemma". Accademia di Belle Arti di Carrara
          </li>
          <li>
            2025-26 <a href="https://accademiacarrara.it/extra-bold-festival-di-sperimentazione-visiva/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-white transition-colors">EXTRABOLD Festival</a> Live Media. City Open Museum Carrara
          </li>
          <li>2025 Annual Exhibition. Academy of Fine Arts Carrara</li>
        </ul>

        <ul class="lang-it list-inside list-disc text-base md:text-lg leading-7 md:leading-8 text-neutral-400">
          <li>
            2026 <a href="https://www.cityopenmuseum.com/la-fura-dels-baus/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-white transition-colors">Codice Umano</a> (La Fura dels Baus x Accademia di Belle Arti di Carrara). ex Ceramica Vaccari, Santo Stefano Magra
          </li>
          <li>
            2026 <a href="https://www.cityopenmuseum.com/last-gesture-premiazione/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-white transition-colors">Last Gesture Festival</a> — Vincitore del Premio del Pubblico per "The Innovation Dilemma". Accademia di Belle Arti di Carrara
          </li>
          <li>
            2025-26 <a href="https://accademiacarrara.it/extra-bold-festival-di-sperimentazione-visiva/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-white transition-colors">EXTRABOLD Festival</a> Live Media. City Open Museum Carrara
          </li>
          <li>2025 Esposizione Annuale. Accademia di Belle Arti di Carrara</li>
        </ul>
      </section>

      <section>
        <h2 class="lang-en mb-4 text-2xl md:text-3xl font-semibold text-neutral-50" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">Education</h2>
        <h2 class="lang-it mb-4 text-2xl md:text-3xl font-semibold text-neutral-50" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">Formazione</h2>
        
        <ul class="lang-en list-inside list-disc text-base md:text-lg leading-7 md:leading-8 text-neutral-400">
          <li>Multimedia Arts High School, Viareggio</li>
          <li>Academy of Fine Arts, Carrara</li>
        </ul>

        <ul class="lang-it list-inside list-disc text-base md:text-lg leading-7 md:leading-8 text-neutral-400">
          <li>Liceo Artistico Multimediale, Viareggio</li>
          <li>Accademia di Belle Arti, Carrara</li>
        </ul>
      </section>
    </div>

  </section>

  <style>
    :global(html:has(.about-introduction)) {
      scrollbar-gutter: stable;
    }

    .about-introduction {
      overflow-anchor: none;
    }

    .mobile-bio summary {
      display: inline-grid;
      position: absolute;
      top: var(--bio-toggle-y, 0px);
      left: var(--bio-toggle-x, 12px);
      z-index: 4;
      width: max-content;
      min-height: 44px;
      padding-block: 7px;
      color: #fff;
      font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;
      font-size: 0.875rem;
      line-height: 30px;
      white-space: nowrap;
      cursor: pointer;
      pointer-events: auto;
      list-style: none;
    }

    .bio-read-less {
      position: absolute;
      top: var(--bio-end-y, 0px);
      left: var(--bio-end-x, 12px);
      z-index: 4;
      min-height: 44px;
      padding: 7px 0;
      border: 0;
      background: transparent;
      color: #fff;
      font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;
      font-size: 0.875rem;
      line-height: 30px;
      white-space: nowrap;
      cursor: pointer;
      pointer-events: auto;
    }

    .mobile-bio summary,
    .bio-read-less {
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-kerning: normal;
      text-shadow: 0 0 8px rgb(255 255 255 / 35%);
    }

    .mobile-bio summary:hover,
    .bio-read-less:hover {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }

    .mobile-bio summary::-webkit-details-marker {
      display: none;
    }

    .mobile-bio summary:focus-visible,
    .bio-read-less:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 4px;
    }

    .mobile-bio .bio-open-label,
    .mobile-bio .bio-close-label {
      grid-area: 1 / 1;
    }

    .mobile-bio .bio-close-label,
    .mobile-bio[open] .bio-open-label {
      visibility: hidden;
    }

    .mobile-bio[open] .bio-close-label {
      visibility: visible;
    }

  </style>

  <script>
    import * as pc from 'playcanvas';
    import { prepareWithSegments, layoutNextLine } from '@chenglou/pretext';
    import { bindMobileReflow } from '../utils/about-scroll';
    import { bioText } from '../data/about';



    let app = null;
    let headEntity = null;
    let isInitialized = false;

    // ---- Silhouette sampling state ----
    let silhouetteMap = new Map();
    let samplingCanvas = null;
    let samplingCtx = null;

    // ---- Window Listener Handles for Clean Teardown ----
    let onMouseMove = null;
    let onMouseUp = null;
    let onTouchEnd = null;
    let onTouchCancel = null;
    let onResize = null;
    let stopScrollReflow: (() => void) | null = null;
    let modelVisibilityObserver: IntersectionObserver | null = null;
    let modelVisible = true;

    function keepMobileModelRendering() {
      return window.innerWidth < 768 && modelVisible;
    }

    function cleanupAboutPage() {
      stopScrollReflow?.();
      stopScrollReflow = null;
      modelVisibilityObserver?.disconnect();
      modelVisibilityObserver = null;
      modelVisible = true;
      if (app) {
        try {
          app.autoRender = false;
          app.render = () => {};
          app.update = () => {};
          app.off();
          app.destroy();
        } catch(e) {}
        app = null;
      }
      headEntity = null;
      isInitialized = false;
      samplingCanvas = null;
      samplingCtx = null;
      layoutCacheValid = false;

      if (onMouseMove) { window.removeEventListener('mousemove', onMouseMove); onMouseMove = null; }
      if (onMouseUp) { window.removeEventListener('mouseup', onMouseUp); onMouseUp = null; }
      if (onTouchEnd) { window.removeEventListener('touchend', onTouchEnd); onTouchEnd = null; }
      if (onTouchCancel) { window.removeEventListener('touchcancel', onTouchCancel); onTouchCancel = null; }
      if (onResize) { window.removeEventListener('resize', onResize); onResize = null; }
    }

    function initAboutPage() {
      const disclosure = document.querySelector<HTMLDetailsElement>('.mobile-bio');
      if (disclosure) disclosure.ontoggle = () => {
        maxObservedHeroHeight = 0;
        renderPretextLayout();
      };
      document.querySelectorAll<HTMLButtonElement>('.bio-read-less').forEach(button => {
        button.onclick = () => {
          const disclosure = button.closest('details');
          if (!disclosure) return;
          disclosure.open = false;
          maxObservedHeroHeight = 0;
          renderPretextLayout();
          disclosure.querySelector('summary')?.focus();
        };
      });

      const wrapper = document.getElementById('splat-canvas-wrapper');
      if (!wrapper) return;

      if (!wrapper.querySelector('canvas') || !app) {
        cleanupAboutPage();
      }

      const isMobile = window.innerWidth < 768;
      const splatScale = 4.05;

      if (!isInitialized) {
        try {
          wrapper.innerHTML = '';
          const canvas = document.createElement('canvas');
          canvas.style.cssText = 'width:100%;height:100%;display:block;';
          wrapper.appendChild(canvas);

          // Initialize PlayCanvas Application (before syncCanvasSize so app exists)
          app = new pc.Application(canvas, {
            mouse: new pc.Mouse(canvas),
            touch: new pc.Touch(canvas),
            graphicsDeviceOptions: {
              alpha: true,
              antialias: false,
              preserveDrawingBuffer: true, // Enables canvas pixel sampling for Pretext carving & hit testing
              powerPreference: 'default'
            }
          });
          app.systems.gsplat.on('frame:request', () => {
            if (app) app.renderNextFrame = true;
          });
          // Mobile sticky compositing needs a live WebGL layer. Pause it offscreen.
          modelVisibilityObserver = new IntersectionObserver(([entry]) => {
            modelVisible = entry.isIntersecting;
            if (app && window.innerWidth < 768) {
              app.autoRender = modelVisible;
            }
          });
          modelVisibilityObserver.observe(document.getElementById('about-hero') || wrapper);

          // Camera (70mm FOV portrait perspective)
          const cameraEntity = new pc.Entity('Camera');
          cameraEntity.addComponent('camera', {
            fov: 28,
            horizontalFov: false, // false = vertical FOV (portrait 70mm equivalent)
            clearColor: new pc.Color(0, 0, 0, 0)
          });
          app.root.addChild(cameraEntity);

          // Head Entity for SOG Splat Model
          headEntity = new pc.Entity('SOGHead');
          app.root.addChild(headEntity);

          app.setCanvasFillMode(pc.FILLMODE_NONE);
          app.setCanvasResolution(pc.RESOLUTION_FIXED, 1, 1);
          app.start();

          // Sync canvas pixel resolution to wrapper display size (call AFTER app.start())
          const syncCanvasSize = () => {
            // Bound GPU fill rate on high-density phone screens.
            const dpr = Math.min(window.devicePixelRatio || 1, window.innerWidth < 768 ? 1.5 : 2);
            const w = Math.round(wrapper.offsetWidth * dpr);
            const h = Math.round(wrapper.offsetHeight * dpr);
            app.setCanvasResolution(pc.RESOLUTION_FIXED, w, h);
            updateLayoutCache();
          };
          syncCanvasSize();

          // SuperSplat Orbit Camera System state
          const focalPoint = new pc.Vec3(0, -0.04, 0);
          const distance = 2.2;
          let azim = isMobile ? -57.7 : -60.9; // Mobile default: -57.7°, Desktop default: -60.9°
          let elev = isMobile ? -35.0 : -9.4;  // Mobile default: -35.0°, Desktop default: -9.4°
          const minElev = -35;
          const maxElev = 35;

          // Expose 'rot' helper in browser console: typing `rot` prints & returns current angles
          try {
            Object.defineProperty(window, 'rot', {
              get: () => {
                const str = `azim: ${azim.toFixed(1)}, elev: ${elev.toFixed(1)}`;
                console.log(str);
                return str;
              },
              configurable: true
            });
          } catch (e) {}

          const forwardVec = new pc.Vec3();
          const camPos = new pc.Vec3();

          // Exact SuperSplat forward vector calculation
          const calcForwardVec = (result, azimDeg, elevDeg) => {
            const ex = elevDeg * pc.math.DEG_TO_RAD;
            const ey = azimDeg * pc.math.DEG_TO_RAD;
            const s1 = Math.sin(-ex);
            const c1 = Math.cos(-ex);
            const s2 = Math.sin(-ey);
            const c2 = Math.cos(-ey);
            result.set(-c1 * s2, s1, c1 * c2);
          };

          const updateCameraOrbit = () => {
            calcForwardVec(forwardVec, azim, elev);
            camPos.copy(focalPoint).add(forwardVec.clone().mulScalar(distance));
            cameraEntity.setPosition(camPos);
            cameraEntity.lookAt(focalPoint); // Standard right-handed camera orientation (up = +Y)
          };

          // Apply initial camera position
          updateCameraOrbit();

          // Progressive 3-Tier Streaming LOD System:
          // 1. Instant Ultra-Low LOD (lod_ultra_low.sog, ~41KB) for <15ms instant render & Pretext carving
          // 2. Medium LOD (lod_low.sog, 756KB) for smooth intermediate fidelity
          // 3. Full High-Res LOD (splat_39196.sog, 10.3MB) for maximum visual clarity
          const ultraLowAsset = new pc.Asset('headUltraLowSog', 'gsplat', {
            url: '/models/lod_ultra_low.sog',
            filename: 'lod_ultra_low.sog'
          });
          const lowAsset = new pc.Asset('headLowSog', 'gsplat', {
            url: '/models/lod_low.sog',
            filename: 'lod_low.sog'
          });
          const highAsset = new pc.Asset('headHighSog', 'gsplat', {
            url: '/models/splat_39196.sog',
            filename: 'splat_39196.sog'
          });

          app.assets.add(ultraLowAsset);
          app.assets.add(lowAsset);
          app.assets.add(highAsset);

          let currentLodTier = 0; // 0 = none, 1 = ultra-low, 2 = low, 3 = high

          // Start initial reflow loop helper
          const startReflowLoop = () => {
            app.autoRender = true;
            updateLayoutCache();
            let sampleCounter = 0;
            const reflow = () => {
              sampleSilhouette();
              renderPretextLayout();
              sampleCounter++;
              if (sampleCounter < 6) {
                requestAnimationFrame(reflow);
              } else if (!isDragging && app) {
                app.autoRender = keepMobileModelRendering();
              }
            };
            requestAnimationFrame(reflow);
          };

          // Step 1: Instant ULTRA-LOW LOD load (~41KB)
          ultraLowAsset.on('load', () => {
            if (currentLodTier < 1) {
              currentLodTier = 1;
              if (!headEntity.gsplat) {
                headEntity.addComponent('gsplat', { asset: ultraLowAsset });
              } else {
                headEntity.gsplat.asset = ultraLowAsset;
              }
              headEntity.setLocalPosition(0, -0.04, 0);
              headEntity.setLocalEulerAngles(0, 0, 180);
              headEntity.setLocalScale(splatScale, splatScale, splatScale);

              startReflowLoop();
            }
            // Stream medium LOD
            app.assets.load(lowAsset);
          });

          // Step 2: Stream Medium LOD (~756KB)
          lowAsset.on('load', () => {
            if (currentLodTier < 2) {
              currentLodTier = 2;
              if (headEntity.gsplat) {
                headEntity.gsplat.asset = lowAsset;
              } else {
                headEntity.addComponent('gsplat', { asset: lowAsset });
                headEntity.setLocalPosition(0, -0.04, 0);
                headEntity.setLocalEulerAngles(0, 0, 180);
                headEntity.setLocalScale(splatScale, splatScale, splatScale);
              }
              startReflowLoop();
            }
            // Stream high LOD
            app.assets.load(highAsset);
          });

          // Step 3: Stream High LOD (~10.3MB)
          highAsset.on('load', () => {
            currentLodTier = 3;
            if (headEntity.gsplat) {
              headEntity.gsplat.asset = highAsset;
            } else {
              headEntity.addComponent('gsplat', { asset: highAsset });
              headEntity.setLocalPosition(0, -0.04, 0);
              headEntity.setLocalEulerAngles(0, 0, 180);
              headEntity.setLocalScale(splatScale, splatScale, splatScale);
            }
            startReflowLoop();
          });

          let isReflowScheduled = false;
          const scheduleReflow = () => {
            if (!isReflowScheduled) {
              isReflowScheduled = true;
              requestAnimationFrame(() => {
                isReflowScheduled = false;
                sampleSilhouette();
                renderPretextLayout();
              });
            }
          };

          // Kickoff LOD 0 (Ultra Low 41KB)
          app.assets.load(ultraLowAsset);

          // Interactive Drag Rotation — Pixel-Perfect Hitbox Detection
          let isDragging = false;
          let lastX = 0;
          let lastY = 0;

          const isPixelHit = (clientX, clientY) => {
            const wrapper = document.getElementById('splat-canvas-wrapper');
            if (!wrapper) return false;
            const glCanvas = wrapper.querySelector('canvas');
            if (!glCanvas) return false;

            const rect = glCanvas.getBoundingClientRect();
            const x = clientX - rect.left;
            const y = clientY - rect.top;

            if (x < 0 || x > rect.width || y < 0 || y > rect.height) return false;

            const sampleW = 160;
            const sampleH = Math.max(1, Math.round(160 * (rect.height / rect.width)));
            const sampleX = Math.floor((x / rect.width) * sampleW);
            const sampleY = Math.floor((y / rect.height) * sampleH);

            if (!samplingCtx || sampleX < 0 || sampleX >= sampleW || sampleY < 0 || sampleY >= sampleH) return false;

            try {
              const pixel = samplingCtx.getImageData(sampleX, sampleY, 1, 1).data;
              return (pixel[3] > 10 || pixel[0] > 15 || pixel[1] > 15 || pixel[2] > 15);
            } catch (e) {
              return true;
            }
          };

          const startDrag = (x, y) => {
            updateLayoutCache(); // Ensure fresh layout rects at drag start
            if (!isPixelHit(x, y)) return false;
            isDragging = true;
            lastX = x;
            lastY = y;
            app.autoRender = true; // Resume GPU rendering during drag
            return true;
          };

          const moveDrag = (x, y) => {
            if (isDragging) {
              const dx = x - lastX;
              const dy = y - lastY;
              lastX = x;
              lastY = y;

              azim -= dx * 0.45;
              elev = Math.max(minElev, Math.min(maxElev, elev - dy * 0.45));

              updateCameraOrbit();
              scheduleReflow();
            }
          };

          const endDrag = () => {
            if (!isDragging) return;
            isDragging = false;
            app.autoRender = true;
            let settle = 0;
            const settleFn = () => {
              sampleSilhouette();
              renderPretextLayout();
              settle++;
              if (settle < 4) {
                requestAnimationFrame(settleFn);
              } else {
                if (app) app.autoRender = keepMobileModelRendering();
              }
            };
            requestAnimationFrame(settleFn);
          };

          canvas.addEventListener('mousedown', (e) => {
            if (startDrag(e.clientX, e.clientY)) {
              canvas.style.cursor = 'grabbing';
            }
          });

          canvas.addEventListener('mousemove', (e) => {
            if (!isDragging) {
              const rect = e.target.getBoundingClientRect();
              const inBounds = e.clientX >= rect.left && e.clientX <= rect.right &&
                               e.clientY >= rect.top  && e.clientY <= rect.bottom;
              canvas.style.cursor = inBounds ? 'grab' : 'default';
            }
          });

          canvas.addEventListener('touchstart', (e) => {
            if (e.touches.length > 0) {
              startDrag(e.touches[0].clientX, e.touches[0].clientY);
            }
          }, { passive: true });

          canvas.addEventListener('touchmove', (e) => {
            if (isDragging && e.touches.length > 0) {
              if (e.cancelable) e.preventDefault();
              moveDrag(e.touches[0].clientX, e.touches[0].clientY);
            }
          }, { passive: false });

          onMouseMove = (e) => moveDrag(e.clientX, e.clientY);
          onMouseUp = () => {
            endDrag();
            if (canvas) canvas.style.cursor = 'default';
          };
          onTouchEnd = endDrag;
          onTouchCancel = endDrag;

          window.addEventListener('mousemove', onMouseMove);
          window.addEventListener('mouseup', onMouseUp);
          window.addEventListener('touchend', onTouchEnd);
          window.addEventListener('touchcancel', onTouchCancel);

          let resizeReflowTimer = null;
          onResize = () => {
            invalidateLayoutCache();
            syncCanvasSize();

            if (resizeReflowTimer !== null) {
              cancelAnimationFrame(resizeReflowTimer);
            }

            resizeReflowTimer = requestAnimationFrame(() => {
              resizeReflowTimer = requestAnimationFrame(() => {
                resizeReflowTimer = null;
                if (app) app.autoRender = true;
                let n = 0;
                const resizeReflow = () => {
                  sampleSilhouette();
                  renderPretextLayout();
                  n++;
                  if (n < 4) requestAnimationFrame(resizeReflow);
                  else if (!isDragging && app) app.autoRender = keepMobileModelRendering();
                };
                resizeReflow();
              });
            });
          };
          window.addEventListener('resize', onResize);

          isInitialized = true;
        } catch (e) {
          console.error("Failed to init PlayCanvas:", e);
        }
      }

      if (!stopScrollReflow) stopScrollReflow = bindMobileReflow(renderPretextLayout);
      renderPretextLayout();
    }

    let rawSilhouetteRows = [];

    /**
     * Sample actual rendered WebGL canvas pixels to extract true silhouette.
     * Only executed during 3D model rotation or window resize (never during scroll!).
     */
    function sampleSilhouette() {
      if (!layoutCacheValid) {
        updateLayoutCache();
      }
      const wrapper = document.getElementById('splat-canvas-wrapper');
      if (!wrapper) return;

      const glCanvas = wrapper.querySelector('canvas');
      if (!glCanvas) return;

      const glW = glCanvas.width;
      const glH = glCanvas.height;
      if (glW === 0 || glH === 0) return;

      // Ultra-fast 160px thumbnail canvas for pixel readback
      const sampleW = 160;
      const sampleH = Math.max(1, Math.round(160 * (glH / glW)));

      if (!samplingCanvas) {
        samplingCanvas = document.createElement('canvas');
        samplingCtx = samplingCanvas.getContext('2d', { willReadFrequently: true });
      }
      samplingCanvas.width = sampleW;
      samplingCanvas.height = sampleH;
      if (!samplingCtx) return;

      samplingCtx.clearRect(0, 0, sampleW, sampleH);
      samplingCtx.drawImage(glCanvas, 0, 0, sampleW, sampleH);

      const imageData = samplingCtx.getImageData(0, 0, sampleW, sampleH);
      const data = imageData.data;

      rawSilhouetteRows = [];

      for (let cy = 0; cy < sampleH; cy++) {
        let leftMost = -1;
        let rightMost = -1;
        const rowStart = cy * sampleW * 4;

        for (let x = 0; x < sampleW; x++) {
          const idx = rowStart + x * 4;
          const r = data[idx];
          const g = data[idx + 1];
          const b = data[idx + 2];
          const a = data[idx + 3];
          if (a > 0 || r > 2 || g > 2 || b > 2) {
            if (leftMost === -1 || x < leftMost) leftMost = x;
            if (x > rightMost) rightMost = x;
          }
        }

        if (leftMost !== -1) {
          rawSilhouetteRows.push({
            yRatio: cy / sampleH,
            leftRatio: leftMost / sampleW,
            rightRatio: rightMost / sampleW
          });
        }
      }
    }

    // Cached prepared segments (invalidated on language change or resize)
    let cachedPrepared = new Map();
    let cachedLang = '';
    let cachedFontSpec = '';
    let maxObservedHeroHeight = 0;
    let textMeasureContext: CanvasRenderingContext2D | null = null;

    // Cached layout rect (updated in sampleSilhouette, used in renderPretextLayout without getBoundingClientRect)
    let cachedGlOffsetX = 0;
    let cachedGlOffsetY = 0;
    let cachedGlW = 0;
    let cachedGlH = 0;
    let cachedHeroW = 0;
    let cachedHeroH = 0;
    let cachedHeroDocTop = 0;
    let cachedIsMobile = false;
    let layoutCacheValid = false;

    function invalidateLayoutCache() {
      layoutCacheValid = false;
      maxObservedHeroHeight = 0;
      if (cachedPrepared) cachedPrepared.clear();
      if (cachedFullWidthLines) cachedFullWidthLines.clear();
      cachedLang = '';
      cachedFontSpec = '';
    }

    function updateLayoutCache() {
      const hero = document.getElementById('about-hero');
      const wrapper = document.getElementById('splat-canvas-wrapper');
      if (!hero || !wrapper) return;
      const glCanvas = wrapper.querySelector('canvas');
      if (!glCanvas) return;

      const heroRect = hero.getBoundingClientRect();
      const glRect = glCanvas.getBoundingClientRect();
      cachedGlOffsetX = glRect.left - heroRect.left;
      cachedGlOffsetY = glRect.top - heroRect.top;
      cachedGlW = glRect.width;
      cachedGlH = glRect.height;
      cachedHeroW = hero.offsetWidth;
      cachedHeroH = hero.offsetHeight;
      cachedHeroDocTop = heroRect.top + window.scrollY;
      cachedIsMobile = window.innerWidth < 768;
      layoutCacheValid = true;
    }

    // Cached full-width lines for non-intersecting mobile paragraphs (key: text_width)
    let cachedFullWidthLines = new Map();

    function getFullWidthLines(text, width, prepared, fontSpecKey) {
      const key = fontSpecKey + '_' + width + '_' + text;
      if (!cachedFullWidthLines.has(key)) {
        let cursor = { segmentIndex: 0, graphemeIndex: 0 };
        const lines = [];
        while (true) {
          const line = layoutNextLine(prepared, cursor, width);
          if (!line) break;
          lines.push(line.text);
          cursor = line.end;
        }
        cachedFullWidthLines.set(key, lines);
      }
      return cachedFullWidthLines.get(key);
    }

    /**
     * Renders text into absolutely-positioned spans inside #pretext-canvas.
     * Uses span diffing (no innerHTML = '') for zero DOM churn on scroll/drag.
     */
    function renderPretextLayout() {
      const canvas = document.getElementById('pretext-canvas');
      const hero = document.getElementById('about-hero');
      if (!canvas || !hero) return;

      if (!layoutCacheValid) {
        updateLayoutCache();
      }

      const currentLang = document.documentElement.getAttribute('data-lang') || 'en';
      const biography = bioText[currentLang] || bioText.en;
      const disclosure = document.querySelector<HTMLDetailsElement>('.mobile-bio');
      const summary = disclosure?.querySelector('summary');
      const endButton = disclosure?.querySelector<HTMLButtonElement>('.bio-read-less');
      const expanded = Boolean(disclosure?.open);
      const paragraphs = cachedIsMobile && !expanded ? biography.slice(0, 1) : biography;

      const isMobile = cachedIsMobile;
      const fontSize = 20;
      const lineHeight = isMobile ? 30 : 32;
      const fontSpec = `${fontSize}px 'Apple Garamond Custom', 'Apple Garamond', 'EB Garamond', Garamond, serif`;

      // Re-prepare segments only if language or font changed
      if (currentLang !== cachedLang || fontSpec !== cachedFontSpec) {
        cachedPrepared = new Map();
        cachedFullWidthLines = new Map();
        cachedLang = currentLang;
        cachedFontSpec = fontSpec;
        maxObservedHeroHeight = 0;
      }

      const getPrep = (text) => {
        if (!cachedPrepared.has(text)) {
          cachedPrepared.set(text, prepareWithSegments(text, fontSpec));
        }
        return cachedPrepared.get(text);
      };

      canvas.style.fontSize = fontSize + 'px';

      const heroW = cachedHeroW || hero.offsetWidth;
      const heroH = cachedHeroH || hero.offsetHeight;
      const cx = heroW / 2;

      const margin = isMobile ? 12 : 20;
      const colGap = 30;
      const padding = isMobile ? 22 : 46;

      // On mobile with sticky container, get current live vertical offset of 3D canvas inside hero
      let liveGlOffsetY = cachedGlOffsetY;
      let liveGlOffsetX = cachedGlOffsetX;
      let liveGlW = cachedGlW;
      let liveGlH = cachedGlH;

      if (isMobile) {
        const wrapper = document.getElementById('splat-canvas-wrapper');
        const glCanvas = wrapper ? wrapper.querySelector('canvas') : null;
        if (glCanvas) {
          const heroRect = hero.getBoundingClientRect();
          const glRect = glCanvas.getBoundingClientRect();
          liveGlOffsetY = glRect.top - heroRect.top;
          liveGlOffsetX = glRect.left - heroRect.left;
          liveGlW = glRect.width;
          liveGlH = glRect.height;
        } else {
          const heroTop = hero.getBoundingClientRect().top;
          liveGlOffsetY = Math.max(0, 140 - heroTop);
          liveGlW = cachedGlW || 300;
          liveGlH = cachedGlH || 500;
        }
      }

      // Rebuild silhouetteMap from cached ratios + live rect
      silhouetteMap = new Map();
      let silMinY = Infinity;
      let silMaxY = -Infinity;

      if (rawSilhouetteRows.length > 0) {
        for (const row of rawSilhouetteRows) {
          const heroY = liveGlOffsetY + row.yRatio * liveGlH;
          const snappedY = Math.round(heroY / lineHeight) * lineHeight;
          const heroLeft = liveGlOffsetX + row.leftRatio * liveGlW - padding;
          const heroRight = liveGlOffsetX + row.rightRatio * liveGlW + padding;

          if (!silhouetteMap.has(snappedY)) {
            silhouetteMap.set(snappedY, [heroLeft, heroRight]);
          } else {
            const cur = silhouetteMap.get(snappedY);
            cur[0] = Math.min(cur[0], heroLeft);
            cur[1] = Math.max(cur[1], heroRight);
          }
          silMinY = Math.min(silMinY, heroY);
          silMaxY = Math.max(silMaxY, heroY);
        }
      }

      function getMobileSilhouetteRight(y) {
        if (silMinY === Infinity || y + lineHeight < silMinY - padding || y > silMaxY + padding) {
          return null;
        }
        // Exclude the whole line box, including the top/bottom padding of the model.
        let right = null;
        const firstRow = Math.round((y - padding) / lineHeight) * lineHeight;
        const lastRow = Math.round((y + lineHeight + padding) / lineHeight) * lineHeight;
        for (let rowY = firstRow; rowY <= lastRow; rowY += lineHeight) {
          const bounds = silhouetteMap.get(rowY);
          if (bounds) right = Math.max(right ?? -Infinity, bounds[1]);
        }
        return right;
      }

      function getColumnEdges(y) {
        const snappedY = Math.round(y / lineHeight) * lineHeight;
        if (silhouetteMap.has(snappedY)) {
          const [silLeft, silRight] = silhouetteMap.get(snappedY);
          return [
            Math.min(silLeft, cx - colGap / 2),
            Math.max(silRight, cx + colGap / 2)
          ];
        }
        return [cx - colGap / 2, cx + colGap / 2];
      }

      // Span diffing: collect new line data, update DOM in-place to avoid reflow
      const newLines = [];

      function collectLine(text, x, y, align = 'left') {
        newLines.push({ text, x, y, align, heroW });
      }

      canvas.style.clipPath = '';
      // Align the introduction with the portrait, rather than filling the space above it.
      const restOffsetY = document.querySelector<HTMLElement>('.splat-track')?.offsetTop ?? -64;
      // The text origin stays in document space while the silhouette follows the sticky canvas.
      const restPortraitTop = rawSilhouetteRows.length ? restOffsetY + rawSilhouetteRows[0].yRatio * liveGlH : 12;
      const restPortraitBottom = rawSilhouetteRows.length
        ? restOffsetY + rawSilhouetteRows[rawSilhouetteRows.length - 1].yRatio * liveGlH + 12
        : restOffsetY + liveGlH;
      const startY = isMobile ? Math.max(24, restPortraitTop + 12) : 20;
      let introControl = null;
      let endControl = null;

      if (!textMeasureContext) textMeasureContext = document.createElement('canvas').getContext('2d');
      if (textMeasureContext) textMeasureContext.font = fontSpec;
      function placeControl(line, width) {
        const textWidth = (textMeasureContext?.measureText(line.text).width ?? 0) + line.text.length * 0.2;
        let x = line.x + textWidth + 8;
        let y = line.y;
        if (x + width > heroW - margin) {
          do {
            y += lineHeight;
            x = Math.max(margin, getMobileSilhouetteRight(y) ?? margin);
          } while (x + width > heroW - margin);
        }
        return { x, y };
      }

      if (isMobile) {
        let y = startY;
        const fullW = heroW - margin * 2;

        paragraphs.forEach((text, paragraphIndex) => {
          const prepared = getPrep(text);
          const fullLines = getFullWidthLines(text, fullW, prepared, fontSpec);
          const paraH = fullLines.length * lineHeight;

          // Fast path: if paragraph is completely above or below head bounds, use cached fullLines directly
          if (y + paraH < silMinY - padding || y > silMaxY + padding) {
            for (let i = 0; i < fullLines.length; i++) {
              collectLine(fullLines[i], margin, y, 'left');
              y += lineHeight;
            }
          } else {
            let cursor = { segmentIndex: 0, graphemeIndex: 0 };
            while (true) {
              let lineX = margin;
              let availW = fullW;
              const silRight = getMobileSilhouetteRight(y);
              if (silRight !== null) {
                lineX = Math.max(margin, silRight);
                availW = heroW - margin - lineX;
                if (availW < fontSize * 2) {
                  y += lineHeight;
                  continue;
                }
              }
              const line = layoutNextLine(prepared, cursor, availW);
              if (!line) break;
              collectLine(line.text, lineX, y, 'left');
              cursor = line.end;
              y += lineHeight;
            }
          }
          const lastLine = newLines[newLines.length - 1];
          if (paragraphIndex === 0 && summary && lastLine) {
            introControl = placeControl(lastLine, summary.offsetWidth);
            y = Math.max(y, introControl.y + lineHeight);
          }
          if (expanded && paragraphIndex === paragraphs.length - 1 && endButton && lastLine) {
            endControl = placeControl(lastLine, endButton.offsetWidth);
            y = Math.max(y, endControl.y + lineHeight);
          }
          y += lineHeight;
        });

      } else {
        let yLeft = startY;
        [paragraphs[0], paragraphs[1]].forEach((text) => {
          const prepared = getPrep(text);
          let cursor = { segmentIndex: 0, graphemeIndex: 0 };
          while (true) {
            const [leftEdge] = getColumnEdges(yLeft + lineHeight / 2);
            const availW = Math.max(40, leftEdge - margin);
            const line = layoutNextLine(prepared, cursor, availW);
            if (!line) break;
            collectLine(line.text, leftEdge, yLeft, 'right');
            cursor = line.end;
            yLeft += lineHeight;
          }
          yLeft += lineHeight;
        });

        let yRight = startY;
        [paragraphs[2], paragraphs[3]].forEach((text) => {
          const prepared = getPrep(text);
          let cursor = { segmentIndex: 0, graphemeIndex: 0 };
          while (true) {
            const [, rightEdge] = getColumnEdges(yRight + lineHeight / 2);
            const availW = Math.max(40, heroW - margin - rightEdge);
            const line = layoutNextLine(prepared, cursor, availW);
            if (!line) break;
            collectLine(line.text, rightEdge, yRight, 'left');
            cursor = line.end;
            yRight += lineHeight;
          }
          yRight += lineHeight;
        });

        const maxDesktopY = Math.max(yLeft, yRight);
        const currentReqH = Math.max(530, maxDesktopY + 40);
        if (currentReqH > maxObservedHeroHeight) {
          maxObservedHeroHeight = currentReqH;
          hero.style.minHeight = maxObservedHeroHeight + 'px';
        }
      }

      // DOM diffing: reuse existing spans, only update changed ones, add/remove as needed
      const existingSpans = canvas.children;
      const existingCount = existingSpans.length;
      const newCount = newLines.length;

      for (let i = 0; i < newCount; i++) {
        const { text, x, y, align, heroW: hw } = newLines[i];
        let span;

        if (i < existingCount) {
          span = existingSpans[i];
        } else {
          span = document.createElement('span');
          span.style.position = 'absolute';
          span.style.height = lineHeight + 'px';
          span.style.lineHeight = lineHeight + 'px';
          span.style.whiteSpace = 'nowrap';
          span.style.overflow = 'hidden';
          canvas.appendChild(span);
        }

        if (span.textContent !== text) span.textContent = text;
        const topPx = y + 'px';
        if (span.style.top !== topPx) span.style.top = topPx;
        if (align === 'right') {
          const rightPx = (hw - x) + 'px';
          if (span.style.right !== rightPx) span.style.right = rightPx;
          if (span.style.left) span.style.left = '';
          if (span.style.textAlign !== 'right') span.style.textAlign = 'right';
        } else {
          const leftPx = x + 'px';
          if (span.style.left !== leftPx) span.style.left = leftPx;
          if (span.style.right) span.style.right = '';
          if (span.style.textAlign !== 'left') span.style.textAlign = 'left';
        }
      }

      // Both disclosure controls share the same moving exclusion as the text.
      if (isMobile && disclosure && introControl) {
        disclosure.style.setProperty('--bio-toggle-x', introControl.x + 'px');
        disclosure.style.setProperty('--bio-toggle-y', (introControl.y - 7) + 'px');
        if (endControl) {
          disclosure.style.setProperty('--bio-end-x', endControl.x + 'px');
          disclosure.style.setProperty('--bio-end-y', (endControl.y - 7) + 'px');
        }
        const lastLine = newLines[newCount - 1];
        const bottomY = Math.max(lastLine?.y ?? 0, introControl.y, endControl?.y ?? 0);
        const requiredHeight = Math.ceil(Math.max(320, restPortraitBottom, bottomY + lineHeight + 8));
        // Keep the bottom of the page steady as text rewraps during scrolling.
        maxObservedHeroHeight = Math.max(maxObservedHeroHeight, requiredHeight);
        const heightPx = maxObservedHeroHeight + 'px';
        if (hero.style.minHeight !== heightPx) hero.style.minHeight = heightPx;
      }

      // Remove extra spans
      for (let i = existingCount - 1; i >= newCount; i--) {
        canvas.removeChild(existingSpans[i]);
      }
    }

    const triggerReflowAfterTransition = () => {
      invalidateLayoutCache();
      renderPretextLayout();
    };

    const handlePageLoad = () => {
      initAboutPage();
      if (document.fonts) {
        document.fonts.ready.then(triggerReflowAfterTransition);
      }
      requestAnimationFrame(triggerReflowAfterTransition);
      setTimeout(triggerReflowAfterTransition, 100);
      setTimeout(triggerReflowAfterTransition, 300);
    };

    // Init & View Transition cleanup listeners
    document.addEventListener('DOMContentLoaded', handlePageLoad);
    document.addEventListener('astro:page-load', handlePageLoad);
    document.addEventListener('astro:before-swap', cleanupAboutPage);

    // Language toggle
    const observer = new MutationObserver((mutations) => {
      for (const m of mutations) {
        if (m.attributeName === 'data-lang') {
          renderPretextLayout();
          break;
        }
      }
    });
    observer.observe(document.documentElement, { attributes: true });
  </script>
</BaseLayout>
