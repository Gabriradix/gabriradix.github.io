  "AF85FC86-BFD8-4F69-AB02-9584586EB2F6.png": "Visualizzazione di definizioni in lingua inglese con contrasto bianco su sfondo nero",
  "B2672E30-3055-4F34-92F4-4163FB2CC586.png": "Interfaccia utente con focus su una definizione che descrive l'artista come un tramite emotivo",
  "D9BF978C-1A56-4357-923F-DC6312F30E61.png": "Composizione visiva di risposte brevi e d'impatto inserite nel database",
  "F01D18EE-AFBA-458A-BF82-D77CFCAFAF00.png": "Schermata di conferma dopo l'invio della propria definizione personalizzata",
  "F6C76D9D-85A5-4D06-BA61-4207C459A3EA.png": "Archivio storico delle risposte visualizzato in ordine cronologico con design pulito",
  "IMG_5200.JPG": "Fotografia dello schermo del computer che mostra l'interfaccia dell'opera in un ambiente di lavoro",
  "IMG_5210.JPG": "Visualizzazione del progetto su schermo in modalità schermo intero, evidenziando il contrasto cromatico",
  "IMG_5217.JPG": "Dettaglio dell'installazione con la pagina di benvenuto del sito pronta per l'interazione",
  "IMG_5220.JPG": "Inquadratura ravvicinata del testo della domanda fondamentale 'What's an artist?' visualizzata a schermo",
  "IMG_5221.JPG": "Schermo acceso in studio che mostra l'elenco in tempo reale dei contributi degli utenti",
  "IMG_5226.JPG": "Postazione di lavoro con il sito web aperto e pronto per la compilazione della domanda",
  "IMG_5229.JPG": "Vista angolata dell'installazione digitale con la luce dello schermo che illumina la superficie circostante"
};
---

<BaseLayout title="What's an Artist? - Gabriele Radicello">
  <!-- Hero Section -->
  <section class="relative h-[100svh] md:h-[100dvh] w-full overflow-hidden flex items-center justify-center">
    <img 
      src={getProxyUrl("/progetti/whats-an-artist/copertina.png")} data-src="/progetti/whats-an-artist/copertina.png" 
      alt="Interfaccia web interattiva con la domanda 'What is an artist?' in bianco su sfondo scuro con flussi digitali"
      class="absolute inset-0 w-full h-full object-cover z-0 opacity-50"
    />
    <div class="absolute inset-0 bg-black/60 z-10"></div>
    
    <div class="relative z-20 text-center px-6">
      <h1 
        class="text-5xl md:text-8xl font-normal text-white tracking-tight" 
        style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;"
      >
        What's an Artist?
      </h1>
      <p class="mt-6 text-xl text-neutral-300 font-light max-w-2xl mx-auto">
        What is an artist in the digital era?
      </p>
    </div>
  </section>

  <!-- Content Section -->
  <section class="max-w-4xl mx-auto px-6 py-24 md:py-32 text-neutral-300 text-lg leading-8 text-left">
    
    <div class="mb-16 md:mb-24">
      <h2 class="text-3xl font-normal text-neutral-50 mb-8" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">Concept</h2>
      <div class="grid gap-8">
        <p>
          An interactive web project exploring the artist's identity in the digital era. By posing a simple question to users—"What is an artist?"—the work collects a plurality of definitions, archiving and comparing them.
        </p>
        <p>
          The project becomes a sociological and philosophical investigation into the perception of the creative role in contemporary society, demystifying the figure of the artist and letting the collective outline its boundaries.
        </p>
        <div class="mt-4">
          <a href="https://whatsanartist.github.io/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 px-8 py-3 border border-neutral-700 text-neutral-300 hover:bg-white hover:text-black transition-colors duration-300 font-medium tracking-wide text-sm uppercase">
            Visit the Website
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Gallery Section -->
    <div class="border-t border-neutral-800 pt-16">
      <h2 class="text-3xl font-normal text-neutral-50 mb-12" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">Gallery</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {galleryImages.map((img, i) => (
          <img 
            src={getProxyUrl(`/progetti/whats-an-artist/${img}`)} 
            data-src={`/progetti/whats-an-artist/${img}`} 
            alt={altTexts[img] || `What's an Artist? - Immagine della galleria ${i + 1}`} 
            class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 gallery-img" 
            loading="lazy" 
          />
        ))}
      </div>
    </div>

  </section>
</BaseLayout>
