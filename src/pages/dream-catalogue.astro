---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getProxyUrl } from "../utils/image";
import { projects } from "../data/projects";

const project = projects.find((p) => p.href === "/dream-catalogue");
---

<BaseLayout title="Dream Catalogue - Gabriele Radicello">
  <!-- Hero Section -->
  <section class="relative h-[100svh] md:h-[100dvh] w-full overflow-hidden flex items-center justify-center">
    <img 
      src={getProxyUrl("/progetti/dream-catalogue/cover.png")} 
      data-src="/progetti/dream-catalogue/cover.png"
      alt="Dream Catalogue Cover"
      class="absolute inset-0 w-full h-full object-cover z-0 opacity-30"
    />
    <div class="absolute inset-0 bg-black/70 z-10"></div>
    
    <div class="relative z-20 text-center px-6 max-w-4xl">
      <div class="inline-block px-3 py-1 mb-6 border border-neutral-700 bg-neutral-950/80 text-xs font-mono text-neutral-400 uppercase tracking-widest">
        System Architecture &amp; Data Visualization
      </div>
      <h1 
        class="text-4xl sm:text-6xl md:text-8xl font-semibold text-white tracking-tight break-words" 
        style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;"
      >
        Dream Catalogue
      </h1>
      <p class="mt-4 sm:mt-6 text-base sm:text-xl text-neutral-300 font-light max-w-2xl mx-auto">
        <span class="lang-en">An interactive clinical web archive cataloging dream states through dynamic graph topology and high-density telemetry.</span>
        <span class="lang-it">Un archivio web clinico interattivo che cataloga gli stati di sogno attraverso la topologia dinamica dei grafi e la telemetria ad alta densità.</span>
      </p>
      <div class="mt-6 sm:mt-8 flex justify-center gap-4">
        <button
          id="hero-fullscreen-btn"
          type="button"
          class="inline-flex items-center justify-center gap-2 sm:gap-3 px-6 sm:px-8 py-3 max-w-full border border-neutral-200 bg-white text-black hover:bg-neutral-200 transition-colors duration-300 font-medium tracking-wide text-xs sm:text-sm uppercase cursor-pointer shadow-lg text-center"
        >
          <span class="lang-en">Launch Interactive App</span>
          <span class="lang-it">Lancia App Interattiva</span>
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
          </svg>
        </button>
      </div>
    </div>
  </section>

  <!-- Interactive Live App Section -->
  <section id="app-section" class="w-full bg-black py-8 sm:py-12 border-y border-neutral-800 transition-all duration-500 ease-in-out">
    <div id="app-wrapper" class="max-w-7xl mx-auto px-4 sm:px-6 transition-all duration-500 ease-in-out">
      <!-- Section Header Bar (Inline Mode) -->
      <div id="app-header-bar" class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-4">
        <h2 class="text-xs sm:text-sm font-mono text-neutral-400 uppercase tracking-widest flex items-center gap-2 flex-wrap">
          <span class="w-2 h-2 rounded-full bg-white animate-pulse shrink-0"></span>
          <span class="lang-en">LIVE INTERACTIVE APPLICATION // MAPPA DEI SOGNI</span>
          <span class="lang-it">APPLICAZIONE INTERATTIVA LIVE // MAPPA DEI SOGNI</span>
        </h2>
        <button
          id="fullscreen-btn"
          type="button"
          class="text-xs font-mono text-neutral-300 hover:text-white bg-neutral-900/90 hover:bg-neutral-800 border border-neutral-700 px-3.5 py-1.5 rounded transition-all duration-300 flex items-center gap-2 cursor-pointer shadow-lg shrink-0"
        >
          <span class="lang-en">Open Fullscreen</span>
          <span class="lang-it">Apri a Schermo Intero</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
          </svg>
        </button>
      </div>

      <!-- Iframe Container -->
      <div id="iframe-container" class="w-full h-[65vh] md:h-[75vh] border border-neutral-800 bg-black overflow-hidden rounded-sm relative transition-all duration-500 ease-in-out">
        <iframe
          id="app-iframe"
          src="/progetti/dream-catalogue/index.html"
          title="Dream Catalogue Live Web Application"
          class="w-full h-full border-0 border-none outline-none block"
          style="border:0;outline:none;margin:0;padding:0;"
          allow="autoplay; fullscreen"
        ></iframe>
      </div>
    </div>
  </section>

  <script>
    function setupFullscreenExpander() {
      const heroBtn = document.getElementById("hero-fullscreen-btn");
      const btn = document.getElementById("fullscreen-btn");
      const headerBar = document.getElementById("app-header-bar");
      const section = document.getElementById("app-section");
      const wrapper = document.getElementById("app-wrapper");
      const container = document.getElementById("iframe-container");

      if (!section || !wrapper || !container) return;

      let isFullscreen = false;
      let savedScrollY = 0;

      function toggle(forceFullscreen) {
        if (typeof forceFullscreen === "boolean") {
          isFullscreen = forceFullscreen;
        } else {
          isFullscreen = !isFullscreen;
        }

        if (isFullscreen) {
          savedScrollY = window.scrollY;
          window.scrollTo(0, 0);

          window.postMessage('force-compact-header', '*');

          headerBar?.classList.add("hidden");
          container.classList.remove("border", "border-neutral-800", "rounded-sm");
          container.classList.add("border-0", "border-none", "rounded-none");

          section.classList.add("fixed", "inset-0", "top-0", "left-0", "w-screen", "h-screen", "z-40", "p-0", "m-0", "flex", "flex-col", "bg-black");
          section.classList.remove("w-full", "py-12", "border-y", "border-neutral-800");

          wrapper.classList.remove("max-w-7xl", "px-6");
          wrapper.classList.add("w-full", "h-full", "max-w-none", "flex", "flex-col", "p-0");

          container.classList.remove("h-[65vh]", "md:h-[75vh]");
          container.classList.add("flex-1", "w-full", "h-full");

          document.body.style.overflow = "hidden";
        } else {
          window.postMessage('reset-compact-header', '*');

          headerBar?.classList.remove("hidden");
          container.classList.remove("border-0", "border-none", "rounded-none");
          container.classList.add("border", "border-neutral-800", "rounded-sm");

          section.classList.remove("fixed", "inset-0", "top-0", "left-0", "w-screen", "h-screen", "z-40", "p-0", "m-0", "flex", "flex-col", "bg-black");
          section.classList.add("w-full", "py-12", "border-y", "border-neutral-800");

          wrapper.classList.add("max-w-7xl", "px-6");
          wrapper.classList.remove("w-full", "h-full", "max-w-none", "flex", "flex-col", "p-0");

          container.classList.add("h-[65vh]", "md:h-[75vh]");
          container.classList.remove("flex-1", "w-full", "h-full");

          document.body.style.overflow = "";

          window.scrollTo(0, savedScrollY);
        }
      }

      heroBtn?.addEventListener("click", () => toggle(true));
      btn?.addEventListener("click", () => toggle());

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isFullscreen) {
          toggle(false);
        }
      });
    }

    setupFullscreenExpander();
    document.addEventListener("astro:page-load", setupFullscreenExpander);
  </script>

  <!-- Content & Architecture Section -->
  <section class="max-w-5xl mx-auto px-6 py-24 md:py-32 text-neutral-300 text-lg leading-8 text-left">
    
    <!-- Concept & Aesthetic Language -->
    <div class="mb-24">
      <h2 class="text-3xl font-semibold text-neutral-50 mb-8" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">
        <span class="lang-en">Concept &amp; Visual Language</span>
        <span class="lang-it">Concept &amp; Linguaggio Visivo</span>
      </h2>
      <div class="grid gap-8">
        <p>
          <span class="lang-en"><strong>Dream Catalogue</strong> (Mappa dei Sogni) is an interactive net-art archive that investigates the clinical, aseptic, and mathematical cataloging of human subconscious dream material.</span>
          <span class="lang-it"><strong>Dream Catalogue</strong> (Mappa dei Sogni) è un archivio di net-art interattivo che indaga la catalogazione clinica, asettica e matematica del materiale onirico del subconscio umano.</span>
        </p>
        <p>
          <span class="lang-en">Rejecting organic or surrealist clichés typically associated with dream representation, the project recontextualizes subjective dream records into a cold, monochrome telemetry matrix powered by real-time graph kinetics.</span>
          <span class="lang-it">Rifiutando i cliché organici o surrealisti tipicamente associati alla rappresentazione dei sogni, il progetto ricontestualizza le registrazioni soggettive dei sogni in una fredda matrice di telemetria monocromatica alimentata dalla cinetica dei grafi in tempo reale.</span>
        </p>
        <p>
          <span class="lang-en">Each dream entry (N=30) is converted into an attribute vector containing both quantitative metrics (<em>Importance</em>, <em>Weirdness</em>, <em>Memory</em>, <em>Lucidity</em>, <em>Duration</em>) and qualitative taxonomies (<em>Mood</em>, <em>Setting</em>, <em>Objects</em>, <em>People</em>, <em>Perspective</em>).</span>
          <span class="lang-it">Ogni voce onirica (N=30) viene convertita in un vettore di attributi contenente sia metriche quantitative (<em>Importanza</em>, <em>Stranezza</em>, <em>Memoria</em>, <em>Lucidità</em>, <em>Durata</em>) che tassonomie qualitative (<em>Umore</em>, <em>Ambientazione</em>, <em>Oggetti</em>, <em>Persone</em>, <em>Prospettiva</em>).</span>
        </p>
      </div>
    </div>

    <!-- Vector Graphic 1: Data & Pipeline Architecture -->
    <div class="mb-28 border-t border-neutral-800 pt-16">
      <div class="mb-8">
        <span class="text-xs font-mono text-neutral-400 uppercase tracking-widest block mb-2">Vector Specification // Diagram 01</span>
        <h3 class="text-2xl font-semibold text-neutral-50" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">
          <span class="lang-en">01. Data Pipeline &amp; Ingestion Architecture</span>
          <span class="lang-it">01. Pipeline dei Dati &amp; Architettura di Acquisizione</span>
        </h3>
      </div>
      <p class="mb-8 text-base text-neutral-400">
        <span class="lang-en">The vector diagram below illustrates the ingestion pipeline: from raw structured JSON entries to attribute vectorization, D3.js force physics computation, and final monochromatic web rendering.</span>
        <span class="lang-it">Il diagramma vettoriale di seguito illustra la pipeline di acquisizione: dalle voci JSON strutturate grezze alla vettorizzazione degli attributi, al calcolo della fisica delle forze D3.js e al rendering web monocromatico finale.</span>
      </p>

      <div class="w-full border border-neutral-800 bg-neutral-950 p-2 md:p-4 rounded-sm overflow-hidden mb-6 shadow-2xl">
        <img 
          src="/progetti/dream-catalogue/diagram-data-pipeline.svg" 
          alt="Dream Catalogue System Architecture and Data Pipeline Vector Diagram"
          class="w-full h-auto object-contain"
        />
      </div>

      <div class="grid md:grid-cols-3 gap-6 text-sm text-neutral-400 font-mono pt-4 border-t border-neutral-900">
        <div class="lang-en">
          <strong class="text-neutral-200 block mb-1">01. JSON Ingestion</strong>
          Structured dataset parsing containing multi-dimensional parameters for each cataloged dream state.
        </div>
        <div class="lang-it">
          <strong class="text-neutral-200 block mb-1">01. Acquisizione JSON</strong>
          Parsing di dataset strutturati contenenti parametri multidimensionali per ogni stato onirico catalogato.
        </div>

        <div class="lang-en">
          <strong class="text-neutral-200 block mb-1">02. Taxonomy Matrix</strong>
          Distance calculation evaluating categorical overlaps across mood, objects, and settings.
        </div>
        <div class="lang-it">
          <strong class="text-neutral-200 block mb-1">02. Matrice di Tassonomia</strong>
          Calcolo della distanza che valuta le sovrapposizioni categoriali tra stati d'animo, oggetti e ambientazioni.
        </div>

        <div class="lang-en">
          <strong class="text-neutral-200 block mb-1">03. Physics &amp; UI</strong>
          60 FPS force simulation feeding live telemetry data into a monochromatic layout.
        </div>
        <div class="lang-it">
          <strong class="text-neutral-200 block mb-1">03. Fisica &amp; Interfaccia Utente</strong>
          Simulazione di forze a 60 FPS che alimenta i dati di telemetria in tempo reale in un layout monocromatico.
        </div>
      </div>
    </div>

    <!-- Vector Graphic 2: Graph Mechanics & Force Field -->
    <div class="mb-28 border-t border-neutral-800 pt-16">
      <div class="mb-8">
        <span class="text-xs font-mono text-neutral-400 uppercase tracking-widest block mb-2">Vector Specification // Diagram 02</span>
        <h3 class="text-2xl font-semibold text-neutral-50" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">
          <span class="lang-en">02. Topological Graph Dynamics &amp; Force Field</span>
          <span class="lang-it">02. Dinamiche del Grafo Topologico &amp; Campo di Forze</span>
        </h3>
      </div>
      <p class="mb-8 text-base text-neutral-400">
        <span class="lang-en">This diagram details the mathematical model governing node radius scaling, categorical link formation, and force attraction versus repulsion dynamics.</span>
        <span class="lang-it">Questo diagramma descrive in dettaglio il modello matematico che governa il ridimensionamento del raggio dei nodi, la formazione di collegamenti categoriali e le dinamiche di forza di attrazione rispetto alla repulsione.</span>
      </p>

      <div class="w-full border border-neutral-800 bg-neutral-950 p-2 md:p-4 rounded-sm overflow-hidden mb-6 shadow-2xl">
        <img 
          src="/progetti/dream-catalogue/diagram-graph-mechanics.svg" 
          alt="Dream Catalogue Topological Graph Dynamics and Force Field Vector Diagram"
          class="w-full h-auto object-contain"
        />
      </div>

      <div class="grid md:grid-cols-3 gap-6 text-sm text-neutral-400 font-mono pt-4 border-t border-neutral-900">
        <div class="lang-en">
          <strong class="text-neutral-200 block mb-1">Node Radius Kinetics</strong>
          Dynamic radius scaling derived from user-selected metrics (Importance, Weirdness, Memory).
        </div>
        <div class="lang-it">
          <strong class="text-neutral-200 block mb-1">Cinetica del Raggio del Nodo</strong>
          Ridimensionamento dinamico del raggio derivato dalle metriche selezionate dall'utente (Importanza, Stranezza, Memoria).
        </div>

        <div class="lang-en">
          <strong class="text-neutral-200 block mb-1">Link Attraction</strong>
          Distance attraction connecting shared categories based on similarity.
        </div>
        <div class="lang-it">
          <strong class="text-neutral-200 block mb-1">Attrazione dei Collegamenti</strong>
          Attrazione a distanza che collega le categorie condivise in base alla somiglianza.
        </div>

        <div class="lang-en">
          <strong class="text-neutral-200 block mb-1">Many-Body Repulsion</strong>
          Inverse-square repulsion maintaining structural equilibrium.
        </div>
        <div class="lang-it">
          <strong class="text-neutral-200 block mb-1">Repulsione a Molti Corpi</strong>
          Repulsione del quadrato inverso che mantiene l'equilibrio strutturale.
        </div>
      </div>
    </div>

    <!-- Vector Graphic 3: Clinical UI & Telemetry Inspector -->
    <div class="mb-28 border-t border-neutral-800 pt-16">
      <div class="mb-8">
        <span class="text-xs font-mono text-neutral-400 uppercase tracking-widest block mb-2">Vector Specification // Diagram 03</span>
        <h3 class="text-2xl font-semibold text-neutral-50" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">
          <span class="lang-en">03. Clinical Interface &amp; Telemetry Layout</span>
          <span class="lang-it">03. Interfaccia Clinica &amp; Layout di Telemetria</span>
        </h3>
      </div>
      <p class="mb-8 text-base text-neutral-400">
        <span class="lang-en">The layout specification breakdown of the interface components: telemetry header bar, filter controls, interactive D3 canvas, and clinical detail inspector.</span>
        <span class="lang-it">La ripartizione delle specifiche di layout dei componenti dell'interfaccia: barra dell'intestazione di telemetria, controlli dei filtri, tela interattiva in D3 e ispettore dei dettagli clinici.</span>
      </p>

      <div class="w-full border border-neutral-800 bg-neutral-950 p-2 md:p-4 rounded-sm overflow-hidden mb-6 shadow-2xl">
        <img 
          src="/progetti/dream-catalogue/diagram-ui-telemetry.svg" 
          alt="Dream Catalogue Clinical Interface Specification and Telemetry Layout Vector Diagram"
          class="w-full h-auto object-contain"
        />
      </div>

      <div class="grid md:grid-cols-3 gap-6 text-sm text-neutral-400 font-mono pt-4 border-t border-neutral-900">
        <div class="lang-en">
          <strong class="text-neutral-200 block mb-1">Header &amp; Count</strong>
          Live entry counter (N=30), language switcher (IT/EN), and real-time clock.
        </div>
        <div class="lang-it">
          <strong class="text-neutral-200 block mb-1">Intestazione &amp; Conteggio</strong>
          Contatore di voci in tempo reale (N=30), selettore della lingua (IT/EN) e orologio in tempo reale.
        </div>

        <div class="lang-en">
          <strong class="text-neutral-200 block mb-1">Dynamic Filter Controls</strong>
          `CONNECT BY` and `SIZE BY` selectors triggering instant graph reconfiguration.
        </div>
        <div class="lang-it">
          <strong class="text-neutral-200 block mb-1">Controlli Filtro Dinamici</strong>
          Selettori `CONNECT BY` e `SIZE BY` che innescano la riconfigurazione istantanea del grafo.
        </div>

        <div class="lang-en">
          <strong class="text-neutral-200 block mb-1">Detail Inspector</strong>
          Clinical telemetry panel displaying dream metadata, timestamps, and audio cues.
        </div>
        <div class="lang-it">
          <strong class="text-neutral-200 block mb-1">Ispettore dei Dettagli</strong>
          Pannello di telemetria clinica che visualizza metadati dei sogni, timestamp e segnali audio.
        </div>
      </div>
    </div>

  </section>
</BaseLayout>
