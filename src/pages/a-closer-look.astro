---
import { getProxyUrl } from "../utils/image";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="A Closer Look - Gabriele Radicello">
  <!-- Hero Section -->
  <section class="relative h-[100dvh] w-full overflow-hidden flex items-center justify-center">
    <video 
      autoplay 
      muted 
      loop 
      playsinline 
      preload="auto"
      class="absolute inset-0 w-full h-full object-cover z-0"
    >
      <source src="/progetti/a-closer-look/assets/Tdmovieout.0.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-black/60 z-10"></div>
    <div class="relative z-20 text-center px-6">
      <h1 
        class="text-4xl md:text-8xl font-normal text-white tracking-tight" 
        style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;"
      >
        A Closer Look
      </h1>
      <p class="mt-6 text-lg md:text-xl text-neutral-300 font-light max-w-2xl mx-auto">
        An interactive installation that investigates censorship and access to documents of the Epstein case.
      </p>
    </div>
  </section>

  <!-- Content Section -->
  <section class="max-w-4xl mx-auto px-6 py-24 md:py-32 text-neutral-300 text-lg leading-8 text-left">
    
    <div class="mb-16 md:mb-24">
      <h2 class="text-3xl font-normal text-neutral-50 mb-8" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">Concept</h2>
      <div class="grid gap-8">
        <p>
          Following the release of documents regarding the Epstein case by the American Department of Justice, the entire world was caught by a wave of shock and disbelief. This project aims to focus on the theme of documents drafted in an apparently random way.
        </p>
        <p>
          Maintaining the aesthetic but reversing the dynamics of censorship implemented by the American Department of Justice, <em>A Closer Look</em> invites the spectator to unveil portions of images coming from the Epstein files through interaction developed with a camera that records the spectator.
        </p>
      </div>
    </div>

    <div class="mb-16 md:mb-24">
      <h2 class="text-3xl font-normal text-neutral-50 mb-8" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">Structure</h2>
      <div class="grid gap-8">
        <p>
          A screen displays a black image. As soon as a person approaches the screen, they are recorded by a camera and their silhouette is superimposed on the black image, revealing portions of an infinite series of images coming from the Epstein files database that alternate randomly in rapid succession.
        </p>
        <p>
          For an aesthetic choice and to add an element of truthfulness, the images are accompanied by a caption indicating the file name.
        </p>
        <p>
          The visual part is accompanied by a soundtrack composed of audio excerpts and testimonies coming from the Epstein files database.
        </p>
      </div>
    </div>

    <div class="mb-24">
      <h2 class="text-3xl font-normal text-neutral-50 mb-8" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">Technology</h2>
      <p>
        The project is developed with <strong>Touchdesigner</strong> and uses a <strong>Kinect v2</strong> for motion detection and silhouette extraction.
      </p>
    </div>

    <!-- Gallery Section -->
    <div class="border-t border-neutral-800 pt-16">
      <h2 class="text-3xl font-normal text-neutral-50 mb-12" style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;">Gallery</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <img 
          src={getProxyUrl("/progetti/a-closer-look/assets/IMG_0010.JPG")} data-src="/progetti/a-closer-look/assets/IMG_0010.JPG" 
          alt="Spazio espositivo dell'installazione interattiva, con lo schermo acceso e la videocamera Kinect posizionata per il tracciamento dei visitatori" 
          class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 gallery-img" 
          loading="lazy" 
        />
        <img 
          src={getProxyUrl("/progetti/a-closer-look/assets/IMG_0012.JPG")} data-src="/progetti/a-closer-look/assets/IMG_0012.JPG" 
          alt="Spettatore in piedi di fronte all'installazione, la cui silhouette tracciata rivela frammenti di testo dai documenti Epstein sul display" 
          class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 gallery-img" 
          loading="lazy" 
        />
        <img 
          src={getProxyUrl("/progetti/a-closer-look/assets/IMG_0013.JPG")} data-src="/progetti/a-closer-look/assets/IMG_0013.JPG" 
          alt="Inquadratura prospettica dell'installazione a parete con un utente che sperimenta l'opera muovendo le braccia" 
          class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 gallery-img" 
          loading="lazy" 
        />
        <img 
          src={getProxyUrl("/progetti/a-closer-look/assets/TDMovieOut.0.png")} data-src="/progetti/a-closer-look/assets/TDMovieOut.0.png" 
          alt="Esportazione video da TouchDesigner che mostra l'effetto visivo della silhouette umana che funge da maschera di decensura" 
          class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 gallery-img" 
          loading="lazy" 
        />
        <img 
          src={getProxyUrl("/progetti/a-closer-look/assets/sample.png")} data-src="/progetti/a-closer-look/assets/sample.png" 
          alt="Esempio di documento giudiziario con pesanti censure nere rettangolari, tipiche dei file federali rilasciati" 
          class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 gallery-img" 
          loading="lazy" 
        />
        <img 
          src={getProxyUrl("/progetti/a-closer-look/assets/Screenshot (3).png")} data-src="/progetti/a-closer-look/assets/Screenshot (3).png" 
          alt="Cattura di schermata ad alta risoluzione del software con la silhouette che si muove svelando le pagine dell'inchiesta" 
          class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 gallery-img" 
          loading="lazy" 
        />
        <img 
          src={getProxyUrl("/progetti/a-closer-look/assets/Screenshot (15).png")} data-src="/progetti/a-closer-look/assets/Screenshot (15).png" 
          alt="Dettaglio dell'interfaccia utente con metadati, intestazioni federali e trascrizioni audio scansionate che scorrono velocemente" 
          class="w-full h-auto object-cover aspect-[4/3] bg-neutral-900 gallery-img" 
          loading="lazy" 
        />
      </div>
    </div>

  </section>
</BaseLayout>
