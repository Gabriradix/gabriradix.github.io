---
import Header from "../components/Header.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  hideHeader?: boolean;
  favicon?: string;
  logoHoverColor?: string;
  brandColor?: string;
  transparentHeader?: boolean;
  logoHref?: string;
}

const { 
  title = "Portfolio", 
  description = "Portfolio of Gabriele Radicello",
  hideHeader = false,
  logoHoverColor,
  brandColor,
  transparentHeader = false,
  logoHref
} = Astro.props;

// Standardized branding logic
const finalLogoHover = brandColor || logoHoverColor;
const faviconColor = brandColor || "#ffffff";

// Dynamic SVG Favicon: a square with the site background and the custom √ symbol
const dynamicFavicon = `data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%23171717'/%3E%3Cg transform='translate(35, 19) scale(1.1)'%3E%3Cpath d='M12.13 39.45L22.56 10.84L27.17 10.84L13.94 46.39L10.50 46.39L4.52 31.05L0 31.05L0 27.29L7.69 27.29L12.13 39.45Z' fill='${encodeURIComponent(faviconColor)}'/%3E%3C/g%3E%3C/svg%3E`;

const { favicon = dynamicFavicon } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..700;1,400..700&family=Roboto:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
    {finalLogoHover && (
      <style is:global set:html={`header a:hover, header a:hover span, header a:hover div, header a:hover svg { color: ${finalLogoHover} !important; }`}></style>
    )}
    <script is:inline>
      (function() {
        const setLang = () => {
          const savedLang = localStorage.getItem('lang') || 'en';
          document.documentElement.setAttribute('data-lang', savedLang);
        };
        setLang();
        document.addEventListener('astro:after-swap', setLang);
      })();
    </script>
    <style is:global>
      @font-face {
        font-family: 'Apple Garamond Custom';
        src: url('/fonts/AppleGaramond.ttf') format('truetype');
        font-weight: bold;
        font-style: normal;
      }
      @font-face {
        font-family: 'Helvetica Custom';
        src: url('/fonts/Helvetica.ttf') format('truetype');
        font-weight: normal;
        font-style: normal;
      }

      h1, h2, h3, h4, h5, h6 {
        text-transform: uppercase;
        font-feature-settings: "ss05";
        font-family: abcplus, 'Helvetica Custom', Helvetica, Arial, sans-serif;
        font-size: calc(var(--font-size) * 3);
        font-variation-settings: "MONO" 0, "wght" 700;
        font-weight: 720;
        line-height: calc(var(--line) * 2.4);
        letter-spacing: -.03em;
      }

      h1 {
        --font-size: clamp(1rem, 3.5vw, 1.8rem);
        --line: clamp(0.9rem, 3vw, 1.6rem);
      }

      h2 {
        --font-size: clamp(0.8rem, 2vw, 1.1rem);
        --line: clamp(0.8rem, 2vw, 1.1rem);
      }

      h3 {
        --font-size: clamp(0.7rem, 1.5vw, 0.85rem);
        --line: clamp(0.7rem, 1.5vw, 0.85rem);
      }

      h4, h5, h6 {
        --font-size: clamp(0.6rem, 1vw, 0.7rem);
        --line: clamp(0.6rem, 1vw, 0.7rem);
      }

      /* Progressive Image Loader Styles */
      img {
        transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1), 
                    filter 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        will-change: opacity, filter;
      }
      img[data-src],
      img.img-loading {
        filter: blur(20px) !important;
        opacity: 0.6 !important;
        clip-path: inset(0) !important;
      }

      /* Lightbox Styles */
      #lightbox {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.9);
        backdrop-filter: blur(10px);
        cursor: zoom-out;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      }
      #lightbox.active {
        opacity: 1;
        pointer-events: auto;
      }
      #lightbox img {
        max-width: 90vw;
        max-height: 90vh;
        object-fit: contain;
        box-shadow: 0 0 50px rgba(0,0,0,0.5);
        transform: scale(0.9);
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      }
      #lightbox.active img {
        transform: scale(1);
      }
      #lightbox img.slide-out {
        transform: translateX(-50px) scale(0.9) !important;
        opacity: 0 !important;
      }
      #lightbox img.slide-out-reverse {
        transform: translateX(50px) scale(0.9) !important;
        opacity: 0 !important;
      }
      #lightbox img.slide-in {
        transform: translateX(50px) scale(0.9) !important;
        opacity: 0 !important;
        transition: none !important;
      }
      #lightbox img.slide-in-reverse {
        transform: translateX(-50px) scale(0.9) !important;
        opacity: 0 !important;
        transition: none !important;
      }
      .gallery-img {
        cursor: pointer;
        transition: opacity 0.3s ease,
                    filter 0.8s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .gallery-img:hover {
        opacity: 0.8;
      }

      /* Garamond Body Text Optimizations */
      p:not(.text-xs):not(.text-sm):not(.text-base) {
        font-size: 1.25rem; /* Scale up prose paragraphs to 20px */
        line-height: 1.8;
      }

      li:not(.text-xs):not(.text-sm) {
        font-size: 1.2rem;
        line-height: 1.7;
      }

      /* Subtitles / Hero Description Text */
      p.text-xl, .text-xl {
        font-size: 1.45rem; /* Scale up large subtitles/descriptions */
        line-height: 1.6;
      }

      /* Header Name & Nav Garamond Optimizations */
      #header-name {
        font-size: 1.05rem;
      }
      @media (min-width: 768px) {
        #header-name {
          font-size: 1.65rem;
        }
      }

      #header-nav a, #header-nav button {
        font-size: 0.85rem;
      }
      @media (min-width: 768px) {
        #header-nav a, #header-nav button {
          font-size: 1.1rem;
        }
      }

      /* Small Metadata (e.g. category, details) in Garamond */
      .project-card .text-xs:not(.font-mono) {
        font-size: 0.95rem;
      }

      /* Header readability overrides (dark drop-shadow mask for scroll contrast) */
      #logo-root, #header-name, #header-nav a {
        filter: drop-shadow(0 0 6px #171717) drop-shadow(0 0 12px #171717) drop-shadow(0 0 18px #171717);
      }



      /* Header dimming during ASCII mode: ONLY dim the nav menu */
      html.ascii-active header #header-nav {
        opacity: 0.12 !important;
        filter: blur(4px);
        pointer-events: none;
      }
      
      /* Inactive projects and contacts fade and blur during ASCII mode */
      html.ascii-active .project-card:not(.hovered-card),
      html.ascii-active .contact-card:not(.hovered-card) {
        opacity: 0.12 !important;
        filter: blur(4px) grayscale(0.5);
        pointer-events: none;
      }

      /* When hovering over the logo, dim and blur the ENTIRE page content & nav menu */
      html.logo-active main {
        opacity: 0.12 !important;
        filter: blur(4px) grayscale(0.5);
        pointer-events: none;
      }
      html.logo-active header #header-nav {
        opacity: 0.12 !important;
        filter: blur(4px);
        pointer-events: none;
      }

      /* ASCII Page Loading transition */
      html.ascii-loading main {
        opacity: 0 !important;
        filter: blur(8px);
        pointer-events: none;
      }
      html.ascii-loading header #header-nav {
        opacity: 0 !important;
        filter: blur(8px);
        pointer-events: none;
      }

      /* Ensure ASCII canvas overlay (z-index 99) covers page content, while hovered items (z-index 101) rise above it */
      header {
        z-index: 40 !important;
        transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), filter 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      }
      html.logo-active header,
      header:has(.hovered-logo) {
        z-index: 101 !important;
      }
      #header-nav {
        transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), filter 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        will-change: opacity, filter;
      }
      .project-card,
      .contact-card {
        transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), filter 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        will-change: opacity, filter;
      }
      main {
        position: relative;
        z-index: auto;
        transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), filter 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .hovered-card,
      .hovered-logo {
        z-index: 101 !important;
        position: relative !important;
      }
      .hovered-target,
      .hovered-logo {
        /* Aggiungiamo un drop-shadow che crea un alone scuro perfettamente aderente alle curve del font o SVG, mascherando i caratteri ASCII in modo organico */
        filter: drop-shadow(0 0 8px #171717) drop-shadow(0 0 16px #171717) drop-shadow(0 0 32px #171717) drop-shadow(0 0 64px #171717) !important;
      }
    </style>

  </head>
  <body 
    class="bg-neutral-900 text-neutral-50 antialiased font-sans" 
    style="font-family: 'Apple Garamond Custom', serif;"
  >
    <!-- Fullscreen Generative ASCII Canvas Overlay -->
    <canvas 
      id="global-ascii-canvas" 
      class="fixed inset-0 w-full h-full pointer-events-none transition-opacity duration-700 ease-in-out"
      style="z-index: 99; opacity: 1;"
    ></canvas>
    <script is:inline>
      (function() {
        var canvas = document.getElementById("global-ascii-canvas");
        if (!canvas) return;
        var ctx = canvas.getContext("2d");
        if (!ctx) return;

        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;

        window._asciiIntroActive = true;
        var asciiRamp = " .:-=+*#%@";
        var isRunning = true;
        var animId = null;

        var mouseX = window.innerWidth / 2;
        var mouseY = window.innerHeight / 2;

        function loop() {
          if (!isRunning) return;

          var w = canvas.width;
          var h = canvas.height;
          var charWidth = 13;
          var charHeight = 18;
          var cols = Math.floor(w / charWidth);
          var rows = Math.floor(h / charHeight);

          ctx.fillStyle = "#171717";
          ctx.fillRect(0, 0, w, h);

          ctx.font = (charHeight - 2) + "px monospace";
          ctx.textBaseline = "top";

          var time = performance.now() * 0.001;
          var mouseCol = Math.floor(mouseX / charWidth);
          var mouseRow = Math.floor(mouseY / charHeight);

          for (var r = 0; r < rows; r++) {
            for (var c = 0; c < cols; c++) {
              var dx = c - mouseCol;
              var dy = r - mouseRow;
              var dist = Math.sqrt(dx*dx + dy*dy);

              var wave1 = Math.sin(c * 0.12 - time * 2.5) * Math.cos(r * 0.08 + time * 1.5);
              var wave2 = Math.sin(Math.sqrt(c*c + r*r) * 0.04 - time * 2);
              var ripple = Math.sin(dist * 0.3 - time * 6) * Math.exp(-dist * 0.07);

              var z = (wave1 + wave2) * 0.4 + ripple * 0.8;
              z += Math.sin(c * 2.3 + r * 3.7 + time * 10) * 0.08;

              var index = Math.floor((z + 1) * 0.5 * asciiRamp.length);
              if (index < 0) index = 0;
              if (index >= asciiRamp.length) index = asciiRamp.length - 1;

              var brightness = Math.floor(40 + (z + 1) * 0.5 * 80);
              ctx.fillStyle = "rgba(" + brightness + ", " + brightness + ", " + (brightness + 10) + ", 0.85)";
              ctx.fillText(asciiRamp[index], c * charWidth, r * charHeight);
            }
          }

          animId = requestAnimationFrame(loop);
        }

        // Render frame 0 synchronously RIGHT NOW
        loop();

        // After 400ms, fade out to transparency
        setTimeout(function() {
          if (!window._asciiIntroActive) return; // Abort fade out if hijacked by a hover!
          canvas.style.opacity = "0";
          setTimeout(function() {
            if (!window._asciiIntroActive) {
               canvas.style.opacity = "0.8"; // Restore opacity if hijacked during the fade out
               return; 
            }
            canvas.style.zIndex = "2";
            isRunning = false;
            window._asciiIntroActive = false;
            if (animId) cancelAnimationFrame(animId);
          }, 400);
        }, 400);
      })();
    </script>

    {!hideHeader && <Header logoHref={logoHref} />}

    <main>
      <slot />
    </main>

    <!-- Lightbox Overlay -->
    <div id="lightbox" aria-hidden="true">
      <img id="lightbox-img" src="" alt="Visualizzazione ingrandita dell'immagine" />
    </div>

    <script>
      let currentImageIndex = 0;
      let galleryImages: HTMLImageElement[] = [];

      const updateGalleryImages = () => {
        galleryImages = Array.from(document.querySelectorAll<HTMLImageElement>('.gallery-img'));
      };

      const showImage = (index: number, direction: 'next' | 'prev' | 'none' = 'none') => {
        const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
        if (galleryImages.length === 0 || !lightboxImg) return;
        
        const oldIndex = currentImageIndex;
        if (index < 0) index = galleryImages.length - 1;
        if (index >= galleryImages.length) index = 0;
        
        if (direction !== 'none' && index !== oldIndex) {
          const outClass = direction === 'next' ? 'slide-out' : 'slide-out-reverse';
          const inClass = direction === 'next' ? 'slide-in' : 'slide-in-reverse';
          
          lightboxImg.classList.add(outClass);
          
          setTimeout(() => {
            currentImageIndex = index;
            lightboxImg.src = galleryImages[currentImageIndex].src;
            lightboxImg.alt = galleryImages[currentImageIndex].alt || "Visualizzazione ingrandita dell'immagine";
            lightboxImg.classList.remove(outClass);
            lightboxImg.classList.add(inClass);
            
            // Force reflow
            lightboxImg.offsetHeight;
            
            lightboxImg.classList.remove(inClass);
          }, 200);
        } else {
          currentImageIndex = index;
          lightboxImg.src = galleryImages[currentImageIndex].src;
          lightboxImg.alt = galleryImages[currentImageIndex].alt || "Visualizzazione ingrandita dell'immagine";
        }
      };

      // Swipe support via global event delegation
      let touchStartX = 0;
      let touchEndX = 0;

      document.addEventListener('touchstart', (e) => {
        const lightbox = document.getElementById('lightbox');
        if (!lightbox || !lightbox.classList.contains('active')) return;
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      document.addEventListener('touchend', (e) => {
        const lightbox = document.getElementById('lightbox');
        if (!lightbox || !lightbox.classList.contains('active')) return;

        touchEndX = e.changedTouches[0].screenX;
        const swipeThreshold = 50;
        if (touchEndX < touchStartX - swipeThreshold) {
          showImage(currentImageIndex + 1, 'next');
        } else if (touchEndX > touchStartX + swipeThreshold) {
          showImage(currentImageIndex - 1, 'prev');
        }
      }, { passive: true });

      // Global click listener for gallery images (Opening & Closing)
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        
        // 1. OPEN Lightbox
        if (target instanceof HTMLImageElement && target.classList.contains('gallery-img')) {
          updateGalleryImages();
          currentImageIndex = galleryImages.indexOf(target);
          showImage(currentImageIndex);
          
          const lightbox = document.getElementById('lightbox');
          if (lightbox) {
            // Prevent page jitter by padding for scrollbar width
            const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
            document.body.style.paddingRight = `${scrollbarWidth}px`;
            document.body.style.overflow = 'hidden';
            lightbox.classList.add('active');
          }
          return;
        }

        // 2. CLOSE Lightbox (click overlay or close elements inside it)
        const lightbox = document.getElementById('lightbox');
        if (lightbox && lightbox.classList.contains('active')) {
          if (target.closest('#lightbox')) {
            lightbox.classList.remove('active');
            document.body.style.overflow = '';
            document.body.style.paddingRight = '';
          }
        }
      });

      // Keyboard navigation via global event delegation
      document.addEventListener('keydown', (e) => {
        const lightbox = document.getElementById('lightbox');
        if (!lightbox || !lightbox.classList.contains('active')) return;
        
        if (e.key === 'Escape') {
          lightbox.classList.remove('active');
          document.body.style.overflow = '';
          document.body.style.paddingRight = '';
        } else if (e.key === 'ArrowRight') {
          showImage(currentImageIndex + 1, 'next');
        } else if (e.key === 'ArrowLeft') {
          showImage(currentImageIndex - 1, 'prev');
        }
      });

      // Progressive Image Loading
      function initProgressiveImages() {
        const images = document.querySelectorAll('img[data-src]');
        images.forEach(node => {
          const img = node as HTMLImageElement;
          const highResUrl = img.getAttribute('data-src');
          if (!highResUrl) return;

          // If high-res is already loaded or cached, update directly
          const tempImg = new Image();
          tempImg.src = highResUrl;
          
          if (tempImg.complete) {
            img.src = highResUrl;
            img.classList.remove('img-loading');
            img.removeAttribute('data-src');
          } else {
            img.classList.add('img-loading');
            
            const onload = () => {
              img.src = highResUrl;
              img.classList.remove('img-loading');
              img.removeAttribute('data-src');
              tempImg.removeEventListener('load', onload);
            };
            
            tempImg.addEventListener('load', onload);
          }
        });
      }

      initProgressiveImages();
      document.addEventListener('astro:page-load', initProgressiveImages);
    </script>

    <script>
      // Global Video Autoplay & Reload Manager for Astro View Transitions (ClientRouter)
      function ensureAllVideosPlay() {
        const videos = document.querySelectorAll<HTMLVideoElement>('video');
        videos.forEach(v => {
          v.muted = true;
          v.defaultMuted = true;
          v.setAttribute('muted', '');
          v.playsInline = true;
          v.setAttribute('playsinline', '');
          v.setAttribute('webkit-playsinline', '');

          // Force loading if video is uninitialized (common on client-side navigation swaps)
          if (v.networkState === 0) {
            v.load();
          }

          const promise = v.play();
          if (promise !== undefined) {
            promise.catch(() => {
              const resumeOnInteraction = () => {
                v.play().catch(() => {});
                window.removeEventListener('touchstart', resumeOnInteraction);
                window.removeEventListener('scroll', resumeOnInteraction);
                window.removeEventListener('click', resumeOnInteraction);
              };
              window.addEventListener('touchstart', resumeOnInteraction, { passive: true });
              window.addEventListener('scroll', resumeOnInteraction, { passive: true });
              window.addEventListener('click', resumeOnInteraction, { passive: true });
            });
          }
        });
      }

      ensureAllVideosPlay();
      document.addEventListener('astro:page-load', ensureAllVideosPlay);
      document.addEventListener('astro:after-swap', ensureAllVideosPlay);
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) ensureAllVideosPlay();
      });
    </script>

    <script>
      // Highly optimized ASCII generative background wave engine
      let canvas: HTMLCanvasElement | null = null;
      let ctx: CanvasRenderingContext2D | null = null;
      let animationFrameId: number | null = null;
      let isAnimating = false;
      let isIntroRunning = false;
      
      // Initialize mouse coordinates to the center of the viewport to ensure drawing works instantly
      let mouseX = window.innerWidth / 2;
      let mouseY = window.innerHeight / 2;
      let fadeOutTimeoutId: number | null = null;

      // Character ramp for wave mapping (ordered by density)
      const asciiRamp = " .:-=+*#%@";

      // Module-level resizing function
      const resizeCanvas = () => {
        if (canvas) {
          canvas.width = window.innerWidth;
          canvas.height = window.innerHeight;
        }
      };

      // Register module-level event listeners once to prevent leaks
      window.addEventListener("resize", resizeCanvas);

      window.addEventListener("mousemove", (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
      });

      const handleTouchCoord = (e: TouchEvent) => {
        if (e.touches && e.touches.length > 0) {
          mouseX = e.touches[0].clientX;
          mouseY = e.touches[0].clientY;
        }
      };
      window.addEventListener("touchstart", handleTouchCoord, { passive: true });
      window.addEventListener("touchmove", handleTouchCoord, { passive: true });

      let lastNavTime = 0;
      let suppressUntil = 0;

      function handleBeforePreparation(e: any) {
        suppressUntil = 0;
        lastNavTime = Date.now();
        (window as any)._lastNavTime = lastNavTime;
        document.documentElement.classList.add("ascii-loading");
        
        // Disable transition during startup to show the loading background instantly
        if (canvas) {
          canvas.style.transition = "none";
          // Force reflow
          canvas.offsetHeight;
        }

        startAsciiLoop();

        // Restore the smooth fade transition for when the loop stops
        if (canvas) {
          requestAnimationFrame(() => {
            if (canvas) {
              canvas.style.transition = "opacity 0.7s ease-in-out";
            }
          });
        }

        // Wrap e.loader in a function so that it returns a delayed promise, guaranteeing smooth transition
        if (e && typeof e.loader === "function") {
          const originalLoader = e.loader;
          e.loader = () => {
            const delayPromise = new Promise(resolve => setTimeout(resolve, 150));
            return Promise.all([originalLoader(), delayPromise]).then(results => results[0]);
          };
        }
      }

      function handlePageLoad() {
        suppressUntil = Date.now() + 1200;
        document.documentElement.classList.remove("ascii-loading");
        document.documentElement.classList.remove("ascii-active");
        document.documentElement.classList.remove("logo-active");
        document.querySelectorAll('.hovered-card').forEach(el => el.classList.remove('hovered-card'));
        document.querySelectorAll('.hovered-logo').forEach(el => el.classList.remove('hovered-logo'));
        isIntroRunning = false;
        (window as any)._asciiIntroActive = false;
        stopAsciiLoop(true);
        initAsciiEngine();

        // Safety backups to clear any mouseenter triggers right after page swap
        setTimeout(() => stopAsciiLoop(true), 100);
        setTimeout(() => stopAsciiLoop(true), 300);
      }

      function initAsciiEngine() {
        canvas = document.getElementById("global-ascii-canvas") as HTMLCanvasElement;
        if (!canvas) return;
        ctx = canvas.getContext("2d");
        if (!ctx) return;

        // Size it initially
        resizeCanvas();

        // Event listeners from projects
        document.removeEventListener("ascii-start", startAsciiLoop);
        document.removeEventListener("ascii-stop", stopAsciiLoop);
        document.addEventListener("ascii-start", startAsciiLoop);
        document.addEventListener("ascii-stop", stopAsciiLoop);

        // View Transition triggers
        document.removeEventListener("astro:before-preparation", handleBeforePreparation);
        document.removeEventListener("astro:after-preparation", handlePageLoad);
        document.removeEventListener("astro:page-load", handlePageLoad);
        document.removeEventListener("astro:after-swap", handlePageLoad);
        document.addEventListener("astro:before-preparation", handleBeforePreparation);
        document.addEventListener("astro:after-preparation", handlePageLoad);
        document.addEventListener("astro:page-load", handlePageLoad);
        document.addEventListener("astro:after-swap", handlePageLoad);

        // Global link click cleanup
        document.addEventListener('click', (e) => {
          const link = (e.target as HTMLElement)?.closest('a, button');
          if (link) {
            document.querySelectorAll('.hovered-card').forEach(el => el.classList.remove('hovered-card'));
            document.querySelectorAll('.hovered-logo').forEach(el => el.classList.remove('hovered-logo'));
            document.documentElement.classList.remove('ascii-active', 'logo-active');
          }
        });

        // Logo hover triggers
        const logoLink = document.getElementById("logo-link");
        if (logoLink) {
          const handleLogoEnter = () => {
            logoLink.classList.add("hovered-target", "hovered-logo");
            document.documentElement.classList.add("logo-active");
            startAsciiLoop();
          };

          const handleLogoLeave = () => {
            logoLink.classList.remove("hovered-target", "hovered-logo");
            document.documentElement.classList.remove("logo-active");
            stopAsciiLoop(true);
          };

          logoLink.addEventListener("mouseenter", handleLogoEnter);
          logoLink.addEventListener("mouseleave", handleLogoLeave);
          logoLink.addEventListener("touchstart", handleLogoEnter, { passive: true });
          logoLink.addEventListener("touchend", handleLogoLeave, { passive: true });
        }
      }

      function startAsciiLoop() {
        if ((window as any)._asciiIntroActive) {
          // User hovered DURING the initial page load intro!
          // Hijack the intro so it doesn't shut down the canvas.
          (window as any)._asciiIntroActive = false; 
          if (canvas) {
            canvas.style.zIndex = "99";
            canvas.style.opacity = "0.8";
          }
          isAnimating = true;
          return;
        }

        const now = Date.now();
        if (now < suppressUntil) {
           // Instead of dropping the event, schedule it to start when suppression ends,
           // provided the user is STILL hovering an element.
           setTimeout(() => {
             if (document.querySelector('.hovered-card') || document.querySelector('.hovered-logo')) {
               startAsciiLoop();
             }
           }, suppressUntil - now);
           return;
        }
        // Defensive re-query if elements were swapped or not initialized yet (prevents click requirement)
        if (!canvas || !ctx) {
          initAsciiEngine();
        }

        // Clear any active fade out timer
        if (fadeOutTimeoutId) {
          clearTimeout(fadeOutTimeoutId);
          fadeOutTimeoutId = null;
        }

        if (canvas && !isIntroRunning) {
          canvas.style.zIndex = "99";
          canvas.style.opacity = "0.8"; // Overall animation opacity set to 0.8 as requested
        }

        // Forcefully ensure hovered elements are in the foreground (combats transition-induced stacking context bugs)
        document.querySelectorAll('.hovered-card, .hovered-logo').forEach((el) => {
          (el as HTMLElement).style.zIndex = "101";
          (el as HTMLElement).style.position = "relative";
        });
        const header = document.getElementById('main-header');
        if (header && document.querySelector('.hovered-logo')) {
          header.style.zIndex = "101";
        }

        if (isAnimating) return;
        isAnimating = true;
        loop();
      }

      function stopAsciiLoop(force = false) {
        if (!force) {
          if (isIntroRunning) return;
          // If there is still any hovered card or hovered logo, keep the loop active!
          if (document.querySelector('.hovered-card') || document.querySelector('.hovered-logo')) return;
        }

        // Clean up inline styles
        document.querySelectorAll('.project-card, .contact-card, .hovered-logo').forEach((el) => {
          (el as HTMLElement).style.zIndex = "";
          (el as HTMLElement).style.position = "";
        });
        const header = document.getElementById('main-header');
        if (header) header.style.zIndex = "";

        if (canvas) {
          canvas.style.opacity = "0";
        }

        // Delay loop termination and canvas clearing to allow the CSS opacity transition to complete smoothly
        if (fadeOutTimeoutId) clearTimeout(fadeOutTimeoutId);
        fadeOutTimeoutId = setTimeout(() => {
          if (!isAnimating) return;
          isAnimating = false;
          if (animationFrameId) {
            cancelAnimationFrame(animationFrameId);
            animationFrameId = null;
          }
          if (ctx && canvas) {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            canvas.style.zIndex = "2";
          }
          fadeOutTimeoutId = null;
        }, 700) as unknown as number; // 700ms matching transition-opacity duration-700
      }

      function loop() {
        if (!isAnimating || !canvas || !ctx) return;

        const w = canvas.width;
        const h = canvas.height;

        // Grid resolution (1 character every 13 pixels horizontally, 18 vertically)
        const charWidth = 13;
        const charHeight = 18;
        const cols = Math.floor(w / charWidth);
        const rows = Math.floor(h / charHeight);

        // 1. Fill background with solid theme color so all unhovered elements are 100% masked
        ctx.fillStyle = "#171717";
        ctx.fillRect(0, 0, w, h);

        ctx.font = `${charHeight - 2}px monospace`;
        ctx.textBaseline = "top";

        const time = performance.now() * 0.001;

        // Grid coordinates of the mouse
        const mouseCol = Math.floor(mouseX / charWidth);
        const mouseRow = Math.floor(mouseY / charHeight);

        for (let r = 0; r < rows; r++) {
          const charY = r * charHeight;
          const charBottom = charY + charHeight;

          for (let c = 0; c < cols; c++) {
            const charX = c * charWidth;
            const charRight = charX + charWidth;

            // Generative mathematical wave equations combining noise and coordinate ripples
            const dx = c - mouseCol;
            const dy = r - mouseRow;
            const dist = Math.sqrt(dx*dx + dy*dy);

            // Base waves
            const wave1 = Math.sin(c * 0.12 - time * 2.5) * Math.cos(r * 0.08 + time * 1.5);
            const wave2 = Math.sin(Math.sqrt(c*c + r*r) * 0.04 - time * 2);
            
            // Mouse interactive ripple (decays over distance)
            const ripple = Math.sin(dist * 0.3 - time * 6) * Math.exp(-dist * 0.07);

            // Combine fields
            let z = (wave1 + wave2) * 0.4 + ripple * 0.8;
            
            // Add a tiny bit of generative background noise for organic glitch texture
            const noise = Math.sin(c * 2.3 + r * 3.7 + time * 10) * 0.08;
            z += noise;

            // Clamp and map value from [-1, 1] to character index
            let index = Math.floor((z + 1) * 0.5 * asciiRamp.length);
            if (index < 0) index = 0;
            if (index >= asciiRamp.length) index = asciiRamp.length - 1;

            const char = asciiRamp[index];

            // Render
            // Subtle, beautiful low-contrast gray color that glows slightly in dark mode
            const brightness = Math.floor(40 + (z + 1) * 0.5 * 80); // gray levels from 40 to 120
            ctx.fillStyle = `rgba(${brightness}, ${brightness}, ${brightness + 10}, 0.85)`;

            ctx.fillText(char, charX, charY);
          }
        }

        animationFrameId = requestAnimationFrame(loop);
      }

      // Initialize
      initAsciiEngine();
      document.addEventListener("astro:page-load", initAsciiEngine);
    </script>
  </body>
</html>
