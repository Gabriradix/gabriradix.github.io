---
import Header from "../components/Header.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { projects } from "../data/projects";

interface Props {
  title: string;
  description?: string;
  hideHeader?: boolean;
  favicon?: string;
  logoHoverColor?: string;
  brandColor?: string;
  transparentHeader?: boolean;
  logoHref?: string;
  noindex?: boolean;
}

const { 
  title = "Portfolio", 
  description,
  hideHeader = false,
  logoHoverColor,
  brandColor,
  transparentHeader = false,
  logoHref,
  noindex = false
} = Astro.props;

const pagePath = Astro.url.pathname.replace(/\/$/, '') || '/';
const project = projects.find(project => project.href === pagePath);
const siteDescription = "Gabriele Radicello (gabriradix), multimedia artist. Explore installations, audiovisual performances, digital art and virtual worlds.";
const pageDescriptions: Record<string, string> = {
  '/': siteDescription,
  '/about': "Discover Gabriele Radicello (gabriradix), multimedia artist exploring human sensitivity, algorithms and virtual worlds. Biography, exhibitions and education.",
  '/contacts': "Contact Gabriele Radicello (gabriradix), multimedia artist. Find his email and official Instagram, TikTok and X profiles.",
};
const pageDescription = description || pageDescriptions[pagePath] || (project ? `${project.title} — ${project.text}` : siteDescription);
// GitHub Pages serves directory routes with a trailing slash. Match the sitemap.
const canonicalUrl = new URL(pagePath === '/' ? '/' : `${pagePath}/`, Astro.site);
const shareImage = project?.images.find(image => /\.(png|jpe?g|webp|gif)$/i.test(image)) || '/assets/aboutphoto.JPEG';
const shareImageUrl = new URL(shareImage, Astro.site);
const siteUrl = new URL('/', Astro.site).href;
const personId = `${siteUrl}#person`;
const websiteId = `${siteUrl}#website`;
const personReference = { '@id': personId };
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Gabriele Radicello',
      alternateName: 'gabriradix',
      url: siteUrl,
      image: new URL('/assets/aboutphoto.JPEG', Astro.site).href,
      jobTitle: 'Multimedia artist',
      sameAs: [
        'https://instagram.com/gabriradix',
        'https://tiktok.com/@gabriradix',
        'https://x.com/gabriradix',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: 'Gabriele Radicello',
      alternateName: 'gabriradix',
      url: siteUrl,
      description: siteDescription,
      creator: personReference,
      inLanguage: ['en', 'it'],
    },
    {
      '@type': pagePath === '/about' ? 'ProfilePage' : pagePath === '/contacts' ? 'ContactPage' : 'WebPage',
      '@id': `${canonicalUrl.href}#webpage`,
      url: canonicalUrl.href,
      name: title,
      description: pageDescription,
      isPartOf: { '@id': websiteId },
      about: personReference,
      ...(pagePath === '/about' ? { mainEntity: personReference } : {}),
      ...(project ? {
        mainEntity: {
          '@type': 'CreativeWork',
          '@id': `${canonicalUrl.href}#work`,
          name: project.title,
          description: project.text,
          url: canonicalUrl.href,
          image: shareImageUrl.href,
          genre: project.category,
          // Participation also covers collaborative projects without claiming sole authorship.
          contributor: personReference,
        },
      } : {}),
    },
  ],
};

// Standardized branding logic
const finalLogoHover = brandColor || logoHoverColor;
const faviconColor = brandColor || "#ffffff";

// Dynamic SVG Favicon: a square with the site background and the custom √ symbol
const dynamicFavicon = `data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%23000000'/%3E%3Cg transform='translate(35, 19) scale(1.1)'%3E%3Cpath d='M12.13 39.45L22.56 10.84L27.17 10.84L13.94 46.39L10.50 46.39L4.52 31.05L0 31.05L0 27.29L7.69 27.29L12.13 39.45Z' fill='${encodeURIComponent(faviconColor)}'/%3E%3C/g%3E%3C/svg%3E`;

const { favicon = dynamicFavicon } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={pageDescription} />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gabriele Radicello" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:alt" content={project ? `${project.title} — Gabriele Radicello` : 'Gabriele Radicello (gabriradix)'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={shareImageUrl} />
    {!noindex && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..700;1,400..700&family=Roboto:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
    {finalLogoHover && (
      <style is:global set:html={`header a:hover, header a:hover span, header a:hover div, header a:hover svg { color: ${finalLogoHover} !important; }`}></style>
    )}
    <script is:inline>
      (function() {
        const setLang = () => {
          const savedLang = localStorage.getItem('lang') || 'en';
          document.documentElement.setAttribute('data-lang', savedLang);
          document.documentElement.lang = savedLang;
        };
        setLang();
        document.addEventListener('astro:after-swap', setLang);
      })();
    </script>
    <style is:global>
      @font-face {
        font-family: 'Apple Garamond Custom';
        src: url('/fonts/AppleGaramond.ttf') format('truetype');
        font-weight: bold;
        font-style: normal;
        font-display: swap;
      }
      h1, h2, h3, h4, h5, h6 {
        text-transform: uppercase;
        font-feature-settings: "ss05";
        font-family: 'Alte Haas Grotesk', Helvetica, Arial, sans-serif;
        font-size: calc(var(--font-size) * 3);
        font-variation-settings: "MONO" 0, "wght" 700;
        font-weight: 700;
        line-height: calc(var(--line) * 2.4);
        letter-spacing: -.03em;
      }

      h1 {
        --font-size: clamp(1rem, 3.5vw, 1.8rem);
        --line: clamp(0.9rem, 3vw, 1.6rem);
      }

      h2 {
        --font-size: clamp(0.8rem, 2vw, 1.1rem);
        --line: clamp(0.8rem, 2vw, 1.1rem);
      }

      h3 {
        --font-size: clamp(0.7rem, 1.5vw, 0.85rem);
        --line: clamp(0.7rem, 1.5vw, 0.85rem);
      }

      h4, h5, h6 {
        --font-size: clamp(0.6rem, 1vw, 0.7rem);
        --line: clamp(0.6rem, 1vw, 0.7rem);
      }

      /* Progressive Image Loader Styles */
      img {
        transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1), 
                    filter 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        will-change: opacity, filter;
      }
      img[data-src],
      img.img-loading {
        filter: blur(20px) !important;
        opacity: 0.6 !important;
        clip-path: inset(0) !important;
      }

      /* Lightbox Styles */
      #lightbox {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.9);
        backdrop-filter: blur(10px);
        cursor: zoom-out;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      }
      #lightbox.active {
        opacity: 1;
        pointer-events: auto;
      }
      #lightbox img {
        max-width: 90vw;
        max-height: 90vh;
        object-fit: contain;
        box-shadow: 0 0 50px rgba(0,0,0,0.5);
        transform: scale(0.9);
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      }
      #lightbox.active img {
        transform: scale(1);
      }
      #lightbox img.slide-out {
        transform: translateX(-50px) scale(0.9) !important;
        opacity: 0 !important;
      }
      #lightbox img.slide-out-reverse {
        transform: translateX(50px) scale(0.9) !important;
        opacity: 0 !important;
      }
      #lightbox img.slide-in {
        transform: translateX(50px) scale(0.9) !important;
        opacity: 0 !important;
        transition: none !important;
      }
      #lightbox img.slide-in-reverse {
        transform: translateX(-50px) scale(0.9) !important;
        opacity: 0 !important;
        transition: none !important;
      }
      .gallery-img {
        cursor: pointer;
        transition: opacity 0.3s ease,
                    filter 0.8s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .gallery-img:hover {
        opacity: 0.8;
      }

      /* Garamond Body Text Optimizations */
      p:not(.text-xs):not(.text-sm):not(.text-base) {
        font-size: 1.25rem; /* Scale up prose paragraphs to 20px */
        line-height: 1.8;
      }

      li:not(.text-xs):not(.text-sm) {
        font-size: 1.2rem;
        line-height: 1.7;
      }

      /* Subtitles / Hero Description Text */
      p.text-xl, .text-xl {
        font-size: 1.45rem; /* Scale up large subtitles/descriptions */
        line-height: 1.6;
      }

      /* Header Name & Nav Garamond Optimizations */
      #header-name {
        font-size: 1.05rem;
      }
      @media (min-width: 768px) {
        #header-name {
          font-size: 1.65rem;
        }
      }

      #header-nav a, #header-nav button {
        font-size: 0.85rem;
      }
      @media (min-width: 768px) {
        #header-nav a, #header-nav button {
          font-size: 1.1rem;
        }
      }

      /* Small Metadata (e.g. category, details) in Garamond */
      .project-card .text-xs:not(.font-mono) {
        font-size: 0.95rem;
      }

      /* Header readability overrides (dark drop-shadow mask for scroll contrast) */
      #logo-root, #header-name, #header-nav a {
        filter: drop-shadow(0 0 6px #000000) drop-shadow(0 0 12px #000000) drop-shadow(0 0 18px #000000);
      }



      /* Header dimming during ASCII mode: ONLY dim the nav menu */
      html.ascii-active header #header-nav {
        opacity: 0.12 !important;
        filter: blur(4px);
        pointer-events: none;
      }
      
      /* The black canvas already masks inactive media; avoid filtering moving carousel layers. */
      html.ascii-active .project-card:not(.hovered-card),
      html.ascii-active .contact-card:not(.hovered-card) {
        opacity: 0.12 !important;
        pointer-events: none;
      }

      /* Dim the page during logo hover without rasterizing a filtered full-page layer. */
      html.logo-active main {
        opacity: 0.12 !important;
        pointer-events: none;
      }
      html.logo-active header #header-nav {
        opacity: 0.12 !important;
        filter: blur(4px);
        pointer-events: none;
      }

      /* ASCII Page Loading transition */
      html.ascii-loading main {
        opacity: 0 !important;
        pointer-events: none;
      }
      html.ascii-loading header #header-nav {
        opacity: 0 !important;
        filter: blur(8px);
        pointer-events: none;
      }

      /* Ensure ASCII canvas overlay (z-index 99) covers page content, while hovered items (z-index 101) rise above it */
      header {
        z-index: 40 !important;
        transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), filter 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      }
      html.logo-active header,
      header:has(.hovered-logo) {
        z-index: 101 !important;
      }
      #header-nav {
        transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), filter 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        will-change: opacity, filter;
      }
      .project-card,
      .contact-card {
        transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      }
      main {
        position: relative;
        z-index: auto;
        transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .hovered-card,
      .hovered-logo {
        z-index: 101 !important;
        position: relative !important;
      }
      .hovered-target,
      .hovered-logo {
        filter: drop-shadow(0 0 8px #000000) drop-shadow(0 0 16px #000000) !important;
      }
      .project-card.hovered-card .carousel-container {
        /* Protect the whole active carousel, including when its title triggers ASCII. */
        position: relative;
        z-index: 1;
        filter: none !important;
        background: transparent;
        box-shadow: none;
      }
      .project-card.hovered-card .carousel-container :is(img, video) {
        /* Mask only actual media, never the carousel's padding or image gaps. */
        background-color: #000000;
      }
    </style>

  </head>
  <body 
    class="bg-black text-neutral-50 antialiased font-sans"
    style="font-family: 'Apple Garamond Custom', serif;"
  >
    <!-- Fullscreen Generative ASCII Canvas Overlay -->
    <canvas 
      id="global-ascii-canvas" 
      class="fixed inset-0 w-full h-full pointer-events-none transition-opacity duration-700 ease-in-out"
      style="z-index: 99; opacity: 1;"
    ></canvas>
    <script is:inline>
      (function() {
        var canvas = document.getElementById("global-ascii-canvas");
        if (!canvas) return;
        var ctx = canvas.getContext("2d");
        if (!ctx) return;

        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;

        window._asciiIntroActive = true;
        var asciiRamp = " .:-=+*#%@";
        var isRunning = true;
        var animId = null;
        window._stopAsciiIntro = function() {
          isRunning = false;
          if (animId) cancelAnimationFrame(animId);
          window._asciiIntroActive = false;
        };

        var mouseX = window.innerWidth / 2;
        var mouseY = window.innerHeight / 2;

        function loop() {
          if (!isRunning) return;

          var w = canvas.width;
          var h = canvas.height;
          var charWidth = 13;
          var charHeight = 18;
          var cols = Math.floor(w / charWidth);
          var rows = Math.floor(h / charHeight);

          ctx.fillStyle = "#000000";
          ctx.fillRect(0, 0, w, h);

          ctx.font = (charHeight - 2) + "px monospace";
          ctx.textBaseline = "top";

          var time = performance.now() * 0.001;
          var mouseCol = Math.floor(mouseX / charWidth);
          var mouseRow = Math.floor(mouseY / charHeight);

          for (var r = 0; r < rows; r++) {
            for (var c = 0; c < cols; c++) {
              var dx = c - mouseCol;
              var dy = r - mouseRow;
              var dist = Math.sqrt(dx*dx + dy*dy);

              var wave1 = Math.sin(c * 0.12 - time * 2.5) * Math.cos(r * 0.08 + time * 1.5);
              var wave2 = Math.sin(Math.sqrt(c*c + r*r) * 0.04 - time * 2);
              var ripple = Math.sin(dist * 0.3 - time * 6) * Math.exp(-dist * 0.07);

              var z = (wave1 + wave2) * 0.4 + ripple * 0.8;
              z += Math.sin(c * 2.3 + r * 3.7 + time * 10) * 0.08;

              var index = Math.floor((z + 1) * 0.5 * asciiRamp.length);
              if (index < 0) index = 0;
              if (index >= asciiRamp.length) index = asciiRamp.length - 1;

              var brightness = Math.floor(40 + (z + 1) * 0.5 * 80);
              ctx.fillStyle = "rgba(" + brightness + ", " + brightness + ", " + (brightness + 10) + ", 0.85)";
              ctx.fillText(asciiRamp[index], c * charWidth, r * charHeight);
            }
          }

          animId = requestAnimationFrame(loop);
        }

        // Render frame 0 synchronously RIGHT NOW
        loop();

        // After 400ms, fade out to transparency
        setTimeout(function() {
          if (!window._asciiIntroActive) return; // Abort fade out if hijacked by a hover!
          canvas.style.opacity = "0";
          setTimeout(function() {
            if (!window._asciiIntroActive) {
               // Hover owns the opacity now; an old intro timer must not revive the overlay.
               return; 
            }
            canvas.style.zIndex = "2";
            window._stopAsciiIntro();
          }, 400);
        }, 400);
      })();
    </script>

    {!hideHeader && <Header logoHref={logoHref} />}

    <main>
      <slot />
    </main>

    <!-- Lightbox Overlay -->
    <div id="lightbox" aria-hidden="true">
      <img id="lightbox-img" decoding="async" alt="Visualizzazione ingrandita dell'immagine" />
    </div>

    <script>
      import { getGestureAxis } from '../utils/gesture';
      import { loadOriginalImage, loadLazyEmbed, prepareImageRetry } from '../utils/lazy-media';
      let currentImageIndex = 0;
      let galleryImages: HTMLImageElement[] = [];

      const updateGalleryImages = () => {
        galleryImages = Array.from(document.querySelectorAll<HTMLImageElement>('.gallery-img'));
      };

      const showImage = (index: number, direction: 'next' | 'prev' | 'none' = 'none') => {
        const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
        if (galleryImages.length === 0 || !lightboxImg) return;
        
        const oldIndex = currentImageIndex;
        if (index < 0) index = galleryImages.length - 1;
        if (index >= galleryImages.length) index = 0;
        
        if (direction !== 'none' && index !== oldIndex) {
          const outClass = direction === 'next' ? 'slide-out' : 'slide-out-reverse';
          const inClass = direction === 'next' ? 'slide-in' : 'slide-in-reverse';
          
          lightboxImg.classList.add(outClass);
          
          setTimeout(() => {
            currentImageIndex = index;
            lightboxImg.src = galleryImages[currentImageIndex].dataset.fullSrc || galleryImages[currentImageIndex].dataset.src || galleryImages[currentImageIndex].src;
            lightboxImg.alt = galleryImages[currentImageIndex].alt || "Visualizzazione ingrandita dell'immagine";
            lightboxImg.classList.remove(outClass);
            lightboxImg.classList.add(inClass);
            
            // Force reflow
            lightboxImg.offsetHeight;
            
            lightboxImg.classList.remove(inClass);
          }, 200);
        } else {
          currentImageIndex = index;
          lightboxImg.src = galleryImages[currentImageIndex].dataset.fullSrc || galleryImages[currentImageIndex].dataset.src || galleryImages[currentImageIndex].src;
          lightboxImg.alt = galleryImages[currentImageIndex].alt || "Visualizzazione ingrandita dell'immagine";
        }
      };

      // Swipe support via global event delegation
      let touchStartX = 0;
      let touchStartY = 0;
      let touchEndX = 0;

      document.addEventListener('touchstart', (e) => {
        const lightbox = document.getElementById('lightbox');
        if (!lightbox || !lightbox.classList.contains('active')) return;
        touchStartX = e.changedTouches[0].screenX;
        touchStartY = e.changedTouches[0].screenY;
      }, { passive: true });

      document.addEventListener('touchend', (e) => {
        const lightbox = document.getElementById('lightbox');
        if (!lightbox || !lightbox.classList.contains('active')) return;

        touchEndX = e.changedTouches[0].screenX;
        const swipeThreshold = 50;
        if (getGestureAxis(touchEndX - touchStartX, e.changedTouches[0].screenY - touchStartY, swipeThreshold) !== 'horizontal') return;
        if (touchEndX < touchStartX - swipeThreshold) {
          showImage(currentImageIndex + 1, 'next');
        } else if (touchEndX > touchStartX + swipeThreshold) {
          showImage(currentImageIndex - 1, 'prev');
        }
      }, { passive: true });

      // Global click listener for gallery images (Opening & Closing)
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        
        // 1. OPEN Lightbox
        if (target instanceof HTMLImageElement && target.classList.contains('gallery-img')) {
          updateGalleryImages();
          currentImageIndex = galleryImages.indexOf(target);
          showImage(currentImageIndex);
          
          const lightbox = document.getElementById('lightbox');
          if (lightbox) {
            // Prevent page jitter by padding for scrollbar width
            const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
            document.body.style.paddingRight = `${scrollbarWidth}px`;
            document.body.style.overflow = 'hidden';
            lightbox.classList.add('active');
          }
          return;
        }

        // 2. CLOSE Lightbox (click overlay or close elements inside it)
        const lightbox = document.getElementById('lightbox');
        if (lightbox && lightbox.classList.contains('active')) {
          if (target.closest('#lightbox')) {
            lightbox.classList.remove('active');
            document.body.style.overflow = '';
            document.body.style.paddingRight = '';
          }
        }
      });

      // Keyboard navigation via global event delegation
      document.addEventListener('keydown', (e) => {
        const lightbox = document.getElementById('lightbox');
        if (!lightbox || !lightbox.classList.contains('active')) return;
        
        if (e.key === 'Escape') {
          lightbox.classList.remove('active');
          document.body.style.overflow = '';
          document.body.style.paddingRight = '';
        } else if (e.key === 'ArrowRight') {
          showImage(currentImageIndex + 1, 'next');
        } else if (e.key === 'ArrowLeft') {
          showImage(currentImageIndex - 1, 'prev');
        }
      });

      // Progressive images and deferred embeds
      let imageObserver: IntersectionObserver | null = null;
      let embedObserver: IntersectionObserver | null = null;
      function initProgressiveImages() {
        document.querySelectorAll<HTMLImageElement>('img[src]:not([data-src]):not(#lightbox-img)').forEach(prepareImageRetry);
        imageObserver?.disconnect();
        embedObserver?.disconnect();
        embedObserver = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            const iframe = entry.target as HTMLIFrameElement;
            loadLazyEmbed(iframe);
            embedObserver?.unobserve(iframe);
          });
        }, { rootMargin: '200px 0px' });
        document.querySelectorAll('iframe[data-lazy-embed]').forEach(iframe => embedObserver?.observe(iframe));
        imageObserver = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            imageObserver?.unobserve(entry.target);
            loadOriginalImage(entry.target as HTMLImageElement);
          });
        }, { rootMargin: '300px 0px' });
        document.querySelectorAll<HTMLImageElement>('img[data-src]').forEach(img => {
          if (img.loading !== 'lazy') loadOriginalImage(img);
          else imageObserver?.observe(img);
        });
      }

      initProgressiveImages();
      document.addEventListener('astro:page-load', initProgressiveImages);
      document.addEventListener('astro:before-swap', () => {
        imageObserver?.disconnect();
        embedObserver?.disconnect();
      });
    </script>

    <script>
      import { observeAutoplayVideos } from '../utils/lazy-media';
      let stopVideos: (() => void) | undefined;
      function initVideos() {
        stopVideos?.();
        stopVideos = observeAutoplayVideos();
      }
      initVideos();
      document.addEventListener('astro:page-load', initVideos);
      document.addEventListener('astro:before-swap', () => stopVideos?.());
    </script>

    <script>
      import { createAsciiRenderer, createAsciiPlayback } from '../utils/ascii-renderer';

      let canvas: HTMLCanvasElement | null = null;
      let renderer: ReturnType<typeof createAsciiRenderer> = null;
      let isAnimating = false;
      let mouseX = window.innerWidth / 2;
      let mouseY = window.innerHeight / 2;
      let fadeOutTimeoutId: ReturnType<typeof setTimeout> | null = null;
      let suppressedStartId: ReturnType<typeof setTimeout> | null = null;
      let suppressUntil = 0;
      const playback = createAsciiPlayback(time => renderer?.render(time, mouseX, mouseY));
      const hasHover = () => document.querySelector('.hovered-card, .hovered-logo') !== null;

      const clearTimers = () => {
        if (fadeOutTimeoutId !== null) clearTimeout(fadeOutTimeoutId);
        if (suppressedStartId !== null) clearTimeout(suppressedStartId);
        fadeOutTimeoutId = suppressedStartId = null;
      };

      const resizeCanvas = () => renderer?.resize(window.innerWidth, window.innerHeight);
      window.addEventListener('resize', resizeCanvas);
      window.addEventListener('mousemove', event => {
        mouseX = event.clientX;
        mouseY = event.clientY;
      }, { passive: true });
      const handleTouchCoord = (event: TouchEvent) => {
        if (!event.touches.length) return;
        mouseX = event.touches[0].clientX;
        mouseY = event.touches[0].clientY;
      };
      window.addEventListener('touchstart', handleTouchCoord, { passive: true });
      window.addEventListener('touchmove', handleTouchCoord, { passive: true });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) playback.stop();
        else if (isAnimating) playback.start();
      });

      const clearHover = () => {
        document.querySelectorAll('.hovered-target, .hovered-card, .hovered-logo').forEach(element => {
          element.classList.remove('hovered-target', 'hovered-card', 'hovered-logo');
        });
        document.documentElement.classList.remove('ascii-active', 'logo-active');
      };
      document.addEventListener('click', event => {
        if (!(event.target as HTMLElement)?.closest('a, button')) return;
        clearHover();
        stopAsciiLoop(true);
      });
      document.addEventListener('astro:before-swap', () => {
        (window as any)._stopAsciiIntro?.();
        clearTimers();
        playback.stop();
        isAnimating = false;
        canvas = null;
        renderer = null;
      });

      function handleBeforePreparation(event: any) {
        suppressUntil = 0;
        document.documentElement.classList.add('ascii-loading');
        if (canvas) canvas.style.transition = 'none';
        startAsciiLoop();
        // Commit the loading state, then restore the opacity transition without a forced layout.
        requestAnimationFrame(() => {
          if (canvas) canvas.style.transition = 'opacity 0.7s ease-in-out';
        });
        if (typeof event?.loader === 'function') {
          const originalLoader = event.loader;
          event.loader = () => Promise.all([
            originalLoader(), new Promise(resolve => setTimeout(resolve, 150)),
          ]).then(results => results[0]);
        }
      }

      function handlePageLoad() {
        suppressUntil = Date.now() + 1200;
        document.documentElement.classList.remove('ascii-loading');
        clearHover();
        (window as any)._stopAsciiIntro?.();
        initAsciiEngine();
        stopAsciiLoop(true);
      }

      function initAsciiEngine() {
        const nextCanvas = document.getElementById('global-ascii-canvas') as HTMLCanvasElement | null;
        if (!nextCanvas) return;
        if (nextCanvas !== canvas) {
          playback.stop();
          isAnimating = false;
          canvas = nextCanvas;
          renderer = createAsciiRenderer(canvas);
          resizeCanvas();
        }
        const logoLink = document.getElementById('logo-link');
        if (logoLink?.hasAttribute('data-ascii-logo') && !logoLink.hasAttribute('data-ascii-logo-initialized')) {
          logoLink.setAttribute('data-ascii-logo-initialized', 'true');
          const enter = () => {
            logoLink.classList.add('hovered-target', 'hovered-logo');
            document.documentElement.classList.add('logo-active');
            startAsciiLoop();
          };
          const leave = () => {
            logoLink.classList.remove('hovered-target', 'hovered-logo');
            document.documentElement.classList.remove('logo-active');
            stopAsciiLoop(true);
          };
          logoLink.addEventListener('mouseenter', enter);
          logoLink.addEventListener('mouseleave', leave);
          logoLink.addEventListener('touchstart', enter, { passive: true });
          logoLink.addEventListener('touchend', leave, { passive: true });
          logoLink.addEventListener('touchcancel', leave, { passive: true });
        }
      }

      function startAsciiLoop() {
        (window as any)._stopAsciiIntro?.();
        clearTimers();
        const delay = suppressUntil - Date.now();
        if (delay > 0) {
          suppressedStartId = setTimeout(() => {
            suppressedStartId = null;
            if (hasHover()) startAsciiLoop();
          }, delay);
          return;
        }
        if (!canvas || !renderer) initAsciiEngine();
        if (!canvas || !renderer) return;
        canvas.style.zIndex = '99';
        canvas.style.opacity = '0.8';
        isAnimating = true;
        if (!document.hidden) playback.start();
      }

      function stopAsciiLoop(force = false) {
        if (!force && hasHover()) return;
        clearTimers();
        isAnimating = false;
        // Fade the last frame in the compositor: no canvas redraws during the 700 ms exit.
        playback.stop();
        if (!canvas) return;
        canvas.style.opacity = '0';
        const fadingCanvas = canvas;
        fadeOutTimeoutId = setTimeout(() => {
          fadingCanvas.getContext('2d')?.clearRect(0, 0, fadingCanvas.width, fadingCanvas.height);
          fadingCanvas.style.zIndex = '2';
          fadeOutTimeoutId = null;
        }, 700);
      }

      document.addEventListener('ascii-start', startAsciiLoop);
      document.addEventListener('ascii-stop', () => stopAsciiLoop());
      document.addEventListener('astro:before-preparation', handleBeforePreparation);
      document.addEventListener('astro:after-swap', handlePageLoad);
      document.addEventListener('astro:page-load', handlePageLoad);
      initAsciiEngine();
    </script>
  </body>
</html>
