---
interface Props {
  logoHref?: string;
}
const { logoHref = "/" } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isHome = pathname === "/" || pathname === "/index.html";
---
<header
  id="main-header"
  class="fixed top-0 left-0 z-10 py-6 md:py-12 w-full transition-all duration-500 ease-in-out border-b border-transparent pointer-events-none"
>
  <div class="flex items-center justify-between px-6 md:px-12 pointer-events-auto">
    <a
      id="logo-link"
      class="flex items-center gap-2 md:gap-4 text-xl md:text-3xl font-normal tracking-tight text-neutral-300 transition-colors hover:text-white"
      href={isHome ? "#" : logoHref}
      data-scroll-top={isHome || undefined}
      data-ascii-logo={!isHome || undefined}
      aria-label={isHome ? "Back to top" : undefined}
      aria-current={isHome ? "page" : undefined}
      style="font-family: 'Apple Garamond Custom', serif;"
    >
      <svg 
        id="logo-root"
        class="w-8 h-10 md:w-12 md:h-16 transition-transform duration-500"
        viewBox="0 10.84 27.17 35.55" 
        fill="currentColor"
      >
        <path d="M12.13 39.45L22.56 10.84L27.17 10.84L13.94 46.39L10.50 46.39L4.52 31.05L0 31.05L0 27.29L7.69 27.29L12.13 39.45Z"/>
      </svg>
      <div
        class="flex flex-col leading-[1] transition-all duration-500 text-sm md:text-2xl"
        id="header-name"
      >
        <span>Gabriele</span>
        <span>Radicello</span>
      </div>
    </a>
    <nav
      class="flex gap-4 md:gap-8 text-[10px] md:text-s font-normal lowercase tracking-wide text-neutral-500 transition-all duration-500 items-center"
      aria-label="Main navigation"
      id="header-nav"
    >
      <a class="transition-colors hover:text-white" href={pathname === "/about" ? undefined : "/about"}
        aria-current={pathname === "/about" ? "page" : undefined}
        aria-disabled={pathname === "/about" ? "true" : undefined}
      >
        <span class="lang-en">about</span>
        <span class="lang-it">chi sono</span>
      </a>
      <a class="transition-colors hover:text-white" href={pathname === "/contacts" ? undefined : "/contacts"}
        aria-current={pathname === "/contacts" ? "page" : undefined}
        aria-disabled={pathname === "/contacts" ? "true" : undefined}
      >
        <span class="lang-en">contacts</span>
        <span class="lang-it">contatti</span>
      </a>
      <button 
        id="global-lang-toggle" 
        type="button" 
        class="transition-colors hover:text-white cursor-pointer font-normal lowercase tracking-wide text-neutral-500 uppercase select-none border-none p-0 inline-flex items-center"
        title="Cambia lingua / Switch language"
      >
        <span class="lang-it">IT</span>
        <span class="lang-en">EN</span>
      </button>
    </nav>
  </div>
</header>

<style>
  #main-header {
    transition: padding 0.4s ease,
      opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      filter 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #main-header::before {
    content: "";
    position: absolute;
    inset: 0 0 -1rem;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.95),
      rgb(0 0 0 / 0.85) 55%,
      transparent
    );
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  #main-header[data-contrast]::before {
    opacity: 1;
  }

  #main-header[data-compact] {
    padding-block: 1rem;
  }

  #main-header[data-compact] #logo-root {
    transform: scale(0.75);
  }

  #main-header[data-compact] #header-name {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-1rem);
  }

  #main-header[data-compact] #header-nav {
    opacity: 0;
    pointer-events: none;
  }

  #header-nav [aria-current="page"] {
    color: white;
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.35);
  }

  [aria-disabled="true"] {
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    #main-header,
    #main-header::before {
      transition: none;
    }
  }
</style>

<script>
  let header: HTMLElement | null = null;
  let nav: HTMLElement | null = null;
  let forceCompact = false;
  let previousScrollY = 0;
  let scrollingUp = true;

  function getScrollY() {
    // Clamp overscroll so bouncing at the page edges cannot change direction.
    const maxScrollY = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
    return Math.min(maxScrollY, Math.max(0, window.scrollY));
  }

  function initHeader() {
    header = document.getElementById("main-header");
    nav = document.getElementById("header-nav");
    forceCompact = window.location.pathname.replace(/\/$/, '') === '/surreal-splat-void' && window.innerWidth >= 768;
    previousScrollY = getScrollY();
    scrollingUp = true;
    const logoLink = document.getElementById("logo-link");
    if (logoLink?.hasAttribute("data-scroll-top")) {
      logoLink.addEventListener("click", scrollToTop);
    }
    updateHeaderState();
  }

  function scrollToTop(event: MouseEvent) {
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    window.scrollTo({
      top: 0,
      behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth",
    });
  }

  function updateHeaderState() {
    if (!header) return;

    const compact = forceCompact || (getScrollY() > 50 && !scrollingUp);
    header.toggleAttribute("data-compact", compact);
    header.toggleAttribute("data-contrast", getScrollY() > 50 && !compact);
    if (nav) nav.inert = compact;
  }

  function handleScroll() {
    const scrollY = getScrollY();
    const delta = scrollY - previousScrollY;

    if (scrollY <= 50) {
      scrollingUp = true;
    } else if (Math.abs(delta) < 8) {
      return;
    } else {
      scrollingUp = delta < 0;
    }

    previousScrollY = scrollY;
    updateHeaderState();
  }

  // Initialize
  initHeader();
  window.addEventListener("scroll", handleScroll, { passive: true });
  window.addEventListener("resize", updateHeaderState);
  document.addEventListener("astro:page-load", initHeader);

  window.addEventListener("message", (event) => {
    if (event.data === 'force-compact-header') {
      forceCompact = true;
      updateHeaderState();
    } else if (event.data === 'reset-compact-header') {
      forceCompact = false;
      updateHeaderState();
    }
  });

  // Global delegated listener for language toggle (registered once)
  if (!(window as any)._langToggleInitialized) {
    (window as any)._langToggleInitialized = true;

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement)?.closest('#global-lang-toggle, .lang-toggle-btn');
      if (btn) {
        e.preventDefault();
        e.stopPropagation();
        const current = document.documentElement.getAttribute('data-lang') || localStorage.getItem('lang') || 'en';
        const next = current === 'it' ? 'en' : 'it';
        localStorage.setItem('lang', next);
        document.documentElement.setAttribute('data-lang', next);
        document.documentElement.lang = next;
      }
    });
  }
</script>
