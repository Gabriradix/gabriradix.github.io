---
interface Props {
  logoHref?: string;
}
const { logoHref = "/" } = Astro.props;
---
<header
  id="main-header"
  class="fixed top-0 left-0 z-50 py-6 md:py-12 w-full transition-all duration-500 ease-in-out border-b border-transparent pointer-events-none"
>
  <div class="flex items-center justify-between px-6 md:px-12 pointer-events-auto">
    <a
      id="logo-link"
      class="flex items-center gap-2 md:gap-4 text-xl md:text-3xl font-normal tracking-tight text-neutral-300 transition-colors hover:text-white"
      href={logoHref}
      style="font-family: 'Apple Garamond Custom', serif;"
    >
      <svg 
        id="logo-root"
        class="w-8 h-10 md:w-12 md:h-16 transition-transform duration-500"
        viewBox="0 10.84 27.17 35.55" 
        fill="currentColor"
      >
        <path d="M12.13 39.45L22.56 10.84L27.17 10.84L13.94 46.39L10.50 46.39L4.52 31.05L0 31.05L0 27.29L7.69 27.29L12.13 39.45Z"/>
      </svg>
      <div
        class="flex flex-col leading-[1] transition-all duration-500 text-sm md:text-2xl"
        id="header-name"
      >
        <span>Gabriele</span>
        <span>Radicello</span>
      </div>
    </a>
    <nav
      class="flex gap-4 md:gap-8 text-[10px] md:text-s font-normal lowercase tracking-wide text-neutral-500 transition-all duration-500"
      aria-label="Main navigation"
      id="header-nav"
    >
      <a class="transition-colors hover:text-white" href="/about">about</a>
      <a class="transition-colors hover:text-white" href="/contacts">contacts</a>
    </nav>
  </div>
</header>

<script>
  let header = null;
  let logo = null;
  let name = null;
  let nav = null;
  let forceCompact = false;

  function initHeader() {
    header = document.getElementById("main-header");
    logo = document.getElementById("logo-root");
    name = document.getElementById("header-name");
    nav = document.getElementById("header-nav");
    updateHeaderState();
  }

  function updateHeaderState() {
    if (header && logo && name && nav) {
      let shouldBeCompact = forceCompact || window.scrollY > 50;

      if (shouldBeCompact) {
        header.classList.remove("py-12", "py-6");
        header.classList.add("py-4");
        logo.classList.add("scale-75");
        name.classList.add(
          "opacity-0",
          "pointer-events-none",
          "-translate-x-4",
        );
        nav.classList.add("opacity-0", "pointer-events-none");
      } else {
        header.classList.remove("py-4");
        header.classList.add("py-12");
        logo.classList.remove("scale-75");
        name.classList.remove(
          "opacity-0",
          "pointer-events-none",
          "-translate-x-4",
        );
        nav.classList.remove("opacity-0", "pointer-events-none");
      }
    }
  }

  // Initialize
  initHeader();
  window.addEventListener("scroll", updateHeaderState);
  window.addEventListener("resize", updateHeaderState);
  document.addEventListener("astro:page-load", initHeader);

  window.addEventListener("message", (event) => {
    if (event.data === 'force-compact-header') {
      forceCompact = true;
      updateHeaderState();
    } else if (event.data === 'reset-compact-header') {
      forceCompact = false;
      updateHeaderState();
    }
  });
</script>
