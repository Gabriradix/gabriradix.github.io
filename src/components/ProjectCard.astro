---
import { getProxyUrl } from "../utils/image";

interface Props {
  title: string;
  text: string;
  href: string;
  images: string[];
  year?: string;
  category?: string;
  brandColor?: string;
}

const { title, text, href, images, year, category, brandColor } = Astro.props;
const hasCarousel = images.length > 1;
const carouselImages = hasCarousel ? [...images, ...images] : images;
const animationDuration = images.length * 20;
const isBrainrot = title === "Brainrot Pavilion";
---

<article 
  class="flex flex-col md:flex-row items-start group project-card"
  style={brandColor ? `--hover-glow: 0 0 12px ${brandColor}; --brand-glow-color: ${brandColor};` : undefined}
>
  <!-- Text — same as original layout -->
  <div class="w-full md:w-1/3 shrink-0 pr-6 md:pr-12 flex flex-col md:items-end text-left md:text-right pt-[20px] mb-6 md:mb-0">
    <h3
      class="text-2xl font-normal tracking-tight text-neutral-200 mb-2 transition-colors group-hover:text-white"
      style="font-family: 'Helvetica Custom', Helvetica, Arial, sans-serif;"
    >
      <a
        href={href}
        class="transition-colors hover:text-white"
        target={href.startsWith('http') ? "_blank" : undefined}
        rel={href.startsWith('http') ? "noopener noreferrer" : undefined}
      >{title}</a>
    </h3>
    <div class="flex items-center gap-2 md:justify-end text-neutral-500 text-xs lowercase">
      <span>{category}</span>
      <span class="text-neutral-700 opacity-50">•</span>
      <span class="font-mono">{year}</span>
    </div>
  </div>

  <!-- Carousel — extends to right viewport edge -->
  <a
    href={href}
    target={href.startsWith('http') ? "_blank" : undefined}
    rel={href.startsWith('http') ? "noopener noreferrer" : undefined}
    class="carousel-container w-full md:flex-1 overflow-hidden aspect-[21/9] block"
    draggable="false"
  >
    {hasCarousel ? (
      <div
        class="carousel-strip flex h-full select-none"
        style={`--carousel-duration: ${animationDuration}s;`}
      >
        {carouselImages.map((img, i) => (
          img.endsWith('.mp4') ? (
            <video
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              class="h-full w-auto max-w-none object-cover shrink-0 mr-[5px]"
              draggable="false"
            >
              <source src={img} type="video/mp4" />
            </video>
          ) : (
            <img
              src={getProxyUrl(img)}
              data-src={img}
              alt={`${title} ${(i % images.length) + 1}`}
              class={isBrainrot ? 'brainrot-carousel-gif shrink-0' : 'h-full w-auto max-w-none object-cover shrink-0 mr-[5px]'}
              loading="lazy"
              draggable="false"
            />
          )
        ))}
      </div>
    ) : (
      <div class="block h-full w-full">
        {images[0]?.endsWith('.mp4') ? (
          <video
            src={images[0]}
            autoplay
            loop
            muted
            playsinline
            class="w-full h-full object-cover"
            draggable="false"
          ></video>
        ) : (
          <img
            src={getProxyUrl(images[0])}
            data-src={images[0]}
            alt={title}
            class="w-full h-full object-cover"
            draggable="false"
          />
        )}
      </div>
    )}
  </a>
</article>

<script>
  function initCarousels() {
    const containers = document.querySelectorAll('.carousel-container');
    
    containers.forEach(node => {
      const container = node as HTMLElement;
      if (container.getAttribute('data-carousel-initialized')) return;
      
      const strip = container.querySelector('.carousel-strip') as HTMLElement;
      if (!strip) return;

      container.setAttribute('data-carousel-initialized', 'true');

      const durationStr = strip.style.getPropertyValue('--carousel-duration');
      const duration = parseFloat(durationStr) || 90;
      const totalDuration = duration * 1000; // in ms

      // Use Web Animations API for buttery smooth performance
      const animation = strip.animate([
        { transform: 'translateX(0)' },
        { transform: 'translateX(-50%)' }
      ], {
        duration: totalDuration,
        iterations: Infinity,
        easing: 'linear'
      });

      let isDragging = false;
      let startX = 0;
      let lastX = 0;
      let lastTime = 0;
      let velocity = 0;
      let startProgress = 0;
      let wasDragged = false;
      let inertiaFrameId: number | null = null;

      const getProgress = () => {
        const currentTime = (animation.currentTime as number) || 0;
        return (currentTime % totalDuration) / totalDuration;
      };

      const handleStart = (x: number) => {
        isDragging = true;
        wasDragged = false;
        startX = x;
        lastX = x;
        lastTime = performance.now();
        velocity = 0;
        startProgress = getProgress();
        animation.pause();
        container.style.cursor = 'grabbing';

        if (inertiaFrameId) {
          cancelAnimationFrame(inertiaFrameId);
          inertiaFrameId = null;
        }
      };

      const handleMove = (x: number) => {
        if (!isDragging) return;
        const currentTime = performance.now();
        const deltaTime = currentTime - lastTime;
        const deltaX = x - startX;
        if (Math.abs(deltaX) > 5) wasDragged = true;
        
        const halfWidth = strip.offsetWidth / 2;
        if (halfWidth <= 0) return;

        // Calculate scrolling velocity in px/ms (moving left is positive progress)
        if (deltaTime > 0) {
          const instantVelocity = (x - lastX) / deltaTime;
          velocity = 0.7 * instantVelocity + 0.3 * velocity;
        }

        lastX = x;
        lastTime = currentTime;

        // Invert delta because dragging left increases progress (moves towards -50%)
        const deltaProgress = -deltaX / halfWidth;
        let newProgress = startProgress + deltaProgress;
        
        // Normalize progress to 0-1
        newProgress = ((newProgress % 1) + 1) % 1;
        
        animation.currentTime = newProgress * totalDuration;
      };

      const handleEnd = () => {
        if (!isDragging) return;
        isDragging = false;
        container.style.cursor = '';

        const currentTime = performance.now();
        // If the user stopped moving for more than 80ms before release, reset velocity to 0
        if (currentTime - lastTime > 80) {
          velocity = 0;
        }

        const minVelocity = 0.05; // threshold to trigger inertia
        if (Math.abs(velocity) > minVelocity) {
          let lastFrameTime = performance.now();
          const frictionRate = 0.004; // decay rate for friction

          const runInertia = (now: number) => {
            const dt = now - lastFrameTime;
            lastFrameTime = now;

            // Apply friction decay
            velocity *= Math.exp(-frictionRate * dt);

            if (Math.abs(velocity) < minVelocity) {
              animation.play();
              return;
            }

            const halfWidth = strip.offsetWidth / 2;
            if (halfWidth <= 0) {
              animation.play();
              return;
            }

            // Move the carousel based on velocity
            const deltaProgress = -(velocity * dt) / halfWidth;
            let newProgress = getProgress() + deltaProgress;
            newProgress = ((newProgress % 1) + 1) % 1;

            animation.currentTime = newProgress * totalDuration;

            inertiaFrameId = requestAnimationFrame(runInertia);
          };

          inertiaFrameId = requestAnimationFrame(runInertia);
        } else {
          animation.play();
        }
      };

      // Mouse events
      container.addEventListener('mousedown', (e) => {
        if ((e as MouseEvent).button !== 0) return;
        handleStart((e as MouseEvent).pageX);
      });

      window.addEventListener('mousemove', (e) => handleMove((e as MouseEvent).pageX));
      window.addEventListener('mouseup', handleEnd);

      // Touch events
      container.addEventListener('touchstart', (e) => {
        handleStart((e as TouchEvent).touches[0].pageX);
      }, { passive: true });

      window.addEventListener('touchmove', (e) => {
        if (isDragging) {
          handleMove((e as TouchEvent).touches[0].pageX);
          if (wasDragged && e.cancelable) e.preventDefault();
        }
      }, { passive: false });

      window.addEventListener('touchend', handleEnd);

      // Wheel/Trackpad support
      container.addEventListener('wheel', (e) => {
        const wheelEvent = e as WheelEvent;
        if (Math.abs(wheelEvent.deltaX) > Math.abs(wheelEvent.deltaY)) {
          if (inertiaFrameId) {
            cancelAnimationFrame(inertiaFrameId);
            inertiaFrameId = null;
          }
          const halfWidth = strip.offsetWidth / 2;
          if (halfWidth <= 0) return;

          e.preventDefault();
          const deltaProgress = wheelEvent.deltaX / halfWidth;
          let newProgress = getProgress() + deltaProgress;
          newProgress = ((newProgress % 1) + 1) % 1;
          
          animation.currentTime = newProgress * totalDuration;
        }
      }, { passive: false });

      // Prevent link navigation if the user dragged
      container.addEventListener('click', (e) => {
        if (wasDragged) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);
    });
  }

  function initAsciiHover() {
    const cards = document.querySelectorAll('.project-card');
    let lastTouchTime = 0;

    cards.forEach(node => {
      const card = node as HTMLElement;
      const carousel = card.querySelector('.carousel-container');
      const titleLink = card.querySelector('h3 a');
      
      const handleEnter = () => {
        if (Date.now() - lastTouchTime < 1000) return;
        card.classList.add('hovered-card');
        document.documentElement.classList.add('ascii-active');
        document.dispatchEvent(new CustomEvent('ascii-start'));
      };

      const handleLeave = () => {
        if (Date.now() - lastTouchTime < 1000) return;
        card.classList.remove('hovered-card');
        document.documentElement.classList.remove('ascii-active');
        document.dispatchEvent(new CustomEvent('ascii-stop'));
      };

      const handleEnterForce = () => {
        card.classList.add('hovered-card');
        document.documentElement.classList.add('ascii-active');
        document.dispatchEvent(new CustomEvent('ascii-start'));
      };

      const handleLeaveForce = () => {
        card.classList.remove('hovered-card');
        document.documentElement.classList.remove('ascii-active');
        document.dispatchEvent(new CustomEvent('ascii-stop'));
      };

      // Register triggers on both the carousel and the title link!
      let touchStartVal = 0;
      let touchTimeout: number | null = null;

      const handleTouchStart = () => {
        lastTouchTime = Date.now();
        touchStartVal = Date.now();
        if (touchTimeout) {
          clearTimeout(touchTimeout);
          touchTimeout = null;
        }
        handleEnterForce();
      };

      const handleTouchEnd = () => {
        lastTouchTime = Date.now();
        const elapsed = Date.now() - touchStartVal;
        const minDuration = 500; // Guarantee at least half a second of active ASCII waves
        
        if (elapsed < minDuration) {
          const remaining = minDuration - elapsed;
          if (touchTimeout) clearTimeout(touchTimeout);
          touchTimeout = setTimeout(() => {
            handleLeaveForce();
            touchTimeout = null;
          }, remaining) as unknown as number;
        } else {
          handleLeaveForce();
        }
      };

      if (carousel) {
        carousel.addEventListener('mouseenter', handleEnter);
        carousel.addEventListener('mouseleave', handleLeave);
        carousel.addEventListener('touchstart', handleTouchStart, { passive: true });
        carousel.addEventListener('touchend', handleTouchEnd, { passive: true });
        carousel.addEventListener('touchcancel', handleTouchEnd, { passive: true });
      }

      if (titleLink) {
        titleLink.addEventListener('mouseenter', handleEnter);
        titleLink.addEventListener('mouseleave', handleLeave);
        titleLink.addEventListener('touchstart', handleTouchStart, { passive: true });
        titleLink.addEventListener('touchend', handleTouchEnd, { passive: true });
        titleLink.addEventListener('touchcancel', handleTouchEnd, { passive: true });
      }
    });
  }

  // Initialize
  initCarousels();
  initAsciiHover();
  // Support View Transitions
  document.addEventListener('astro:page-load', () => {
    initCarousels();
    initAsciiHover();
  });
</script>

<style>
  /* Buttery smooth transition for the title link */
  .project-card h3 a {
    transition: color 0.4s cubic-bezier(0.4, 0, 0.2, 1), text-shadow 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: color, text-shadow;
  }

  /* When the card is hovered or has the active hovered-card class, light up the title link hover glow! */
  .project-card:hover h3 a,
  .project-card.hovered-card h3 a {
    color: #ffffff !important;
    text-shadow: var(--hover-glow, 0 0 12px rgba(255, 255, 255, 0.35)) !important;
  }

  /* Extend carousel to right viewport edge */
  .carousel-container {
    margin-right: calc(-50vw + 50%);
    cursor: grab;
    touch-action: pan-y; /* Allow vertical scroll on touch, handle horizontal in JS */
    padding: 20px 0 20px 20px; /* Standard balanced padding on mobile devices */
  }

  /* Transition for individual images and videos */
  .carousel-container img,
  .carousel-container video {
    transition: box-shadow 0.4s cubic-bezier(0.4, 0, 0.2, 1), transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: box-shadow, transform;
  }

  /* Medium viewports (tablets and desktops): Apply safe padding and hover glow effects */
  @media (min-width: 768px) {
    .carousel-container {
      padding: 20px 0 35px 20px; /* Extra bottom padding on desktop to completely prevent hover glow clipping */
    }

    /* Make ONLY the hovered image or video glow, matching the text glow exactly */
    .carousel-container img:hover,
    .carousel-container video:hover {
      box-shadow: var(--hover-glow, 0 0 12px rgba(255, 255, 255, 0.35)) !important;
      transform: scale(1.02); /* Subtle scale up for extra premium tactile feel! */
      z-index: 10;
      position: relative;
    }
  }

  .carousel-strip {
    width: max-content;
    will-change: transform;
  }

  .carousel-strip img,
  .carousel-strip video {
    user-select: none;
    -webkit-user-drag: none;
  }

  .brainrot-carousel-gif {
    height: 100% !important;
    aspect-ratio: 1 / 1 !important;
    object-fit: contain !important;
    background-color: #ffffff !important;
    padding: 12px !important;
    margin-right: 12px !important;
    border: 1px solid #e5e5e5 !important;
    box-sizing: border-box !important;
    flex-shrink: 0 !important;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
    will-change: box-shadow, transform;
  }

  .brainrot-carousel-gif:hover {
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.95), 0 0 40px rgba(255, 255, 255, 0.4) !important;
    border-color: #ffffff !important;
    transform: scale(1.05) !important;
    z-index: 10;
    position: relative;
  }
</style>
