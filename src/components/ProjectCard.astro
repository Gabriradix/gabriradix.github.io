---
interface Props {
  title: string;
  text: string;
  href: string;
  images: string[];
  year?: string;
  category?: string;
}

const { title, text, href, images, year, category } = Astro.props;
const hasCarousel = images.length > 1;
const carouselImages = hasCarousel ? [...images, ...images] : images;
const animationDuration = images.length * 45;
---

<article class="flex flex-col md:flex-row items-start group">
  <!-- Text — same as original layout -->
  <div class="w-full md:w-1/3 shrink-0 pr-6 md:pr-12 flex flex-col md:items-end text-left md:text-right pt-2 mb-6 md:mb-0">
    <h3
      class="text-2xl font-normal tracking-tight text-neutral-200 mb-2 transition-colors group-hover:text-white"
      style="font-family: 'Apple Garamond Custom', serif;"
    >
      <a
        href={href}
        class="hover:underline underline-offset-4"
        target={href.startsWith('http') ? "_blank" : undefined}
        rel={href.startsWith('http') ? "noopener noreferrer" : undefined}
      >{title}</a>
    </h3>
    <div class="flex items-center gap-2 md:justify-end text-neutral-500 text-xs lowercase">
      <span>{category}</span>
      <span class="text-neutral-700 opacity-50">•</span>
      <span class="font-mono">{year}</span>
    </div>
  </div>

  <!-- Carousel — extends to right viewport edge -->
  <a
    href={href}
    target={href.startsWith('http') ? "_blank" : undefined}
    rel={href.startsWith('http') ? "noopener noreferrer" : undefined}
    class="carousel-container w-full md:flex-1 overflow-hidden aspect-[21/9] block"
    draggable="false"
  >
    {hasCarousel ? (
      <div
        class="carousel-strip flex h-full select-none"
        style={`--carousel-duration: ${animationDuration}s;`}
      >
        {carouselImages.map((img, i) => (
          img.endsWith('.mp4') ? (
            <video
              src={img}
              autoplay
              loop
              muted
              playsinline
              class="h-full w-auto max-w-none object-cover shrink-0 mr-[5px]"
            ></video>
          ) : (
            <img
              src={img}
              alt={`${title} ${(i % images.length) + 1}`}
              class="h-full w-auto max-w-none object-cover shrink-0 mr-[5px]"
              loading="lazy"
            />
          )
        ))}
      </div>
    ) : (
      <div class="block h-full w-full">
        {images[0]?.endsWith('.mp4') ? (
          <video
            src={images[0]}
            autoplay
            loop
            muted
            playsinline
            class="w-full h-full object-cover"
          ></video>
        ) : (
          <img
            src={images[0]}
            alt={title}
            class="w-full h-full object-cover"
          />
        )}
      </div>
    )}
  </a>
</article>

<script>
  function initCarousels() {
    const containers = document.querySelectorAll('.carousel-container');
    
    containers.forEach(container => {
      if (container.getAttribute('data-carousel-initialized')) return;
      
      const strip = container.querySelector('.carousel-strip') as HTMLElement;
      if (!strip) return;

      container.setAttribute('data-carousel-initialized', 'true');
      console.log('Carousel initialized for:', container.getAttribute('href'));

      let isDragging = false;
      let startX = 0;
      let startPixels = 0;
      let currentPixels = 0;
      let wasDragged = false;
      
      const getTranslateX = () => {
        const style = window.getComputedStyle(strip);
        const transform = style.transform || (style as any).webkitTransform;
        if (!transform || transform === 'none') return 0;
        
        // Support for matrix() and matrix3d()
        const values = transform.split('(')[1].split(')')[0].split(', ');
        if (transform.includes('3d')) {
          return parseFloat(values[12]) || 0;
        } else {
          return parseFloat(values[4]) || 0;
        }
      };

      const handleStart = (x: number) => {
        isDragging = true;
        wasDragged = false;
        startX = x;
        startPixels = getTranslateX();
        strip.style.animationPlayState = 'paused';
        container.style.cursor = 'grabbing';
      };

      const handleMove = (x: number) => {
        if (!isDragging) return;
        const delta = x - startX;
        if (Math.abs(delta) > 5) wasDragged = true;
        
        currentPixels = startPixels + delta;
        
        const halfWidth = strip.offsetWidth / 2;
        if (halfWidth <= 0) return;

        // Wrap around for infinite effect
        while (currentPixels > 0) currentPixels -= halfWidth;
        while (currentPixels < -halfWidth) currentPixels += halfWidth;
        
        strip.style.transform = `translateX(${currentPixels}px)`;
      };

      const handleEnd = () => {
        if (!isDragging) return;
        isDragging = false;
        container.style.cursor = '';
        
        const halfWidth = strip.offsetWidth / 2;
        if (halfWidth <= 0) return;

        const durationStr = strip.style.getPropertyValue('--carousel-duration');
        const duration = parseFloat(durationStr) || 90;
        
        const progress = Math.abs(currentPixels) / halfWidth;
        const newDelay = -(progress * duration);
        
        strip.style.animationDelay = `${newDelay}s`;
        strip.style.transform = ''; 
        strip.style.animationPlayState = 'running';
      };

      // Mouse events
      container.addEventListener('mousedown', (e) => {
        if ((e as MouseEvent).button !== 0) return;
        handleStart((e as MouseEvent).pageX);
      });

      window.addEventListener('mousemove', (e) => handleMove((e as MouseEvent).pageX));
      window.addEventListener('mouseup', handleEnd);

      // Touch events
      container.addEventListener('touchstart', (e) => {
        handleStart((e as TouchEvent).touches[0].pageX);
      }, { passive: true });

      window.addEventListener('touchmove', (e) => {
        if (isDragging) {
          handleMove((e as TouchEvent).touches[0].pageX);
          if (wasDragged && e.cancelable) e.preventDefault();
        }
      }, { passive: false });

      window.addEventListener('touchend', handleEnd);

      // Wheel/Trackpad support
      container.addEventListener('wheel', (e) => {
        const wheelEvent = e as WheelEvent;
        if (Math.abs(wheelEvent.deltaX) > Math.abs(wheelEvent.deltaY)) {
          const halfWidth = strip.offsetWidth / 2;
          if (halfWidth <= 0) return;

          e.preventDefault();
          const current = getTranslateX();
          const next = current - wheelEvent.deltaX;
          
          let wrapped = next;
          while (wrapped > 0) wrapped -= halfWidth;
          while (wrapped < -halfWidth) wrapped += halfWidth;
          
          const duration = parseFloat(strip.style.getPropertyValue('--carousel-duration')) || 90;
          const progress = Math.abs(wrapped) / halfWidth;
          
          strip.style.animationDelay = `${-(progress * duration)}s`;
          strip.style.transform = '';
        }
      }, { passive: false });

      // Prevent link navigation if the user dragged
      container.addEventListener('click', (e) => {
        if (wasDragged) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);
    });
  }

  // Initialize
  initCarousels();
  // Support View Transitions
  document.addEventListener('astro:page-load', initCarousels);
</script>

<style>
  /* Extend carousel to right viewport edge */
  .carousel-container {
    margin-right: calc(-50vw + 50%);
    cursor: grab;
    touch-action: pan-y; /* Allow vertical scroll on touch, handle horizontal in JS */
  }

  .carousel-strip {
    width: max-content;
    will-change: transform;
  }

  .carousel-strip img,
  .carousel-strip video {
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }
</style>
